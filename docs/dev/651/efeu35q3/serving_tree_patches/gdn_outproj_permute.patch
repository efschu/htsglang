+def gguf_gdn_outproj_permute() -> bool:
+    """efeu-TP14 2026-10-01: keep a block-MISALIGNED GDN out_proj QUANTIZED.
+
+    llama.cpp stores the GDN value heads in "tiled" order; sglang wants them
+    grouped, and every other GDN tensor is un-tiled at load. For out_proj the
+    v heads are its INPUT columns, and a K-quant block (256) spans two
+    128-wide heads, so the columns cannot be permuted inside the packed bytes.
+    The old answer dequantized the whole matrix to dense bf16 at load: on
+    Qwen3.8-35B-A3B Q3_K_M that is 30 x 2048 x 4096 x 2 B = 503 MB read per
+    decoded token instead of 108 MB packed (~25 % of the decode bytes).
+
+    Default (True): leave the weight packed in TILED column order and permute
+    the ACTIVATION instead (Qwen3_5GatedDeltaNet gathers its 4096-wide input to
+    out_proj into tiled order, see finalize_gguf_out_proj_perm). Exact: a
+    column permutation of W equals the inverse permutation of x.
+    ``SGLANG_GGUF_GDN_OUTPROJ_PERMUTE=0`` restores the dense path. Single
+    attention-TP rank only (the gather crosses TP shards); the model refuses
+    otherwise.
+    """
+    return os.environ.get("SGLANG_GGUF_GDN_OUTPROJ_PERMUTE", "1") == "1"
+
