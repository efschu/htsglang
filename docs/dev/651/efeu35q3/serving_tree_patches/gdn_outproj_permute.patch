+
+    def finalize_gguf_out_proj_perm(self) -> None:
+        """Arm the activation permutation for a tiled, packed GGUF out_proj.
+
+        Invariant (gguf_qwen35.py): a GGUF out_proj whose quant block does not
+        divide head_v_dim can only be QUANTIZED here if the adapter left it in
+        TILED column order (otherwise it is dense or the adapter refused).
+        _undo_v_tiling maps grouped column j to tiled column idx[j]; therefore
+        W_grouped @ x == W_tiled @ x[..., inv] with inv = argsort(idx).
+        """
+        self._out_proj_in_perm = None
+        qt = getattr(self.out_proj, "qweight_type", None)
+        wt = getattr(qt, "weight_type", None) if qt is not None else None
+        if wt is None or self.num_k_heads == self.num_v_heads:
+            return
+        import gguf as _gguf
+
+        try:
+            block = _gguf.GGML_QUANT_SIZES[_gguf.GGMLQuantizationType(int(wt))][0]
+        except (KeyError, ValueError):
+            return
+        if self.head_v_dim % block == 0:
+            return
+        if self.attn_tp_size != 1:
+            raise ValueError(
+                "GGUF GDN out_proj left packed in tiled order needs attention TP 1; "
+                "set SGLANG_GGUF_GDN_OUTPROJ_PERMUTE=0 to dequantize it instead."
+            )
+        vpk = self.num_v_heads // self.num_k_heads
+        idx = (
+            torch.arange(self.value_dim)
+            .view(vpk, self.num_k_heads, self.head_v_dim)
+            .permute(1, 0, 2)
+            .reshape(-1)
+        )
+        dev = self.out_proj.qweight.device
+        self._out_proj_in_perm = torch.argsort(idx).to(dev)
 
