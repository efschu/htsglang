+def _aot_topk_available() -> bool:
+    """Is the AOT `moe.topk_softmax` kernel actually loadable here?
+
+    `fused_topk` binds it unconditionally through `KernelBackend.CUDA_AOT`,
+    which imports `sgl_kernel`. The ROCm extension is built from a source list
+    that does not include the MoE routing kernels, so on a HIP host the import
+    raises `ModuleNotFoundError: No module named 'sgl_kernel'` at the FIRST
+    forward -- long after weights are loaded and the KV pool is sized. Probing
+    once at import time turns that late crash into a routing decision.
+    """
+    try:
+        from sglang.kernels.selector import select_kernel
+        from sglang.kernels.spec import KernelBackend
+
+        select_kernel("moe.topk_softmax", backend=KernelBackend.CUDA_AOT).load()
+        return True
+    except Exception:
+        return False
+
+
+_AOT_TOPK_AVAILABLE = _aot_topk_available()
