+def _aot_moe_align_available() -> bool:
+    """Is the AOT `moe.moe_align_block_size` kernel loadable on this host?
+
+    It is bound through `KernelBackend.CUDA_AOT`, which imports `sgl_kernel`.
+    The ROCm extension is built from a source list that omits the MoE kernels,
+    so on a HIP host the import raises at the FIRST forward -- after the model
+    is loaded and the server has reported itself ready. Probing once here lets
+    the JIT kernel below, which does build for HIP, take over instead.
+    """
+    try:
+        from sglang.kernels.selector import select_kernel
+        from sglang.kernels.spec import KernelBackend
+
+        select_kernel(
+            "moe.moe_align_block_size", backend=KernelBackend.CUDA_AOT
+        ).load()
+        return True
+    except Exception:
+        return False
+
+
+_AOT_MOE_ALIGN_AVAILABLE = _aot_moe_align_available()
+
