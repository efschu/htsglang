+    def _cpu_dequantize_contained_type(self, layer: torch.nn.Module):
+        """One-time CPU dequantise for a type whose GPU dequant is contained.
+
+        ROCM_BROKEN_DEQUANT_TYPES is subtracted from DEQUANT_TYPES because the
+        gfx11 ``ggml_dequantize`` kernel is wrong for those types. That is
+        correct for the PER-FORWARD consumer (``fused_mul_mat_gguf``), which
+        then routes to MMQ instead. It is WRONG for THIS consumer, which runs
+        ONCE at load: the type check below would reject the layer outright, and
+        Qwen3.6-35B-A3B ships a Q6_K lm_head, so the whole model became
+        unloadable.
+
+        Dequantising here on the CPU with ``gguf.quants.dequantize`` -- the
+        numpy reference that DEFINES the on-disk format, and the oracle every
+        correctness claim about these kernels was measured against -- is exact.
+        It costs seconds once at load and nothing per forward, since the result
+        is dense from then on. The broken kernel is never re-admitted; it is
+        simply not the thing doing the work.
+        """
+        if not _is_hip:
+            return
+        qweight_type = layer.qweight_type.weight_type
+        if qweight_type not in ROCM_BROKEN_DEQUANT_TYPES:
+            return
+        qweight = layer.qweight
+        if getattr(layer, "_gguf_shard_views", None) or isinstance(
+            qweight, UninitializedParameter
+        ):
+            return
+
+        import numpy as np
+
+        params_dtype = getattr(self, "params_dtype", None) or torch.float16
+        block_size, type_size = gguf.GGML_QUANT_SIZES[qweight_type]
+        rows = qweight.shape[0]
+        cols = qweight.shape[1] // type_size * block_size
+        dense = gguf.quants.dequantize(
+            qweight.data.cpu().numpy(), WeightType(qweight_type)
+        )
+        tensor = (
+            torch.from_numpy(np.ascontiguousarray(dense, dtype=np.float32))
+            .reshape(rows, cols)
+            .to(params_dtype)
+            .to(qweight.device)
+        )
+        new_param = Parameter(tensor, requires_grad=False)
+        set_weight_attrs(new_param, vars(qweight))
