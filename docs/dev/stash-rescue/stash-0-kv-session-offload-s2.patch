 def make_sentinels(
-    host_base: int, split_factor: int, residues: torch.Tensor
+    host_base: int, split_factor: int, residues: torch.Tensor, start: int = 0
 ) -> torch.Tensor:
-    """Sentinel slot ids for positions ``0..len(residues)-1`` with the given
