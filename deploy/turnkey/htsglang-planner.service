# PATHS HERE ARE RENDERED, NOT LITERAL. @@REPO@@, @@VENV@@,
# @@LOG_DIR@@ and @@CONFIG@@ are substituted from [stack] by
# scripts/turnkey_539_render_units.py when the installer writes this
# unit. They were literal /spinning/htsglang-gpu paths until
# 2026-08-12, when every unit died with 'No module named
# sglang.srt.turnkey' because that checkout was not the one
# [stack].repo named. Change stack.toml, or this template -- never
# the rendered copy under /etc, which the next install overwrites.

# The planner API (#584 names it the authority for VRAM/compute decisions).
#
# This unit exists because of a defect observed on this rig 2026-08-12: the
# planner was serving :8780 as a bare manual process (pid 2291562, ppid 1,
# up 3.5 days) whose working directory was /spinning/wt-631-routea -- a GIT
# WORKTREE, i.e. a directory an unrelated agent can delete. It would not have
# survived a host reboot, and nothing would have reported its absence. That
# is precisely the "manual reconstruction" #539 classifies as a defect.
#
# WorkingDirectory is the canonical checkout, never a worktree.

[Unit]
Description=htsglang planner API (#584 resource authority)
After=network-online.target
Wants=network-online.target
PartOf=htsglang.target

[Service]
Type=simple
WorkingDirectory=@@REPO@@
Environment=PYTHONPATH=@@REPO@@/python
ExecStart=@@VENV@@/bin/python -m sglang.planner --serve --port 8780

# DELIBERATELY NOT CUDA_VISIBLE_DEVICES=-1, unlike the router's no-cuda
# drop-in. That was the first draft here and it is wrong: the planner loads
# no weights, but it DOES initialise CUDA to resolve card identity (cuda
# ordinals are what --rank-gpu-id speaks, AUDIT_331). Measured on the live
# planner, pid 2291562, 2026-08-12: 27 open /dev/nvidia* fds and 144 CUDA
# mappings. Blinding it would break the resource authority it exists to be.
#
# The consequence is real and belongs here rather than in a surprise: those
# fds PIN THE DRIVER, so a driver reload (smallbar, #601) must stop this unit
# first. That is now a one-liner -- `systemctl stop htsglang-planner` --
# where previously it meant identifying an anonymous manual pid by hand.

Restart=always
RestartSec=5
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=htsglang.target
