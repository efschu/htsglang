# PATHS HERE ARE RENDERED, NOT LITERAL. @@REPO@@, @@VENV@@,
# @@LOG_DIR@@ and @@CONFIG@@ are substituted from [stack] by
# scripts/turnkey_539_render_units.py when the installer writes this
# unit. They were literal /spinning/htsglang-gpu paths until
# 2026-08-12, when every unit died with 'No module named
# sglang.srt.turnkey' because that checkout was not the one
# [stack].repo named. Change stack.toml, or this template -- never
# the rendered copy under /etc, which the next install overwrites.

# Every named check, once, before anything touches a card.
#
# RemainAfterExit=yes makes the successful run a LATCH: the serving units
# Require= this, so a machine that failed preflight cannot have serving
# started on it by a later `systemctl start`, and the failure stays visible
# in `systemctl status` instead of scrolling past in a log.

[Unit]
Description=htsglang turnkey preflight (named refusals, #539)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PYTHONPATH=@@REPO@@/python
ExecStartPre=/usr/bin/mkdir -p @@LOG_DIR@@
ExecStart=@@VENV@@/bin/python -m sglang.srt.turnkey --config @@CONFIG@@ preflight
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=htsglang.target
