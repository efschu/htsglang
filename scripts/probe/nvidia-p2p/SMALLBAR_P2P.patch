diff --git a/src/nvidia/src/kernel/gpu/bus/arch/turing/kern_bus_tu102.c b/src/nvidia/src/kernel/gpu/bus/arch/turing/kern_bus_tu102.c
index f06fb09..d5e9515 100644
--- a/src/nvidia/src/kernel/gpu/bus/arch/turing/kern_bus_tu102.c
+++ b/src/nvidia/src/kernel/gpu/bus/arch/turing/kern_bus_tu102.c
@@ -350,6 +350,118 @@ kbusGetBar1ResvdVA_TU102
 }
 
 
+/*!
+ * @brief SMALLBAR_P2P: determine the size of the static BAR1 window
+ *
+ * If BAR1 is large enough for the entire client-visible FB, the whole FB
+ * is mapped as before. If it is not, a window is mapped:
+ *
+ *   window = BAR1 VA (2M aligned down) - bar1Offset - safety margin
+ *
+ * safety margin = UserD mappings for all channels + MMIO priv + doorbell
+ *                 + KBUS_STATIC_BAR1_DYNAMIC_RESERVE
+ * These are the same items the AUTO branch of
+ * kbusIsStaticBar1Supported_TU102 adds up, plus the fixed reserve for the
+ * dynamic BAR1 region.
+ *
+ * The result is aligned down to RM_PAGE_SIZE_2M (static BAR1 is mapped
+ * with 2 MiB pages). If it falls below KBUS_STATIC_BAR1_MIN_WINDOW_SIZE,
+ * 0 is returned and the caller rejects static BAR1.
+ *
+ * The window necessarily starts at FB offset 0, see
+ * kbusEnableStaticBar1Mapping_TU102 for the reasoning.
+ *
+ * @param[in] pGpu
+ * @param[in] pKernelBus
+ * @param[in] gfid
+ * @param[in] bar1Offset  start offset of the static region within BAR1
+ *
+ * @return size to map in bytes, or 0 if too little space remains
+ */
+static NvU64
+_kbusGetStaticBar1MapSize_TU102
+(
+    OBJGPU     *pGpu,
+    KernelBus  *pKernelBus,
+    NvU32       gfid,
+    NvU64       bar1Offset
+)
+{
+    MemoryManager *pMemoryManager = GPU_GET_MEMORY_MANAGER(pGpu);
+    KernelFifo    *pKernelFifo    = GPU_GET_KERNEL_FIFO(pGpu);
+    NvU64 fullMapSize = RM_ALIGN_DOWN(memmgrGetClientFbAddrSpaceSize(pGpu, pMemoryManager),
+                                      RM_PAGE_SIZE_2M);
