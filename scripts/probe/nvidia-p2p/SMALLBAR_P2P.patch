+++ b/src/nvidia/inc/kernel/gpu/bus/kern_bus.h
@@ -1,3 +1,24 @@
 
 #include "g_kern_bus_nvoc.h"
 
+//
+// Static BAR1 window for GPUs with a small BAR1 (SMALLBAR_P2P)
+//
+// The official static BAR1 path (Turing+) maps the entire client-visible
+// FB into BAR1. On GPUs whose BAR1 is smaller than the FB (e.g. 256 MiB
+// BAR1 with 10/20 GiB of VRAM, resizable BAR disabled) that is impossible.
+// Instead of rejecting static BAR1 altogether, only a window starting at
+// FB offset 0 is mapped in that case.
+//
+// KBUS_STATIC_BAR1_MIN_WINDOW_SIZE
+//   Smallest window still considered useful. If less than this remains,
+//   static BAR1 is rejected as before.
+//
+// KBUS_STATIC_BAR1_DYNAMIC_RESERVE
+//   BAR1 VA kept for the dynamic region (CPU mappings outside the window,
+//   on-demand BAR1 P2P mappings via dmaAllocBar1P2PMapping, doorbell and
+//   MMIO priv). This reserve is a chosen value, not a measured one.
+//
+#define KBUS_STATIC_BAR1_MIN_WINDOW_SIZE    (64ULL << 20)
+#define KBUS_STATIC_BAR1_DYNAMIC_RESERVE    (64ULL << 20)
+
