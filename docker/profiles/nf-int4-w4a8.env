#     EXTRA_PROBE_TIMEOUT_S, BURST_PROBE/BURST_N/BURST_MIN/BURST_MAX, CONTROL_SHORT/CONTROL_MID_REPEAT, DECODE_PROBE(_KINDS),
#     NEEDLE_N_*/NEEDLE_POS_* (Proben macht nf_short_probes_rc10u.py), CUDA_ENABLE_USER_TRIGGERED_COREDUMP (NF_PROFILE OP-13).
#   SGLANG_WEG2_BAR1_CONNECT_S=480: setzt das Abnahmeskript per CONTAINER_ENV (CONNECT_S=auto bei warmem JIT-Volume),
#     sonst der Entrypoint 900 beim Kaltstart.
#   Starter-Rueckfaelle FR_P=0.26,.. / FR_D=0.06,0.44,0.365 / ENV_D_EXTRA-Default (SPEC_EAGER_VERIFY): greifen im bb3-Lauf
#     nicht (der Arm setzt FR_P/FR_D/ENV_D_EXTRA vorher), gehoeren nicht zur Form.
#   SGLANG_FLA_L2NORM_RUNTIME_T=1: setzt der Launcher selbst fuer beide Gruppen (launcher.py build_env, H103).
#
# RIG-GEBUNDEN wie nf.env: 1x RTX 5090 + 2x RTX 3080, smallbar-Treiber 595.58.03 (NF_PROFILE.md §5.2).

PROFILE_NAME=nf-int4-w4a8                                     # REL: R6 (Vorlage: nf-h91)
PROFILE_LINE=nf
PROFILE_FORM=h91bb4+adopt+st+odx+2b+swr+e2cut+z30y+park+frp+x1w+pcw+xcl+dres+y6o+rel    # REL: R6 (+y6o+rel). H91: Form des Arms boot_nf_h91bb4.sh (= bb3-Form; die zwei bb4-Schalter per NF_ENV_BB4_FORM, Default aus)
PROFILE_STATUS=experimentell   # H88-E: kein Metallbeweis (abl hat abgenommen; dieses Profil nur mit dem Schalter, W4A8-Schema H88-B)
PROFILE_PLACEHOLDER=0
PROFILE_OWNER="NF-Sitz (Release nf-int4 = Form -dres-y6o; Zielbaum desk/nf-y6n-capfloor-1001 c27d3dd0da, Image rc12z30y6p)"   # REL: R6
PROFILE_FORMAT=int4-mixed     # Formerkennung des Entrypoints fuer Minachist (compressed-tensors, int4 + weitere Gruppen)
PROFILE_NCCL_STATUS=unproven   # NF nie mit --transport nccl gebootet; H91-Form nie unter nccl
PROFILE_MODEL=/spinning/llm_stuff/club-3090/models-cache/Qwen3.8-Flash-Next-INT4-Mixed-AutoRound-Minachist-abl-wxp   # abl
PROFILE_DRAFT=/spinning/llm_stuff/club-3090/models-cache/Qwen3.8-Flash-Next-MTP-INT4-g32-albucino-abl-wxp           # abl
PROFILE_CENSUS=/opt/htsglang/profiles/nf/xchg_census_fnFL2_graph.json                 # bb3 liest dieselbe (Arm LAUNCHER_EXTRA)
PROFILE_CORRIDOR=/opt/htsglang/profiles/nf/corridor_budget_sample_nextflash_0921.json  # bb3: Arm-Default derselben Datei
PROFILE_WAKE_REF_DIR=/opt/htsglang/profiles/nf
PROFILE_WAKE_REF="$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.P.log,$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.D.log,$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.front.log"
PROFILE_REQUIRED_PATHS=(
  "$PROFILE_DRAFT/mtp-dense.safetensors"
  "$PROFILE_DRAFT/mtp-routed-experts-int4.safetensors"
  "$PROFILE_CENSUS"
  "$PROFILE_CORRIDOR"
  "$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.P.log"
  "$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.D.log"
  "$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.front.log"
)
PROFILE_GPUS="NVIDIA GeForce RTX 5090=1;NVIDIA GeForce RTX 3080=2"
# HW-GENERIC 1002: Preflight-Gate aus NVML-Eigenschaften (weg2/card_identity.py: Arch sm_86/sm_120, Kartenzahl,
# Kartenreihenfolge). PROFILE_GPUS oben bleibt fuer Baeume ohne card_identity.py (Namens-Gate wie bisher).
PROFILE_CARD_COUNT=3
# The inventory the profile's positional vectors were measured on (card_identity.CALIBRATED_CLASSES labels,
# in card order: biggest NVML total first). Another inventory -> REFUSED UNCALIBRATED (HW-UNCALIBRATED).
PROFILE_INVENTORY="RTX5090,RTX3080,RTX3080"
PROFILE_SHM_MIN_GIB=16          # x177 8597 MiB; bb3 tmpfs_shm max 8466 MiB (ramcensus_fnFL2h91bb3.csv 15:49:21Z) -- unveraendert
PROFILE_MEMAVAIL_MIN_GIB=88     # H91-Form nativ ungemessen, bb3 nonreclaim-Spitze 88,1 GiB; T nach dem ersten Docker-Boot neu herleiten
PROFILE_TMPFS_STORE=/mnt/nf-experts   # MUSS tmpfs sein (cudaHostRegister auf ZFS-mmap -> cudaError 1)
PROFILE_TMPFS_GIB=72                  # Store fnFL2: bb3 tmpfs_experts max 40144 MiB, Geometrie 183,137,168|0.06,0.51,0.48 wie x177

# FORM-ZAHLEN, die an MEHREREN Stellen stehen muessen (FR_P steht an DREI Stellen: Env, --pp-cut-expert-device-fraction,
# --extra-p --rank-moe-resident-fraction). FEST, nicht per ${..:-} ueberschreibbar: die Store-Geometrie haengt daran.
NF_FR_P=0.330,0.701,0.652     # H91: war 0.332,0.64,0.39 (x177). bb3 Arm Z.77; Launcher-H25-Post -> 0.324,0.637,0.733887 (bb3 P argv Z.178)
NF_FR_D=0.06,0.51,0.48       # Kante K (H30), = bb3 (Arm Z.53 EXTRA_D_SET + Z.64), unveraendert
NF_SCRATCH_D=104,48,48       # -dres: TP0 +4 LRU-Zeilen (nur mit B = Record 2672 ohne Residenten-Verlust, s. Kopf). H91: war 100 (davor 118,48,48). bb3 Arm Z.65 (H95-Tabelle: 118 auf TP0 verweigert W130 ab n=4)
NF_STORE_DIR=/mnt/nf-experts/fnFL2   # eigenes Verzeichnis je Format, nie zwei Stores zugleich

# RC2-ZUSATZ: KV-Arena-Referenzen ueber die Release-Queue (P und D). bb3 Arm Z.118 setzt es ebenso (Soll: 0 'HICACHE-INDEX
# REFUSED', Zeile 'ARENA-QUEUE-REFS'). Code-Default AUS im Zielbaum -> muss hier stehen.
NF_ENV_RC2_FORM="SGLANG_HICACHE_ARENA_QUEUE_REFS=1"
# H91 (bb4-Option, Default LEER = bb3-Env): boot_nf_h91bb4.sh setzt auf P UND D zusaetzlich
#   SGLANG_ANTHROPIC_INLINE_SYSTEM_IN_PLACE=1;SGLANG_WEG2_TOLD_PROBE_TREE_KEY=1   (Befund M / #1416d; beide im Zielbaum, Default aus;
#   INLINE_SYSTEM muss auf P und D GLEICH sein). bb4 lief nie am Metall (nur Dry bb4d3) -> fuer die Abnahme nicht gesetzt;
#   h91bb4_eval.py meldet ihre Bloecke I1/T1-T4 darum FEHLT/nicht gesetzt. Einschalten = diese Zeile fuellen.
NF_ENV_BB4_FORM=""

# Gruppen-Env (P und D verschieden -> nur ueber --env-p/--env-d, nicht global exportierbar). = nf.env ausser SCRATCH_D/FR_P.
NF_ENV_P_FORM="SGLANG_MOE_SCRATCH_SLOTS=32;SGLANG_MOE_RESIDENT_EXPERT_FRACTION=$NF_FR_P;SGLANG_UNEVEN_MOE_EXPERT_SHARD=1;SGLANG_WEIGHT_LOADER_PREAD=1;SGLANG_LOAD_KEY_WORKERS=4;SGLANG_MOE_OFFLOAD_WAVE_ORDER=expert;SGLANG_QWEN4_PLE_CKPT_GATHER=pread;SGLANG_MOE_EXPERT_STORE_DIR=$NF_STORE_DIR;SGLANG_WEG2_ENABLE_P_TAIL_FOLD=1;SGLANG_WEG2_TAIL_KEEP_MIB=512;SGLANG_WEG2_PLE_STATE_HANDOFF=1;SGLANG_FORCE_QSA_ROWS_CONFIG=inf=64/8/2;SGLANG_WEG2_QSA_FP8_DECODE=ptx;SGLANG_WEG2_QSA_ROWS_FUSED_EAGER=1;SGLANG_WEG2_ENABLE_P_UNDIVIDED_MICRO_BATCH=1;SGLANG_WEG2_ENABLE_P_MULTI_ANCHOR_TAILS=1;SGLANG_WEG2_P_BURST_ASSEMBLY_MS=300;SGLANG_WEG2_REARM_PREFETCH=0;SGLANG_MOE_OFFLOAD_PLAN_VECTOR=1;SGLANG_NAN_GUARD_WAVE=0;SGLANG_NAN_GUARD_FETCH=0;SGLANG_OPT_HICACHE_DEVICE_INDEX_WRITE=0;SGLANG_WEG2_SEQ_BUFFER_DEPTH=2;SGLANG_HICACHE_ARENA_GIB=4.75;SGLANG_HICACHE_ARENA_KV_PAGE_BYTES=786432;SGLANG_HICACHE_ARENA_MAMBA_SLOTS=32;SGLANG_WEIGHT_LOADER_SHARED_CACHE=keep"
NF_ENV_P_INSTR="SGLANG_WEG2_SLEEP_HEAP_CENSUS=0;SGLANG_MOE_OFFLOAD_TIMING=1;SGLANG_QSA_SIDECAR_TRACE=4;SGLANG_WEG2_PREFILL_TIMING=1;SGLANG_WEG2_ENABLE_TIMING_EVENT_FLUSH=1"
NF_ENV_D_FORM="SGLANG_QWEN4_PLE_CKPT_GATHER=pread;SGLANG_MOE_SCRATCH_SLOTS=$NF_SCRATCH_D;SGLANG_MOE_RESIDENT_EXPERT_FRACTION=$NF_FR_D;SGLANG_UNEVEN_MOE_EXPERT_SHARD=1;SGLANG_WEIGHT_LOADER_PREAD=1;SGLANG_LOAD_KEY_WORKERS=4;SGLANG_MOE_OFFLOAD_GRAPH_MODE=pool;SGLANG_MOE_EXPERT_STORE_DIR=$NF_STORE_DIR;SGLANG_WEG2_TAIL_KEEP_MIB=512;SGLANG_WEG2_PLE_STATE_HANDOFF=1;SGLANG_HICACHE_LOAD_ASYNC_INDEX=1;SGLANG_WEG2_REARM_DEFER=1;SGLANG_WEG2_FORM_A_PLE_FULL_VOCAB=1;SGLANG_WEG2_PLE_STAGE_BEHIND_REPLAY=1;SGLANG_QWEN4_PLE_DECODE_PREAD_PROCS=8;SGLANG_QWEN4_PLE_DECODE_PREAD_THREADS=8;SGLANG_WEG2_PLE_STAGE_AUTONOMOUS=1;SGLANG_WEG2_PLE_STAGE_BONUS_EARLY=1;SGLANG_WEG2_TAIL_SKIP_EXTEND=1;SGLANG_WEG2_REARM_PREFETCH=0;SGLANG_QSA_MTP_INDEX_SHARE=0;SGLANG_WEG2_SEQ_BUFFER_DEPTH=2;SGLANG_HICACHE_ARENA_GIB=4.75;SGLANG_HICACHE_ARENA_KV_PAGE_BYTES=786432;SGLANG_HICACHE_ARENA_MAMBA_SLOTS=32;SGLANG_FORCE_QSA_ROWS_CONFIG=sm120:32=32/8/2,64=64/8/2,128=64/4/2,512=32/4/2,inf=64/8/2;SGLANG_WEG2_ENABLE_D_STORE_ADOPT=1;SGLANG_WEG2_STORE_SHORT_TAIL=1;SGLANG_WEIGHT_LOADER_SHARED_CACHE=drop;SGLANG_WEG2_ENABLE_CUT_WORKER_END=1"
# H91: +SGLANG_DEBUG_MOE_POOL_DEMAND=64 (bb3 Arm Z.115, WEG2-GROUP-ENV D Z.235) -- Instrument, nur mit HTSGLANG_INSTRUMENTS=1
NF_ENV_D_INSTR="SGLANG_WEG2_SLEEP_HEAP_CENSUS=0;SGLANG_DEBUG_DECODE_PLE_WAIT=1;SGLANG_DEBUG_HOST_ANON_PROBE=1;SGLANG_SPEC_STAGE_SYNC=8;SGLANG_GRAPH_REPLAY_CENSUS=8;SGLANG_BARLINK_EAGER_TRACE=6000;SGLANG_QSA_SIDECAR_TRACE=4;SGLANG_HICACHE_ROUND_TIMING=512;SGLANG_DEBUG_MOE_POOL_DEMAND=64"
_nf_rc2=${NF_ENV_RC2_FORM:+;$NF_ENV_RC2_FORM}${NF_ENV_BB4_FORM:+;$NF_ENV_BB4_FORM}
if [ "${HTSGLANG_INSTRUMENTS:-0}" = "1" ]; then   # REL: R1 Default 0 (Vorlage 1)
  NF_ENV_P="$NF_ENV_P_FORM$_nf_rc2;$NF_ENV_P_INSTR"; NF_ENV_D="$NF_ENV_D_FORM$_nf_rc2;$NF_ENV_D_INSTR"
else
  NF_ENV_P="$NF_ENV_P_FORM$_nf_rc2"; NF_ENV_D="$NF_ENV_D_FORM$_nf_rc2"
fi
unset _nf_rc2

# NCCL-BLOCK wie nf.env (gilt NUR bei HTSGLANG_TRANSPORT=nccl; H91-Form unter nccl unbelegt).
if [ "${HTSGLANG_TRANSPORT:-bar1}" = nccl ]; then
  NF_ENV_P="$NF_ENV_P;SGLANG_WEG2_SEQ_BUFFER_DEPTH=1"
  NF_ENV_D="$NF_ENV_D;SGLANG_WEG2_SEQ_BUFFER_DEPTH=1"
fi

# NF_ENV_D="$NF_ENV_D;SGLANG_WEG2_D_KV_STAGE_TOKENS=262144"   # -st-cut: eine KV-Stufe (S3h-Bedingung bis S3g)
# z30y Pin raus (Planer-Sitz 29.09., Nutzer "bs2 x 128k <= 267k", Grundgesetz KV+Experten ein Topf): der Launcher
#   schreibt die Stufenform 262144/393216/524288 je KV-Rang (S3g), #251d waehlt am Wake nach Bedarf, D-MEM-SCHED
#   (f499865784 + 42d95a4772) zwischen den Runden. --max-total-tokens 262144 auf D BLEIBT: es ist die KV-Pflicht S0
#   (launcher group_kv_tokens = max(context, max_total)); unter der Stufenform setzt kv_stage_pool_tokens den Pool
#   nach der Nutzer-Kappe auf die oberste Stufe. Backup: .vor_pin_raus
NF_ENV_D="$NF_ENV_D;SGLANG_WEG2_D_KV_STAGE_BY_DEMAND=1"   # #251d: der Wake-Bedarf waehlt die Stufe
NF_ENV_D="$NF_ENV_D;SGLANG_WEG2_D_KV_STAGE_FLOOR_TOKENS=32768"   # z30y2: KV-Stufen unter S0 (6025cac919), Boden 32k; Default 0 bis Metallbeleg
# -park (29.09., F4 #259 4c, im Image z30v als 084a10faa8): beim D-Schlaf schreibt jeder Rang den END-Zustand
#   jedes laufenden Requests als Park-Teil (dpark<tp>-<pid>) nach $SGLANG_HICACHE_ARENA_DIR/handoff (tmpfs /dev/shm);
#   der Resume nimmt ihn als E2-Skip statt den Decode-Schwanz neu zu rechnen. Liest nur D; braucht
#   TAIL_HANDOFF+TAIL_ADOPT+TAIL_SKIP_EXTEND (da) und unter dem Schnitt CUT_WORKER_END=1 (da).
NF_ENV_D="$NF_ENV_D;SGLANG_WEG2_ENABLE_D_PARK_END=1"

# Launcher-Argumente (ohne --tree/--tag/--transport; die setzt der Entrypoint). Quotierung von --extra-p/-d wie nf.env.
PROFILE_ARGS=(
  --corridor-budget-sample "$PROFILE_CORRIDOR"
  --profile nextflash --model "$PROFILE_MODEL"
  --flip-weights family --weg2-weight-source exchange --weg2-xchg-inject authoritative
  --xchg-bounce-depth 1 --weg2-weights-cpu-backup off --weight-chunks 16
  --weg2-xchg-census "$PROFILE_CENSUS"
  --env-p "$NF_ENV_P" --env-d "$NF_ENV_D"
  --d-foreign-context-mib 1446,896,894 --d-nontorch-mib 1981,528,524
  --d-tp-objective maxkv --draft-kv-on-p off --weg2-vision transient --pp-solve-pool-floor 0
  --pp-stage-ratio 29,11,8 --pp-attn-stage-ratio 7,3,2
  --pp-cut-expert-device-fraction "$NF_FR_P" --pp-cut-expert-lru-rows 32,32,32
  --user-reserve-mib 0,0,0 --store-max-gb 150 --max-kv-per-request 262144
  --p-bs 6                                             # H91: war --p-bs 4 --d-bs 1. P 6 Sitze (bb3 Arm Z.84 P_BS=6); --d-bs NICHT sagen -> standard_form 6 dyn.
  --extra-p '--max-total-tokens 262144 --json-model-override-args "{\"language_model_only\":true}" --kv-cache-dtype fp8_e4m3 --page-size 64 --max-running-requests 6 --mamba-ssm-dtype bfloat16 --ple-offload-embedding --ple-offload-backend checkpoint --hicache-mamba-host-mib 300 --hicache-size 2 --speculative-draft-model-path '"$PROFILE_DRAFT"' --rank-moe-resident-fraction '"$NF_FR_P"' --rank-user-reserve-mib 0,0,0 --disable-cuda-graph --context-length 262144 --max-kv-per-request 262144 --max-mamba-cache-size 32 --weight-loader-disable-mmap --weight-loader-direct-io'
  --extra-d '--max-total-tokens 262144 --json-model-override-args "{\"language_model_only\":true}" --kv-cache-dtype fp8_e4m3 --page-size 64 --max-running-requests 6 --mamba-ssm-dtype bfloat16 --ple-offload-embedding --ple-offload-backend checkpoint --hicache-mamba-host-mib 300 --rank-role host,worker,worker --rank-tp-ratio 1,0,0 --rank-moe-ratio 183,137,168 --rank-moe-resident-fraction '"$NF_FR_D"' --rank-user-reserve-mib 0,0,0 --speculative-draft-placement solo --speculative-algorithm NEXTN --speculative-num-steps 3 --speculative-eagle-topk 1 --speculative-num-draft-tokens 4 --speculative-draft-model-path '"$PROFILE_DRAFT"' --cuda-graph-bs-decode 1 2 3 4 5 6 --cuda-graph-backend-decode=full --cuda-graph-backend-prefill=disabled --hicache-size 4 --hicache-mamba-host-mib 300 --context-length 262144 --max-kv-per-request 262144 --weight-loader-disable-mmap --weight-loader-direct-io'
  --d-replayssm-spec on                                # H64, = bb3 (Arm LAUNCHER_EXTRA)
  --wake-credit-reference-logs "$PROFILE_WAKE_REF"     # H14/H54, Referenz fnFL2x162, = bb3
  --d-kv-token-cut owned                               # -st-cut: #239 S3f, Planer loest Eigentum+Schnitt+FR_D (Host 0)
  # REL: R3 --weg2-p-free-read-journal on steht unten hinter HTSGLANG_INSTRUMENTS=1 (nur Instrument)
  --turn-anchor-token 248045                           # -ta (29.09. 22:5xZ): Mamba-Anker an der Turn-Grenze (fca5956751), <|im_start|>=248045, nur P
  --x-ceiling-tokens 12288                             # RC2 (H84) = Registry nextflash x_ceiling_tokens; bb3 nannte es nicht (Registry-Default derselbe Wert)
)

[ "${HTSGLANG_INSTRUMENTS:-0}" = "1" ] && PROFILE_ARGS+=(--weg2-p-free-read-journal on)   # REL: R3 FSERIE z30x2: Bootzeit-3-Journal (nur Instrument)

# FORM (global exportiert: der Launcher kopiert os.environ in beide Gruppen UND in die Front, build_env / fenv).
profile_form_env() {
  _form SGLANG_WEG2_WAKE_DEFER_BELOW_MIB 0
  _form SGLANG_MOE_EXPERT_STORE_SLOT_FRACTION 0.82
  _form SGLANG_MOE_COLD_TIER_SHM 1
  _form SGLANG_MOE_COLD_TIER_INSTANCE "${HTSGLANG_TAG}"
  _form MALLOC_ARENA_MAX 2
  _form SGLANG_MOE_OFFLOAD_EXCLUDE_DRAFT 1
  _form SGLANG_MOE_OFFLOAD_WAVE_SLICE 40960
  # (y6o: SGLANG_NAN_GUARD-Zeile gestrichen -- #49-Diagnose, isfinite().item() je All-Reduce im Extend, py-spy 14 %)
  _form SGLANG_HC_MIXER_INT8 1
  _form SGLANG_MOE_MARLIN_ATOMIC_ADD 0
  _form SGLANG_MOE_POOL_STAGING 8
  _form SGLANG_QWEN4_PLE_FILE_SKIP_DEVICE_CHECK 1
  _form SGLANG_HICACHE_ARENA_MAMBA_SLOTS 32
  _form SGLANG_HICACHE_ARENA_KV_PAGE_BYTES 786432
  _form SGLANG_WEG2_DRAFT_ON_P 0
  _form SGLANG_WEG2_P_CHUNKED_PREFILL_TOKENS 16384
  _form SGLANG_WEG2_ENABLE_P_UNDIVIDED_MICRO_BATCH 1
  _form SGLANG_WEG2_ENABLE_P_MULTI_ANCHOR_TAILS 1
  _form SGLANG_WEG2_P_BURST_ASSEMBLY_MS 300
  _form SGLANG_WEG2_P_QUEUE_AHEAD 4                            # liest die FRONT; bb3 = 4 (WEG2-GROUP-ENV Z.234)
  _form SGLANG_WEG2_CTL_KICK_ARRIVAL 1
  _form SGLANG_WEG2_CTL_KICK_AFTER_FLIP 1
  _form SGLANG_WEG2_DC_OFF_PATH 1
  _form SGLANG_WEG2_ENABLE_FORM_A_TP0_FOLLOW 1                 # RC2.1k/l (H98), = Code-Default AN
  # H91 (bb3 Launcher-Env, Arm Z.93; Front und Raenge erben es; alle vier Code-Default AUS in 2a7f992c14):
  _form SGLANG_WEG2_QUIESCE_FAST 1                             # H111: Front-Poll 10 ms + PP0 ohne Wiederwunsch
  _form SGLANG_WEG2_DEPOSIT_LANE_LOOKAHEAD 1                   # H111b: Paar-Lanes vor der Pause (bb3 Default 1, H111d faengt das Staging-Rennen)
  _form SGLANG_WEG2_MIN_DWELL_EXCLUDE_DRAIN 1                  # H91c2: Min-Dwell ohne Drain
  _form SGLANG_WEG2_CENSUS_O1_EVICT 1                          # KR-Census-O1 (e17bd548b5)
  # #244 SA (rc12v 4c866d534a, weg2/seat_age.py): SEAT_ROTATE=1 = Sitzvergabe nach Ankunft + KV-Backfill +
  # Nachrücken des Ältesten (Nutzer-Entscheid 27.09. ~17:50Z über 27B). 0 wäre das alte resume-first.
  _form SGLANG_WEG2_SEAT_ROTATE 1
  # VARIANTE -vsync (28.09. ~21:00Z, Operator NF; einziger Unterschied zu -st-cut): synchrone Vision-Stufe, bis der
  # 27B-Fix der ASYNC-Stufe (Tod rc12z30c -st 20:50:53, #973 nach 'W102 ... ASYNC started') am Metall belegt ist.
  _form SGLANG_WEG2_VISION_ASYNC 0
  _form SGLANG_WEG2_ENABLE_ARRIVAL_SEAT_RULE 1                # -arr: Ankunftsregel (Nutzer 19:40Z), Front + Raenge erben
  # BOOTZEIT (A) -odx (28.09. ~22:00Z, Bootzeit-Sitz; einziger Unterschied zu -st-cut-vsync = Leseweg der Gewichte):
  # PREAD=1 (P+D) + --weight-loader-disable-mmap --weight-loader-direct-io am Ende von --extra-p/--extra-d +
  # koaleszierte O_DIRECT-Laeufe (desk/nf-bootzeit2-0928 36381c12b0). Braucht ein Image mit 36381c12b0.
  # Metall-Marker je Rang: 'WEG2-LOAD-COALESCE runs=.. read_GB/s=.. reads=direct:N,buffered:0' (buffered>0 = O_DIRECT
  # verweigert); memts: kein Page-Cache-Anstieg beim Laden, cg memory.current weit unter 84 GiB.
  _form SGLANG_WEIGHT_LOADER_COALESCE_MIB 32
  # BOOTZEIT 3 (29.09.): NUR Stufe 2b (Nicht-Experten P->D ueber den Page-Cache) -- Stufe 1/1b AUS (z30r3:
  #   Presplit-Thread 51 s statt 26,8 s seriell; Koordinator: aus bis der Presplit-Posten geloest ist). 2b steht
  #   in NF_ENV_P_FORM (=keep) und NF_ENV_D_FORM (=drop); Marker 'WEG2-LOAD-COALESCE SHARED-CACHE mode=keep
  #   kept_mib=..' auf P, 'mode=drop ... hit_mib=.. [disk_bytes=..]' auf D (disk_bytes ab 9d33e0700a).
  #   Beide Werte entfernen = 2b aus.
  # Presplit-Store-Schreiben in Laeufen statt je Zeile (cc67f865de; z30r3 PP0 store_write 16,7 von 51,1 s). Marker:
  #   Stufe-0-Zeile '[ct-stream-presplit] ... store_write=..' je Layer (Erwartung PP0 ~0,58 -> <0,1 s). Zeile weg = aus.
  _form SGLANG_EXPERT_STORE_WRITE_RUNS 1
  _form SGLANG_WEG2_ENABLE_PARK_COLLECT_WINDOW 1        # z30y: Ski-Verleih-Sammelfenster (98b596db36/741bdfcef4), Default aus bis z30y-Beleg
  _form SGLANG_WEG2_ENABLE_X_COST_LINE 1                # z30y: X aus Kostengerade D+P (94e238791a/800bb82ac6/367478a42c), Default aus bis z30y-Beleg
  # REL: R2 -- die drei folgenden Zeilen standen in der Vorlage in profile_instr_env (laeuft nur bei HTSGLANG_INSTRUMENTS=1).
  # z30v (29.09.): Eigentums-Solve nach synchroner Runde (43d7f6b8d7) + Repack nur gelesene Zeilen (f8f9b6acd2)
  # FSERIE (Koordinator 29.09.): workers statt round -- round war bei jedem bs langsamer (Decode-Sitz, z30u vs z30w-park)
  _form SGLANG_WEG2_OWNED_CUT_X1 workers
  # -dres-y6n (01.10. ~20:35Z, Koordinator): y6n traegt ede8266c5d mit OWNED_BASE=derive als Default --
  # derive landet ohne Pool-Schritt/Wellenboden/KV-Stufe im Solve auf 190,127,171 / 0,52,12 (Stufe 7, 4 Wellen).
  # Bis der Constraint-Fix im Baum ist: Handbasis wie -dres (--rank-moe-ratio 183,137,168).
  _form SGLANG_WEG2_OWNED_BASE stated
  _form SGLANG_MOE_REPACK_SKIP_VETOED 1
}
# INSTRUMENTE (global; die gruppenweisen stecken in NF_ENV_*_INSTR oben). Wie nf.env.
profile_instr_env() {
  _form SGLANG_LOAD_PROFILE 1
  _form CUDA_ENABLE_COREDUMP_ON_EXCEPTION 1
  _form CUDA_ENABLE_LIGHTWEIGHT_COREDUMP 1
  _form CUDA_COREDUMP_FILE "${SGLANG_WEG2_EVIDENCE_DIR:-/var/lib/htsglang/evidence}/cudacore_${HTSGLANG_TAG}_%h_%p"
  _form SGLANG_HICACHE_ARENA_REF_CENSUS_S 60
  _form SGLANG_WEG2_VRAM_ACTUAL 1                         # FSERIE z30x2: M2 VRAM-Ist je PID/Kategorie in den RankState
  # REL: R2 OWNED_CUT_X1 / OWNED_BASE / REPACK_SKIP_VETOED stehen jetzt in profile_form_env (Formschalter, keine Instrumente)
}

# Saat-Dateien der NF-Linie (Image /opt/htsglang/profiles/nf/, Liste profiles/nf.assets), wie nf.env.
PROFILE_SEED_EVIDENCE=(
  /opt/htsglang/profiles/nf/weg2_measured_record.json
)
PROFILE_SEED_SGLANG_CACHE=(
  /opt/htsglang/profiles/nf/phase_footprint-a191a0712717-055c2e4b0867.json
  /opt/htsglang/profiles/nf/phase_footprint-a191a0712717-cc0ac5caf91e.json
  /opt/htsglang/profiles/nf/card_library.json
  /opt/htsglang/profiles/nf/card_library.json.by-uuid.json
)
# -korr (29.09. ~20:10Z): = -z30y2 (y3j-Schalter REARM_DEFER_HOST/PARK_WINDOW_GATE AUS, Verdacht Park-Livelock z30y3j) + RANKSTATS; fuer die Korrektheitsprobe (Aufgabe C)
NF_ENV_P="$NF_ENV_P;SGLANG_WEG2_ENABLE_RANKSTATS=1"
NF_ENV_D="$NF_ENV_D;SGLANG_WEG2_ENABLE_RANKSTATS=1"
# -arr (29.09. ~20:30Z): = -korr + Ankunftsregel (61aba01120, Nutzer 19:40Z) auf Front UND D; Metallnachweis, danach Default an
NF_ENV_P="$NF_ENV_P;SGLANG_WEG2_ENABLE_ARRIVAL_SEAT_RULE=1"
NF_ENV_D="$NF_ENV_D;SGLANG_WEG2_ENABLE_ARRIVAL_SEAT_RULE=1"
export SGLANG_WEG2_ENABLE_ARRIVAL_SEAT_RULE=1
# -arr-wre (29.09. ~22:35Z, Stotterer-Sitz D-Nachlauf Wurzel 2): Arena 4 -> 4.75 GiB P+D (gemessene Wake-Lesespitze 411264 Tok = 6426 Seiten, 6485 Slots, +0,80 GiB Host)
# + F22 WAKE_READ_EARLY (200f9ecc55, im Baum seit z30z, nie gebootet) erste Serie; nach Metallnachweis Default an
NF_ENV_D="$NF_ENV_D;SGLANG_WEG2_ENABLE_WAKE_READ_EARLY=1"
# -dh (30.09. ~00:00Z, Stotterer-Sitz D->P): #284b a29b5df41b -- DEFER_HOST-Fuellung erst nach dem letzten Host-Warten des Wakes (P-Wake 2,7 -> ~1,9 s); erste Serie, danach Default P
NF_ENV_P="$NF_ENV_P;SGLANG_WEG2_REARM_DEFER_HOST_GROUPS=P"
NF_ENV_D="$NF_ENV_D;SGLANG_WEG2_REARM_DEFER_HOST_GROUPS=P"
# + L3-Eviction ausserhalb reserve() (27B-Schalter 5a8b44523c): y3p ep57 PARK-DEMOTE 2016 ms hinter synchronem EVICTION-RUN 15,1 GB
NF_ENV_P="$NF_ENV_P;SGLANG_HICACHE_FILE_BACKEND_EVICT_OFFPATH=1"
NF_ENV_D="$NF_ENV_D;SGLANG_HICACHE_FILE_BACKEND_EVICT_OFFPATH=1"
# 1b0e4a9394 Mini-Extend Device-Schritt: CHECK am Metall 144/144 MATCH (y3y 0930_015408) -> Prüfinstrument aus
NF_ENV_D="$NF_ENV_D;SGLANG_DEBUG_MOE_POOL_EAGER_DEVICE_CHECK=0"
# -ml (30.09. ~04:40Z, Nutzer-Order "sysctl/hugepages umsetzen"): STORE-MLOCK 1d6302a589 -- Expert-Store vor cudaHostRegister mlocken,
# damit die Kompaktierung die gepinnten Store-Seiten ueberspringt (Host: vm.compact_unevictable_allowed=0, devtools/host_sysctl_nf_pinned_store.sh).
# Wurzel: y3z/y4a D-Laden 99 s (~313k pgmigrate_fail/s). Erste Serie; nach Metallnachweis Default an. Container hat --ulimit memlock=-1.
NF_ENV_P="$NF_ENV_P;SGLANG_WEG2_STORE_MLOCK=1"
NF_ENV_D="$NF_ENV_D;SGLANG_WEG2_STORE_MLOCK=1"
export SGLANG_WEG2_STORE_MLOCK=1
# -ef (30.09. ~06:40Z, NF-Operator): ENV-NACHZUG. PROFILE_ARGS (oben, --env-p/--env-d) wurde mit dem NF_ENV_P/D
# DAMALS gebaut; jede spaetere Zeile NF_ENV_D="$NF_ENV_D;..." kam NIE im Rang an (y4f: F22 WAKE_READ_EARLY,
# REARM_DEFER_HOST_GROUPS, EVICT_OFFPATH, RANKSTATS, EAGER_DEVICE_CHECK=0 -- read_early=0 in jedem Wake).
# Hier werden die beiden Werte in PROFILE_ARGS durch die endgueltigen ersetzt.
for _efi in "${!PROFILE_ARGS[@]}"; do
  case "${PROFILE_ARGS[$_efi]}" in
    --env-p) PROFILE_ARGS[$((_efi+1))]="$NF_ENV_P" ;;
    --env-d) PROFILE_ARGS[$((_efi+1))]="$NF_ENV_D" ;;
  esac
done
unset _efi

# (30.09. 13:15Z) Kollektiv-Uhr + AR-Zensus ENTFERNT: kosten in D +4,6 ms Wand/Runde (y4k vs 0930_1011, launch_ms 0,4 -> 13)
NF_ENV_D="$NF_ENV_D;SGLANG_WEG2_RESUME_WARM_FINISH=1"   # RW-FINISH (7b8a247afd)
NF_ENV_D="$NF_ENV_D;SGLANG_WEG2_ENABLE_TAIL_STAGE_EARLY=1"   # TAIL-STAGE-EARLY (0189b95252): Tail-Read ab Leg-Beginn

NF_ENV_P="$NF_ENV_P;SGLANG_WEG2_ENABLE_PREFILL_FETCH_OVERLAP=1"   # PFO (3264fb08b5)

NF_ENV_P="$NF_ENV_P;SGLANG_WEG2_ENABLE_TARGETED_PREWARM=1"   # P-Prewarm (9b5922de43)

NF_ENV_P="$NF_ENV_P;SGLANG_ENABLE_HC_COMPILE_DYNAMIC_ROWS=1"   # HC-Mixer dynamisch (4d29231942)
NF_ENV_D="$NF_ENV_D;SGLANG_ENABLE_HC_COMPILE_DYNAMIC_ROWS=1"

# Nachzug erneut (wie -ef): PROFILE_ARGS bekommt die endgueltigen NF_ENV_P/D, sonst wirken die Zeilen oben nicht.
for _efi in "${!PROFILE_ARGS[@]}"; do
  case "${PROFILE_ARGS[$_efi]}" in
    --env-p) PROFILE_ARGS[$((_efi+1))]="$NF_ENV_P" ;;
    --env-d) PROFILE_ARGS[$((_efi+1))]="$NF_ENV_D" ;;
  esac
done
unset _efi

# -srw (30.09.): D-Sitzzahl n live in beide Richtungen (Nutzer-Design Variante B + Rückweg). Front zählt D-Sitze bis --d-bs.
# Marker D-TP0: 'WEG2 D-SEAT-REWAKE WAKE-APPLY|GROW|SHRINK ... pause_ms=', 'LIVE-SPANS ... wiped=0'; Front 'why=seat' bei freiem KV weg.
export SGLANG_WEG2_D_SEAT_REWAKE=1
NF_ENV_D="$NF_ENV_D;SGLANG_WEG2_D_SEAT_REWAKE=1"
for _efi in "${!PROFILE_ARGS[@]}"; do
  case "${PROFILE_ARGS[$_efi]}" in
    --env-p) PROFILE_ARGS[$((_efi+1))]="$NF_ENV_P" ;;
    --env-d) PROFILE_ARGS[$((_efi+1))]="$NF_ENV_D" ;;
  esac
done
unset _efi

# -tsw (30.09.): Staging seriell in EINEM Worker je Rang, in eine beim Boot gepinnte Arena (kein pin_memory je Tensor).
# Marker D: "WEG2-HOST-LEDGER TAIL-STAGE-ARENA" (Boot), "WEG2-TAIL-STAGE-WORKER jobs=... worker_issue_ms ... arena_used_mib ... fallback ... digest=worker:pre-verdict" je Wake.
# Erwartung bei 6 Sitzen gegen y4w: BAR1 collect issue_ms TP0 ~250, expert-rearm ~90, TAIL-READY waited 0.
export SGLANG_WEG2_TAIL_STAGE_WORKER=1
NF_ENV_D="$NF_ENV_D;SGLANG_WEG2_TAIL_STAGE_WORKER=1"
# Nachzug (wie -ef/-srw): PROFILE_ARGS bekommt die endgueltigen NF_ENV_P/D.
for _efi in "${!PROFILE_ARGS[@]}"; do
  case "${PROFILE_ARGS[$_efi]}" in
    --env-p) PROFILE_ARGS[$((_efi+1))]="$NF_ENV_P" ;;
    --env-d) PROFILE_ARGS[$((_efi+1))]="$NF_ENV_D" ;;
  esac
done
unset _efi

# -sd (30.09. ~17:25Z, NF-Operator; 17:37Z auf 4096: W153 Weg2ShortDrainAboveX verweigerte 12288 > X=4096): SHORT-DRAIN auf D. y4y 17:05:48Z: zwei SHORT-Requests (777/774 Token) kamen
# während des Flips P->D an, wurden als BATCH für P eingereiht und standen 300 s in der Front-Queue, bis der Client
# aufgab. Unter ARRIVAL-SEAT besitzt niemand eine reine SHORT-Queue (FLIP-ECONOMICS hold 1551<4096, fairness=False),
# und _d_short_drain war auf NF aus (Launcher-Default 0). 27B fährt 4096 (27b.env). Der Wert wird durch das geltende X
# gedeckelt (front.py law 4). Der Code-Fix (ARRIVAL-SEAT übergibt SHORT an D) liegt beim Implementierer.
PROFILE_ARGS+=(--d-short-drain-tokens 4096)
# 30.09. ~19:10Z (NF-Operator): TAG-STALL-SENTINEL aus -- faulthandler.dump_traceback_later liest fremde
# Thread-Frames ohne GIL; 27B z30y8 PP1-SIGSEGV fiel exakt auf so einen Dump (RPC-Watchdog, gleicher Mechanismus).
# In y5a feuerte der Sentinel 0x; fuer den Freeze-Lauf kein Risiko offen lassen. Rueckbau: Zeilen loeschen.
# REL: R4 Der Wert 1.5 der Vorlage ist der Code-Default (= AN, weg2/tag_stall_sentinel.py; 0 = aus) -- der Kommentar oben
#   ("aus") und der Wert widersprachen sich. Release: aus; mit HTSGLANG_INSTRUMENTS=1 wie in den Messboots 1.5.
_nf_tss=0; [ "${HTSGLANG_INSTRUMENTS:-0}" = "1" ] && _nf_tss=1.5
export SGLANG_WEG2_TAG_STALL_SENTINEL_S=$_nf_tss
NF_ENV_P="$NF_ENV_P;SGLANG_WEG2_TAG_STALL_SENTINEL_S=$_nf_tss"
NF_ENV_D="$NF_ENV_D;SGLANG_WEG2_TAG_STALL_SENTINEL_S=$_nf_tss"
unset _nf_tss
# --- nf-int4-h6 (02.10. 11:52Z): copy of nf-int4 with H6a on (6b8913e519, desk/nf-flipzyklus-h6-1002):
# wake-kv fused into the weights leg (P>D wake-kv 158 ms -> ~40-60 ms expected). Placed BEFORE the R5 loop so the
# switch reaches --env-p/--env-d (an append after the loop only reaches the launcher's own env).
export SGLANG_WEG2_ENABLE_WAKE_KV_FUSED=1
NF_ENV_P="$NF_ENV_P;SGLANG_WEG2_ENABLE_WAKE_KV_FUSED=1"
NF_ENV_D="$NF_ENV_D;SGLANG_WEG2_ENABLE_WAKE_KV_FUSED=1"
# H88-E (PLAN-H88-W4A8-1007 D3): W4A8-int8-MoE-Experten in BEIDEN Gruppen. Vor dem letzten Nachzug, damit der Schalter --env-p/--env-d erreicht
# (wie WAKE_KV_FUSED oben); export = die Launcher-Umgebung selbst. Flag-Form derselben Sache: --moe-act-int8 on (ServerArgs, ueber --extra-p/-d).
export SGLANG_MOE_ACT_INT8=1
NF_ENV_P="$NF_ENV_P;SGLANG_MOE_ACT_INT8=1"
NF_ENV_D="$NF_ENV_D;SGLANG_MOE_ACT_INT8=1"
# REL: R5 letzter Nachzug -- die Anhaenge seit dem -tsw-Nachzug (TAG_STALL) erreichen jetzt auch --env-p/--env-d.
for _efi in "${!PROFILE_ARGS[@]}"; do
  case "${PROFILE_ARGS[$_efi]}" in
    --env-p) PROFILE_ARGS[$((_efi+1))]="$NF_ENV_P" ;;
    --env-d) PROFILE_ARGS[$((_efi+1))]="$NF_ENV_D" ;;
  esac
done
unset _efi
