# shellcheck shell=bash
# Profil 27b-fp8 -- Qwen/Qwen3.8-27B-FP8 (Block-FP8 128x128, HF 017b9c7af6) + DFlash2-W8-Draft, weg2-Flip-Form, RC2-final.
#
# STAND: ABGENOMMEN (Operator 25.09.): Boot weg2rc2f8 mit arm_rc2final_fp8.sh auf b5c7d01614 -- FERTIG 6/6 Raenge,
# GEN und Nadeln MATCH, der Prewarm-Fix a40837f4a0 wirkt (0x KEPT-Ladepool), Decode auf INT8-Niveau, P-Prefill-Leiter
# 3054/3899/3806 tok/s bei 2048/8192/32768 Tokens (ladder_weg2rc2f8.json, P-Wand der Front, Median).
# Vorher VORBEREITET; freigeschaltet per PROFILE_PLACEHOLDER=0 und `prepare_context.sh --refresh-tools <ctx>`.
# RC4 (9738626129, arm_rc4.sh FORMAT=fp8): Form unveraendert, am 25.09. gegen arm_rc4.sh gegatet (Env 34/34, Namespace gleich).
# RC5 (5f13f1aad9): LoadConfig per sha256 identisch zu RC4 (Operator), arm_rc5.sh gleiche Form, gegen den RC5-Launcher gegatet.
#
# QUELLE (25.09.): Ls /spinning/gpu-arb/weg2/arm_rc2final_fp8.sh, FORMAT=fp8, Baum desk/27b-release-rc2-0924 @
# b5c7d01614. Die FP8-Form ist die INT8-Form von profiles/27b.env -- dieselben 34 Env-Variablen (arm_rc2final.sh und
# arm_rc2final_fp8.sh exportieren denselben Satz), dieselben Argumente einschliesslich P-Trim, Graph-Split und
# Idle-Politik -- plus genau drei Argumente aus dem Arm:
#   --model <FP8-Checkpoint> --fp8-uniform-marlin   (FMT_ARGS, im Arm direkt hinter --tag)
#   --weg2-xchg-census-foreign                       (CENSUS_FOREIGN, im Arm direkt hinter dem Census)
# Darum baut diese Datei auf 27b.env auf, statt dessen Listen zu kopieren: die beiden Formen koennen nicht
# auseinanderlaufen. Nur fuer die Sonden des Arms (nicht die Form): RETRACT_TOKENIZER, PROBE_TEMPO=2, PARK_N=4.
#
# Form-Notizen von Agent K (27B-FP8, 24./25.09.), weiter gueltig:
# * Metall: xsn441 (fdade8572f) starb am ersten Flip-Paar (W106 durch die FP8-Sonde im Basis-Tag + Marlin-Ladereste
#   in den Tag-Pools); xsn442 auf b434831067 (arm_xsnF8b.sh) GRUEN: 6 Flip-Epochen, GEN Paris vor/nach, Nadeln
#   MATCH, Decode INT8-Niveau, Prefill ~55-65 % von INT8 (W8A16-Marlin statt INT8-Tensorkerne). a40837f4a0 (in
#   b5c7d01614): FP8-Faehigkeitsfrage vor der Gewichtsregion, kein KEPT-Ladepool auf der 5090.
# * CENSUS: es gibt noch keinen FP8-Census, der den Residenz-Check besteht. PROFILE_CENSUS bleibt der INT8-Census von
#   weg2xsn246; ab b434831067 verweigert der Launcher einen Census eines anderen Checkpoints (W161), darum
#   --weg2-xchg-census-foreign. Ein auf FP8 gemessener Census (xchg_census_weg2xsn442_b434831067.json) laesst W71
#   auf der 5090 verweigern, obwohl xsn442 sechsmal flippte (KNOWN_ISSUES_RC2.md, letzter Punkt): nicht tauschen,
#   bevor die Ruhe-/Spitzenterme neu hergeleitet sind.
# * P-Schnitt: kein Kalibrier-Record fuer diesen Checkpoint -> Launcher-Zeile 'WEG2 P-CUT UNCALIBRATED fp8' und der
#   INT8-Vektor (P_STAGE_FIT bleibt 0, W40).
# * Kernel/JIT: unter --fp8-uniform-marlin auf ALLEN Raengen Marlin-FP8 (W8A16, sglang jit_kernel gptq_marlin /
#   gptq_marlin_repack ueber tvm-ffi), auch auf sm_120 -- eine Byte-Geometrie fuer den Austausch.
#   SGLANG_FORCE_FP8_MARLIN setzt der Launcher selbst (--fp8-uniform-marlin), nicht das Profil.
#   SGLANG_WEG2_DENSE_REPACK_OUTSIDE_POOL=1 (aus 27b.env) traegt ab b434831067 auch den FP8-Marlin-Repack aus den
#   Tag-Pools (H39); ohne ihn liegen 1,5-4,1 GiB Ladereste je Rang in den Flip-Tags (xsn441).
# * /dev/shm und MemAvailable: aus 27b.env; am FP8-Boot weg2rc2f8 nachgemessen (25.09.): /dev/shm-Spitze 34,2 GiB
#   (INT8 weg2rc2f 34,0), nonreclaim-Spitze 71,7 GiB in CT999-Sicht (INT8 70,1) -- die Untergrenzen gelten fuer beide.

# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/27b.env"

PROFILE_NAME=27b-fp8
PROFILE_FORMAT=fp8             # quant_method fp8, e4m3, weight_block_size [128,128] (Formaterkennung im Entrypoint)
PROFILE_MODEL=/spinning/llm_stuff/club-3090/models-cache/Qwen3.8-27B-FP8
PROFILE_FORM=rc2final          # gegen arm_rc2final_fp8.sh (FORMAT=fp8) gegatet
PROFILE_STATUS=abgenommen     # FP8-Abnahme weg2rc2f8 (Operator 25.09.)
PROFILE_PLACEHOLDER=0
PROFILE_OWNER="27B-Sitz (Form Agent K / Arm Agent L, abgenommen mit weg2rc2f8 @ b5c7d01614)"
# PROFILE_NCCL_STATUS=unproven, PROFILE_DRAFT, PROFILE_CENSUS (INT8, siehe oben), PROFILE_GPUS, PROFILE_SHM_MIN_GIB,
# PROFILE_MEMAVAIL_MIN_GIB, PROFILE_P_TRIM*, profile_form_env und profile_instr_env kommen aus 27b.env.

# FP8-Teil in die geerbte Argumentliste setzen, an die Stellen, an denen der Arm sie traegt.
_fp8_args=(--model "$PROFILE_MODEL" --fp8-uniform-marlin)
for ((_i = 0; _i < ${#PROFILE_ARGS[@]}; _i++)); do
  _fp8_args+=("${PROFILE_ARGS[_i]}")
  if [ "${PROFILE_ARGS[_i]}" = "--weg2-xchg-census" ]; then
    _fp8_args+=("${PROFILE_ARGS[_i + 1]}" --weg2-xchg-census-foreign)
    _i=$((_i + 1))
  fi
done
PROFILE_ARGS=("${_fp8_args[@]}")
unset _fp8_args _i
