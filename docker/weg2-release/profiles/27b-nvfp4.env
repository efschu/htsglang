# shellcheck shell=bash
# Profil 27b-nvfp4 -- RadixArk Qwen3.8-27B-NVFP4 (modelopt MIXED_PRECISION, HF 319f741cce) + DFlash2-W8-Draft, weg2-Flip, RC5.
#
# STAND: ABGENOMMEN (Operator 25.09.): RC4-Boot weg2rc4n4 (arm_rc4.sh FORMAT=nvfp4) bestanden, Urteil L: JA. Die Abnahme
# gilt fuer RC5 (desk/27b-release-rc5-0925 @ 5f13f1aad9): die LoadConfig von INT8, FP8 und NVFP4 ist per sha256 identisch
# zu RC4, arm_rc5.sh traegt dieselbe Form (Argv und Env byte-gleich zu arm_rc4.sh), gegatet gegen den RC5-Launcher.
#
# QUELLE (25.09.): Ss /spinning/gpu-arb/weg2/arm_rc4.sh, FORMAT=nvfp4 (Baum desk/27b-release-rc4-0925 @ 9738626129;
# Form = arm_rc3.sh nvfp4 = arm_xsnNV4a.sh, am Metall weg2xsnNV4a). Gleiche 34 Env-Variablen wie INT8/FP8; Argumente =
# INT8-Form von 27b.env plus:
#   --model <RadixArk-Checkpoint> --fp8-uniform-marlin   (FMT_ARGS; modelopt: der Launcher setzt SGLANG_FORCE_FP8_MARLIN
#                                                          und --fp4-gemm-backend marlin selbst)
#   --weg2-xchg-census-foreign                          (INT8-Census, kein eigener NVFP4-Census)
#   --pp-stage-ratio 42,11,11 --pp-attn-stage-ratio 10,3,3   (P-Schnitt GEPINNT fuer den Formatvergleich, P_CUT_PIN/P_ATTN_PIN)
# Graph 512, Graph-Split 7, P-Trim und Idle-Politik wie INT8. Nur fuer die Sonden des Arms: RETRACT_TOKENIZER,
# PROBE_TEMPO=2, PARK_N=4.
#
# Modellformat: nvfp4-modelopt (Erkennung: quant_method modelopt + hf_quant_config.json). NICHT das unsloth-CT-NVFP4 unter
# models-cache/Qwen3.8-27B-NVFP4 (compressed-tensors -> nvfp4-ct, anderer Lader).
# Kernel/JIT: Marlin auf allen Raengen (FP4-Experten/-Linears und FP8-Anteile per Marlin, tvm-ffi jit_kernel); die
# tvm-ffi-Saat enthaelt die am Rig gebauten Kerne (Stand des Kontexts).

# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/27b.env"

PROFILE_NAME=27b-nvfp4
PROFILE_FORMAT=nvfp4-modelopt
PROFILE_MODEL=/spinning/llm_stuff/club-3090/models-cache/Qwen3.8-27B-NVFP4-RadixArk
PROFILE_FORM=rc5                # gegen arm_rc4.sh und arm_rc5.sh (FORMAT=nvfp4) gegatet
PROFILE_STATUS=abgenommen       # RC4-Boot weg2rc4n4, Urteil L JA (Operator 25.09.)
PROFILE_PLACEHOLDER=0
PROFILE_OWNER="27B-Sitz (NVFP4 Agent K, Arm S/L; abgenommen mit weg2rc4n4, gilt fuer RC5)"

_fmt_args=(--model "$PROFILE_MODEL" --fp8-uniform-marlin)
for ((_i = 0; _i < ${#PROFILE_ARGS[@]}; _i++)); do
  _fmt_args+=("${PROFILE_ARGS[_i]}")
  if [ "${PROFILE_ARGS[_i]}" = "--weg2-xchg-census" ]; then
    _fmt_args+=("${PROFILE_ARGS[_i + 1]}" --weg2-xchg-census-foreign); _i=$((_i + 1))
  fi
done
PROFILE_ARGS=("${_fmt_args[@]}" --pp-stage-ratio 42,11,11 --pp-attn-stage-ratio 10,3,3)
unset _fmt_args _i
