# shellcheck shell=bash
# Profil 27b -- Qwen3.8-27B INT8-W8A8 (gdncov-vocabembed) + DFlash2-W8-Draft, weg2-Flip-Form, RC2-final (INT8-Freeze).
# ENTWURF (27B-Sitz R, 24.09.2026). Vom Entrypoint (MODE=weg2) gesourct.
#
# QUELLE (25.09.): Ls /spinning/gpu-arb/weg2/arm_rc2final.sh, FORMAT=int8 (Boot weg2rc2f, als INT8-Freeze
# abgenommen; End-SHA b5c7d01614 auf desk/27b-release-rc2-0924, INT8 dort byte-gleich zu 0b3e82b302). RC2-final
# aendert die Form gegenueber arm_rc2.sh in genau einem Punkt: P_GRAPH_SPLIT=1 (--p-prefill-graph-split 7,
# Arm-Aenderung (7)); die Env-Saetze von arm_rc2.sh, arm_rc2final.sh und arm_rc2final_fp8.sh sind identisch.
# Das FP8-Profil 27b-fp8.env baut auf dieser Datei auf (gleiche Env, gleiche Argumente + FP8-Teil), ebenso 27b-nvfp4.env
# und 27b-gguf.env. RC4 (desk/27b-release-rc4-0925 @ 9738626129, arm_rc4.sh FORMAT=int8): die INT8-Form ist unveraendert --
# am 25.09. gegen arm_rc4.sh gegatet (Env 34/34, geparster Namespace des RC4-Launchers gleich).
# RC5 (desk/27b-release-rc5-0925 @ 5f13f1aad9): LoadConfig per sha256 identisch zu RC4 (Operator), arm_rc5.sh byte-gleiche
# Form, gegen den RC5-Launcher gegatet (25.09. ~05:25Z) -- die Abnahme gilt.
# Vorheriges Gate gegen arm_rc2.sh (24.09. ~23:15Z, per Diff), gilt fuer alles ausser P_GRAPH_SPLIT weiter:
#   Env:  arm_rc2.sh exportiert 34 Variablen = RC1-Satz (arm_rc1.sh, 29, identisch mit arm_xsn436.sh) + die fuenf
#         RC2-Schalter. Hier: 29 Form + 5 Instrumente = dieselben 34 Namen und Werte; einziger Unterschied ist der
#         Pfad von SGLANG_DFLASH_PHASE_TIMING (Evidenz-Verzeichnis des Containers, Stufe B).
#   Argv: BASE und Launch-Zeile von arm_rc1.sh und arm_rc2.sh sind byte-gleich; EXTRA_D von RC2 = RC1 +
#         --p-trim-end-anchor (P_TRIM=1) + --idle-layout pp --d-hold-s 10 --d-short-drain-tokens 4096, in dieser
#         Reihenfolge. P_SPLIT/P_STAGE_FIT/P_GRAPH_SPLIT/P_TINY und die Positionsargumente (CAP 262144, BDEPTH 1,
#         LEGS both, HICACHE an, kein DEBUG_HOLD, CPU_BACKUP off) haben in beiden Armen dieselben Defaults.
#   Der RC2-Baum hat gegenueber fe316bdf40 genau diese zwei neuen Launcher-Flags und fuenf Env-Schalter
#   (git diff fe316bdf40 4aded781ab), sonst keine; der Launcher des RC2-Baums parst PROFILE_ARGS vollstaendig.
# Aendert L den Arm, wird diese Datei neu gegen ihn gegatet (Plan §12 D2).
#
# BAUM: desk/27b-release-rc2-0924 @ b5c7d01614 (gepusht). Stufe B steckt als Pick 68bc631d8c darin (patch-id
# gleich bae049a3b4; prepare_context.sh prueft Vorfahr ODER Pick UND die Naehte inhaltlich).
#
# Diese Datei ist die FORM (Regel arm-env-des-starters-nicht-im-direktstart-0924: die Form steht IM Arm bzw.
# hier, nie im Aufrufer-Env). Ein `docker run -e X=...` auf eine Form-Variable wird vom Entrypoint als
# FORM-OVERRIDE laut gemeldet.
#
# RIG-GEBUNDEN: --user-reserve-mib, --host-riegel-gib, die Ledger-Abweichung, Census, PROBE_RING, calib/ und
# corridor_budget_sample.json sind Messungen DIESES Rigs (1x RTX 5090 + 2x RTX 3080, 118-GiB-LXC).
# Pfade (Stufe B): Census als Image-Asset per Flag; PROBE_RING, calib/ und corridor_budget_sample.json liegen in
# der ARB-Saat und werden beim Start nach $SGLANG_WEG2_GPU_ARB/weg2/ kopiert, wo der Launcher sie ohne Flag findet.

PROFILE_NAME=27b
PROFILE_LINE=27b
PROFILE_FORM=rc2final         # gegen arm_rc2final.sh (FORMAT=int8) gegatet, siehe Kopf
PROFILE_STATUS=abgenommen     # INT8-Freeze RC2-final (Operator 25.09.)
PROFILE_FORMAT=int8            # compressed-tensors, Gewichte int8 (Formaterkennung im Entrypoint)
PROFILE_NCCL_STATUS=unproven   # 27B-DFLASH-Form nie mit --transport nccl gebootet (einzige weg2-NCCL-Messung: weg2ab0, 07.09., andere Form)
PROFILE_MODEL=/spinning/llm_stuff/club-3090/models-cache/Qwen3.8-27B-INT8-gdncov-vocabembed
PROFILE_DRAFT=/spinning/llm_stuff/club-3090/models-cache/Qwen3.8-27B-DFlash2-W8-lued
PROFILE_CENSUS=/opt/htsglang/profiles/27b/xchg_census_weg2xsn246_27198a2711.json
# Erwartetes Karteninventar (Name=Anzahl, NVML-Namen). Zuordnung Rang<->Karte macht der
# Launcher per UUID (order_cards: 5090 zuerst), nie per Index.
PROFILE_GPUS="NVIDIA GeForce RTX 5090=1;NVIDIA GeForce RTX 3080=2"
# /dev/shm: KV-Arena 22,9 GiB + Mamba-Arena 8,2 GiB + Lanes ~2,8 GiB; gemessene Spitze
# 34,0-34,2 GiB (shmfiles_weg2xsn427..435, du -sm >= 64 MiB alle 2 s). Untergrenze mit Luft:
PROFILE_SHM_MIN_GIB=40
# Launcher-eigene Boot-Untergrenze (host_preflight, launcher.py:2686-2690): MemAvailable >= 40 GiB.
PROFILE_MEMAVAIL_MIN_GIB=40

# Launcher-Argumente (ohne --tree/--tag/--transport; die setzt der Entrypoint).
# Effektiv wie arm_rc2final.sh BASE + EXTRA_D + Launch-Zeile (argparse: letzte gewinnt, also
# --host-riegel-gib 93.0 und die Ledger-Abweichung einmal). BEWUSST NICHT uebergeben, weil der
# Arm sie nicht uebergibt: --model und --dflash-draft-path (Modelle werden unter DEMSELBEN Pfad
# gemountet, Launcher-Defaults greifen), --duplex-probe (liegt in der ARB-Saat), --venv
# (SGLANG_WEG2_VENV), --evidence-dir. Jedes zusaetzliche Flag waere eine Argv-Abweichung vom
# Referenz-Boot, die Gate D2 erst wegerklaeren muesste.
PROFILE_ARGS=(
  --weg2-weight-source exchange
  --weg2-xchg-census "$PROFILE_CENSUS"
  --weg2-xchg-oncard host
  --weg2-vision transient
  --user-reserve-mib 1800,1400,1400
  --store-max-gb 150
  --max-kv-per-request 262144
  --xchg-bounce-depth 1
  --pin-ledger-arm-m 600
  --host-ledger-deviation 1424e-ratchet-37gib-aus-xsn177-war-ganzarena-pinning-seit-1424e-je-slot
  --host-riegel-gib 93.0
  --weg2-xchg-legs both
  --weg2-xchg-inject authoritative
  --p-bs 1
  --extra-p=--max-running-requests=2
  --weg2-weights-cpu-backup off
  --spec-form DFLASH
  --d-tp-objective decode-bs1
  --p-host-overlap
  --p-hostgap
  --p-prefill-graph 512
  --d-replayssm-spec on        # Nutzer 24.09. ~20:47Z "ja einschalten" (ab xsn436; D-KV +21/+13 %, nicht langsamer)
  --p-prefill-graph-split 7    # RC2-final (7): P_GRAPH_SPLIT=1 in beiden Formaten (FA2-KV-Split im Prefill-Graphen)
)

# P-Trim: der Arm-Schalter P_TRIM (seit arm_xsn437.sh) haengt das Launcher-Flag --p-trim-end-anchor an; der
# Launcher setzt daraufhin SGLANG_WEG2_P_TRIM_END_ANCHOR=1 NUR in der Umgebung von Gruppe P
# (launcher.py: p_trim_end_anchor_env; Modul weg2/p_trim_end_anchor.py, Commit 67b6352361): P nimmt Leg-1-Prompts
# als N-1 und spart den 1-Token-END-ANCHOR-Forward. NICHT als globales Env setzen (sonst erben es D und die Front).
# RC1 fuhr AUS (arm_rc1.sh: P_TRIM=${P_TRIM:-0}); RC2 faehrt AN (arm_rc2.sh Z.718: P_TRIM=${P_TRIM:-1}, "Form im Arm").
PROFILE_P_TRIM_BEST=1
PROFILE_P_TRIM=${HTSGLANG_P_TRIM:-$PROFILE_P_TRIM_BEST}
case "$PROFILE_P_TRIM" in
  0) ;;
  1) PROFILE_ARGS+=(--p-trim-end-anchor) ;;
  *) echo "profiles/27b.env: HTSGLANG_P_TRIM='$PROFILE_P_TRIM' (0|1)" >&2; exit 3 ;;
esac
if [ "$PROFILE_P_TRIM" != "$PROFILE_P_TRIM_BEST" ]; then
  echo "[profiles/27b] FORM-OVERRIDE HTSGLANG_P_TRIM=$PROFILE_P_TRIM (Bestform $PROFILE_P_TRIM_BEST) -- per docker run -e gesetzt" >&2
fi

# RC2: Idle-Politik (Baum 95049973e0 via f6900cf735; arm_rc2.sh Z.722-723, dort nach dem P-Trim angehaengt).
# Nutzer-Form: kurz auf D bleiben (d-hold), dann nach P flippen und dort warten (idle-layout pp); eine reine
# SHORT-Warteschlange bis 4096 Tokens bedient D ohne Flip. Die Front-Zeile WEG2-IDLE-POLICY belegt die Werte.
PROFILE_ARGS+=(
  --idle-layout pp             # (a) in Ruhe wacht Gruppe P (Launcher-Default tp = D)
  --d-hold-s 10                # (c) D bleibt 10 s nach eigener Arbeit wach, bevor der Idle-Flip kommt
  --d-short-drain-tokens 4096  # (b) Rueckstau nur aus SHORT-Requests (je <= X=4096) bis 4096 Tokens bedient D ohne Flip
)

# FORM-Variablen (Verhalten). ${X:-Bestform}: ein explizites `docker run -e X=...` gewinnt,
# der Entrypoint meldet jede Abweichung von der Bestform laut (FORM-OVERRIDE).
profile_form_env() {
  _form SGLANG_HICACHE_ARENA_PREPIN 1
  _form SGLANG_HICACHE_ARENA_MAMBA_SLOTS 112
  _form SGLANG_WEG2_MAMBA_INNER_ANCHOR_RELEASE 1
  _form SGLANG_HICACHE_DRAIN_AGREE_EVERY 8
  _form SGLANG_HICACHE_LOAD_ASYNC_INDEX 1
  _form SGLANG_DFLASH_WINDOW_POOL_SYNC_FREE 1
  _form SGLANG_BARLINK_BAR1_ABORT_MAX_LAG 64
  _form SGLANG_WEG2_MAMBA_ANCHOR_INTERVAL 4096
  _form SGLANG_WEG2_MAMBA_MAX_STATES_PER_PATH 4
  _form SGLANG_DFLASH_PLAN_SYNC_FREE 1
  _form SGLANG_VRAM_PEAK_FAST_READ 1
  _form SGLANG_WEG2_DENSE_REPACK_OUTSIDE_POOL 1
  _form SGLANG_WEG2_D_DEFER_SEQ_LENS_CPU 1
  _form SGLANG_HICACHE_DRAIN_BUDGET 16384
  _form SGLANG_WEG2_D_DEFER_REBUILD 1
  _form SGLANG_DFLASH_VERIFY_VOCAB_ARGMAX 1
  _form SGLANG_DCP_LSE_MERGE a2a
  _form SGLANG_HICACHE_ARENA_QUEUE_REFS 1
  _form SGLANG_WEG2_SEQ_SYNC_BATCH_MIB 256
  _form SGLANG_WEG2_SEQ_SYNC_BATCH_UNITS 128
  _form SGLANG_ADMISSION_WEDGE_RECOVERY_SECONDS 2
  _form SGLANG_HICACHE_ARENA_LOAD_BLOCK_QUOTA 16
  # NCCL-Puffer je Communicator (xsn300 A/B, Task #16): gilt unter BEIDEN Transporten --
  # auch unter bar1 entstehen NCCL-Communicatoren (Residuum ausserhalb torch D 1,5-1,8 GB).
  _form NCCL_BUFFSIZE 1048576
  _form NCCL_MAX_NCHANNELS 8
  # --- RC2: fuenf Schalter (arm_rc2.sh Z.725-727) ---
  # Front (front.py:1905-1945, flipfast 502e97ef3c, alle Default aus):
  _form SGLANG_WEG2_CTL_KICK_ARRIVAL 1       # F2: Controller-Kick bei Ankunft statt auf den naechsten Takt warten
  _form SGLANG_WEG2_CTL_KICK_AFTER_FLIP 1    # F3: Controller-Kick direkt nach dem Flip
  _form SGLANG_WEG2_DC_OFF_PATH 1            # F1: Rest-Lesung nach dem Wake (DC) aus dem Flip-Pfad genommen
  # Front (front.py:495-505, ed6630d6c2, Default aus): ein Bild-Request, den nur P bedienen kann, wartet nicht
  # auf Text, den er nie erreicht (zaehlt als dringend fuer die Flip-Oekonomie).
  _form SGLANG_WEG2_VISION_FLIP_URGENT 1
  # Gruppen P/D (scheduler.py:670-690, 3453cc7766, Default AN -> hier nur ausdruecklich): ein kurzer Store-Read
  # liest seinen Rest unter der Schwelle nach; ein Stillstand innerhalb X rechnet neu statt W88-503.
  _form SGLANG_WEG2_STORE_SHORT_TAIL 1
}

# INSTRUMENTE (nur Logs/Dateien). F8: im Release AUS; HTSGLANG_INSTRUMENTS=1 schaltet sie zu (Paritaet mit den
# Rig-Referenzboots, Host-Abnahme). Ziele liegen unter dem Evidenz-Verzeichnis des Containers (Stufe B).
profile_instr_env() {
  _form SGLANG_HICACHE_ROUND_TIMING 512
  _form SGLANG_WEG2_D_HOSTGAP 512
  _form SGLANG_HICACHE_ARENA_REF_CENSUS_S 60
  _form SGLANG_DFLASH_PHASE_TIMING "${SGLANG_WEG2_EVIDENCE_DIR:-/var/lib/htsglang/evidence}/dflash_phase_${HTSGLANG_TAG}"
  _form SGLANG_DEBUG_DFLASH_SYNC_TRACE 20
}
