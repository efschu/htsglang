# shellcheck shell=bash
# Profil nf -- Qwen3.8-Flash-Next INT4 + MTP-Draft (NF-Linie), weg2-Flip P=PP3 / D=Form A TP3.
# HERKUNFT: ARB/weg2/boot_nf_bestform_0924.sh + ARB/weg2/arm_fnFL2_long.sh Z.321, Referenzboot fnFL2x163 (Baum ce1dac1984).
# RIG-GEBUNDEN wie 27b: 1x RTX 5090 + 2x RTX 3080, 118-GiB-LXC, gepatchter Treiber (NF_PROFILE.md §5.2, §10 OP-17).
PROFILE_NAME=nf
PROFILE_LINE=nf
PROFILE_MODEL=/spinning/llm_stuff/club-3090/models-cache/Qwen3.8-Flash-Next-INT4-Mixed-AutoRound-Minachist
# NF HAT einen externen Draft (MTP INT4 g32), geladen nur von Gruppe D (P bootet ohne Draft, H25).
# Achtung: die .safetensors darin sind ABSOLUTE Symlinks nach .../albucino-mtp-int4-g32/runtime/mtp-int4-g32/ (NF_PROFILE.md §1.1).
PROFILE_DRAFT=/spinning/llm_stuff/club-3090/models-cache/Qwen3.8-Flash-Next-MTP-INT4-g32-albucino
PROFILE_CENSUS=/opt/htsglang/profiles/nf/xchg_census_fnFL2_graph.json            # Quelle ARB/weg2/census/xchg_census_fnFL2_graph.json
PROFILE_CORRIDOR=/opt/htsglang/profiles/nf/corridor_budget_sample_nextflash_0921.json  # Quelle ARB/weg2/
PROFILE_GPUS="NVIDIA GeForce RTX 5090=1;NVIDIA GeForce RTX 3080=2"
PROFILE_SHM_MIN_GIB=16          # gemessen <= 8,7 GiB (ramcensus x166) -- Arena 4 GiB + Mamba 1,9 + SEQ-Lanes + NCCL + Luft
PROFILE_MEMAVAIL_MIN_GIB=100    # Launcher selbst: 40 (launcher.py:2869). NF-Messung: nonreclaim-Spitze 85,1 GiB + Seitencache,
                                # x163 startete bei 110 GiB verfuegbar. EMPFEHLUNG, nicht gemessen als Untergrenze.
PROFILE_TMPFS_STORE=/mnt/nf-experts   # MUSS tmpfs sein (cudaHostRegister auf ZFS-mmap -> cudaError 1); Pruefung wie Arm Z.341
PROFILE_TMPFS_GIB=72                  # Belegung 39 912 MiB in x162/x163/x165/x166

# Gruppen-Env (P und D verschieden -> nur ueber --env-p/--env-d, nicht global exportierbar).
NF_ENV_P_FORM="SGLANG_MOE_SCRATCH_SLOTS=32;SGLANG_MOE_RESIDENT_EXPERT_FRACTION=0.36,0.64,0.39;SGLANG_UNEVEN_MOE_EXPERT_SHARD=1;SGLANG_WEIGHT_LOADER_PREAD=0;SGLANG_LOAD_KEY_WORKERS=4;SGLANG_MOE_OFFLOAD_WAVE_ORDER=expert;SGLANG_QWEN4_PLE_CKPT_GATHER=pread;SGLANG_MOE_EXPERT_STORE_DIR=/mnt/nf-experts/fnFL2;SGLANG_WEG2_ENABLE_P_UNDIVIDED_MICRO_BATCH=1;SGLANG_WEG2_ENABLE_P_MULTI_ANCHOR_TAILS=1;SGLANG_WEG2_P_BURST_ASSEMBLY_MS=300;SGLANG_WEG2_REARM_PREFETCH=0;SGLANG_MOE_OFFLOAD_PLAN_VECTOR=1;SGLANG_NAN_GUARD_WAVE=0;SGLANG_NAN_GUARD_FETCH=0;SGLANG_OPT_HICACHE_DEVICE_INDEX_WRITE=0;SGLANG_WEG2_SEQ_BUFFER_DEPTH=2;SGLANG_HICACHE_ARENA_GIB=4;SGLANG_HICACHE_ARENA_KV_PAGE_BYTES=786432;SGLANG_HICACHE_ARENA_MAMBA_SLOTS=32"
NF_ENV_P_INSTR="SGLANG_WEG2_SLEEP_HEAP_CENSUS=0;SGLANG_MOE_OFFLOAD_TIMING=1;SGLANG_QSA_SIDECAR_TRACE=4"
NF_ENV_D_FORM="SGLANG_MOE_SCRATCH_SLOTS=118,48,48;SGLANG_MOE_RESIDENT_EXPERT_FRACTION=0.06,0.51,0.48;SGLANG_UNEVEN_MOE_EXPERT_SHARD=1;SGLANG_WEIGHT_LOADER_PREAD=0;SGLANG_LOAD_KEY_WORKERS=4;SGLANG_MOE_OFFLOAD_GRAPH_MODE=pool;SGLANG_MOE_EXPERT_STORE_DIR=/mnt/nf-experts/fnFL2;SGLANG_WEG2_TAIL_SKIP_EXTEND=1;SGLANG_WEG2_REARM_PREFETCH=0;SGLANG_QSA_MTP_INDEX_SHARE=0;SGLANG_WEG2_SEQ_BUFFER_DEPTH=2;SGLANG_HICACHE_ARENA_GIB=4;SGLANG_HICACHE_ARENA_KV_PAGE_BYTES=786432;SGLANG_HICACHE_ARENA_MAMBA_SLOTS=32"
NF_ENV_D_INSTR="SGLANG_WEG2_SLEEP_HEAP_CENSUS=0;SGLANG_DEBUG_DECODE_PLE_WAIT=1;SGLANG_DEBUG_HOST_ANON_PROBE=1;SGLANG_SPEC_STAGE_SYNC=8;SGLANG_GRAPH_REPLAY_CENSUS=8;SGLANG_BARLINK_EAGER_TRACE=6000;SGLANG_QSA_SIDECAR_TRACE=4"
if [ "${HTSGLANG_INSTRUMENTS:-1}" = "1" ]; then
  NF_ENV_P="$NF_ENV_P_FORM;$NF_ENV_P_INSTR"; NF_ENV_D="$NF_ENV_D_FORM;$NF_ENV_D_INSTR"
else
  NF_ENV_P="$NF_ENV_P_FORM"; NF_ENV_D="$NF_ENV_D_FORM"
fi

# Launcher-Argumente (ohne --tree/--tag/--transport; die setzt der Entrypoint). Wirksame Werte der Bestform.
PROFILE_ARGS=(
  --corridor-budget-sample "$PROFILE_CORRIDOR"
  --profile nextflash --model "$PROFILE_MODEL"
  --flip-weights family --weg2-weight-source exchange --weg2-xchg-inject authoritative
  --xchg-bounce-depth 1 --weg2-weights-cpu-backup off --weight-chunks 16
  --weg2-xchg-census "$PROFILE_CENSUS"
  --env-p "$NF_ENV_P" --env-d "$NF_ENV_D"
  --d-foreign-context-mib 1446,896,894 --d-nontorch-mib 1981,528,524
  --d-tp-objective maxkv --draft-kv-on-p off --weg2-vision off --pp-solve-pool-floor 0
  --pp-stage-ratio 29,11,8 --pp-attn-stage-ratio 7,3,2
  --pp-cut-expert-device-fraction 0.36,0.64,0.39 --pp-cut-expert-lru-rows 32,32,32
  --user-reserve-mib 0,0,0 --store-max-gb 150 --max-kv-per-request 262144
  --p-bs 4 --d-bs 1
  --extra-p '--max-total-tokens 262144 --json-model-override-args "{\"language_model_only\":true}" --kv-cache-dtype fp8_e4m3 --page-size 64 --max-running-requests 4 --mamba-ssm-dtype bfloat16 --ple-offload-embedding --ple-offload-backend checkpoint --hicache-mamba-host-mib 300 --hicache-size 2 --speculative-draft-model-path '"$PROFILE_DRAFT"' --rank-moe-resident-fraction 0.36,0.64,0.39 --rank-user-reserve-mib 0,0,0 --disable-cuda-graph --context-length 262144 --max-kv-per-request 262144'
  --extra-d '--max-total-tokens 262144 --json-model-override-args "{\"language_model_only\":true}" --kv-cache-dtype fp8_e4m3 --page-size 64 --max-running-requests 1 --mamba-ssm-dtype bfloat16 --ple-offload-embedding --ple-offload-backend checkpoint --hicache-mamba-host-mib 300 --rank-role host,worker,worker --rank-tp-ratio 1,0,0 --rank-moe-ratio 183,137,168 --rank-moe-resident-fraction 0.06,0.51,0.48 --rank-user-reserve-mib 0,0,0 --speculative-draft-placement solo --speculative-algorithm NEXTN --speculative-num-steps 3 --speculative-eagle-topk 1 --speculative-num-draft-tokens 4 --speculative-draft-model-path '"$PROFILE_DRAFT"' --cuda-graph-bs-decode 1 --cuda-graph-backend-decode=full --cuda-graph-backend-prefill=disabled --hicache-size 4 --hicache-mamba-host-mib 300 --context-length 262144 --max-kv-per-request 262144'
)

# --extra-p/-d: Quotierung WIE Arm Z.208/256 -- der Launcher zerlegt die Zeichenkette mit shlex.split,
# das JSON muss darin doppelt gequotet stehen, sonst kommt {language_model_only:true} (kein JSON) an.
# FORM (global exportiert, erbt der Launcher an beide Gruppen und die Front; Arm Z.64/92/201-206, Vorlage Z.37-42/61).
profile_form_env() {
  _form SGLANG_WEG2_WAKE_DEFER_BELOW_MIB 0
  _form SGLANG_MOE_EXPERT_STORE_SLOT_FRACTION 0.82
  _form SGLANG_MOE_COLD_TIER_SHM 1
  _form SGLANG_MOE_COLD_TIER_INSTANCE "${HTSGLANG_TAG}"        # Arm: <TAG><HHMMSS>; eine Instanz fuer beide Gruppen
  _form MALLOC_ARENA_MAX 2
  _form SGLANG_MOE_OFFLOAD_EXCLUDE_DRAFT 1
  _form SGLANG_MOE_OFFLOAD_WAVE_SLICE 40960
  _form SGLANG_NAN_GUARD 1
  _form SGLANG_HC_MIXER_INT8 1
  _form SGLANG_MOE_MARLIN_ATOMIC_ADD 0
  _form SGLANG_MOE_POOL_STAGING 8
  _form SGLANG_QWEN4_PLE_FILE_SKIP_DEVICE_CHECK 1
  _form SGLANG_HICACHE_ARENA_MAMBA_SLOTS 32
  _form SGLANG_HICACHE_ARENA_KV_PAGE_BYTES 786432
  _form SGLANG_WEG2_DRAFT_ON_P 0
  _form SGLANG_WEG2_P_CHUNKED_PREFILL_TOKENS 16384
  _form SGLANG_WEG2_ENABLE_P_UNDIVIDED_MICRO_BATCH 1
  _form SGLANG_WEG2_ENABLE_P_MULTI_ANCHOR_TAILS 1
  _form SGLANG_WEG2_P_BURST_ASSEMBLY_MS 300
  _form SGLANG_WEG2_P_QUEUE_AHEAD 4                          # liest die FRONT (front.py:5848)
}
# INSTRUMENTE (global; die gruppenweisen stecken in NF_ENV_*_INSTR oben).
profile_instr_env() {
  _form SGLANG_LOAD_PROFILE 1
}

# --- Release-Stand (Nachtrag 27B-Sitz R, 25.09. ~05:40Z; der Inhalt oben ist NF_PROFILE.md §11.1 woertlich) -------------
# Diese Datei traegt noch die x163-Bestform. Abgenommen ist INT4-Mixed x177 (Operator/Nutzer 25.09.); die
# x177-Nachfuehrung liefert der NF-Sitz nach /spinning/gpu-arb/docker/ (Arm: weg2/boot_nf_bestform_0925_x177.sh). Bis sie
# eingespielt ist, verweigert der Entrypoint dieses Profil; danach PROFILE_STATUS=abgenommen und
# `prepare_context.sh --refresh-tools ctx/nf-d93a17316b`. Hinweis fuer die Lieferung: die x177-Form nennt
# --wake-credit-reference-logs mit drei Rig-Logs von fnFL2x162 -- im Image liegen sie unter /opt/htsglang/profiles/nf/
# (profiles/nf.assets), die Pfade im Profil muessen dorthin zeigen.
PROFILE_STATUS=vorbereitet
PROFILE_OWNER="NF-Sitz: x177-Nachfuehrung ausstehend (abgenommen ist INT4-Mixed x177, diese Datei traegt noch x163)"
