# shellcheck shell=bash
# Profil 27b-gguf -- unsloth Qwen3.8-27B-UD-IQ4_XS.gguf + DFlash2-W8-Draft (safetensors), weg2-Flip, RC5.
#
# STAND: VORBEREITET (PROFILE_PLACEHOLDER=1, der Entrypoint verweigert es mit diesem Stand), bis der RC5-GGUF-Boot
# (arm_rc5.sh FORMAT=gguf, TAG weg2rc5gg, seit 05:18Z) durch ist und der Operator freigibt. Dann PROFILE_PLACEHOLDER=0,
# PROFILE_STATUS=abgenommen und `prepare_context.sh --refresh-tools <ctx>`. (RC4-GGUF starb an PP2 "... is not a file";
# RC5 traegt dafuer Ss Draft-Ladeformat-Resolver 1f8c24d338. Das Argv bleibt gleich: arm_rc5.sh == arm_rc4.sh.)
#
# QUELLE (25.09.): Ss /spinning/gpu-arb/weg2/arm_rc4.sh, FORMAT=gguf (Baum desk/27b-release-rc4-0925 @ 9738626129;
# GGUF G1/G2/G6 von K und S, G3-Instrument von K). Gleiche 34 Env-Variablen wie INT8/FP8; Argumente = INT8-Form von
# 27b.env mit diesen Aenderungen:
#   --model <...UD-IQ4_XS.gguf> --tokenizer-path <INT8-Verzeichnis>   (der unsloth-Ordner hat keinen Tokenizer, sonst W163;
#                                                          --tokenizer-path ist neu in RC4, G2, gilt fuer beide Gruppen)
#   --weg2-xchg-census-foreign                          (INT8-Census, bis ein GGUF-Boot seinen eigenen misst)
#   --weg2-vision off                                   (G4: kein mmproj; statt transient)
#   --pp-stage-ratio 42,11,11 --pp-attn-stage-ratio 10,3,3   (P-Schnitt GEPINNT, wie nvfp4)
#   KEIN --p-prefill-graph 512 und KEIN --p-prefill-graph-split 7 (G5: P laeuft eager, P_GRAPH=0; der Graph lief nie mit
#     GGUF, der Dequant-Workspace wird zur Laufzeit getauscht; Split/Tiny gibt es nur mit dem Graphen)
#   --extra-p="--max-running-requests=2 --speculative-draft-load-format auto" und
#   --extra-d="--speculative-draft-load-format auto"    (der Draft erbte sonst load_format gguf und stuerbe am
#                                                          Verzeichnis, TICKET_470; das letzte --extra-p gewinnt)
# Instrument (F8, nur mit HTSGLANG_INSTRUMENTS=1): SGLANG_GGUF_PATH_CENSUS=1 (#GGUFPATH, Ks G3, Fenster je 512 D-Runden).
# Nur fuer die Sonden des Arms: RETRACT_TOKENIZER, VISION_PROBE=0, PROBE_TEMPO=3, PARK_N=4.
#
# /dev/shm und MemAvailable: aus 27b.env, fuer GGUF NICHT gemessen -- aus shmfiles_/hostram_weg2rc4gg nachziehen.

# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/27b.env"

PROFILE_NAME=27b-gguf
PROFILE_FORMAT=gguf
PROFILE_MODEL=/spinning/llm_stuff/club-3090/models-cache/Qwen3.8-27B-GGUF-unsloth/Qwen3.8-27B-UD-IQ4_XS.gguf
PROFILE_TOKENIZER=/spinning/llm_stuff/club-3090/models-cache/Qwen3.8-27B-INT8-gdncov-vocabembed
PROFILE_REQUIRED_PATHS=("$PROFILE_TOKENIZER")   # prueft der Entrypoint zusaetzlich zu Modell und Draft
PROFILE_FORM=rc5                # gegen arm_rc4.sh und arm_rc5.sh (FORMAT=gguf) gegatet
PROFILE_STATUS=vorbereitet
PROFILE_PLACEHOLDER=1
PROFILE_OWNER="vorbereitet: Form = arm_rc5.sh FORMAT=gguf @ 5f13f1aad9; wartet auf den RC5-GGUF-Boot (weg2rc5gg) und die Freigabe des Operators"

_fmt_args=(--model "$PROFILE_MODEL" --tokenizer-path "$PROFILE_TOKENIZER")
for ((_i = 0; _i < ${#PROFILE_ARGS[@]}; _i++)); do
  case "${PROFILE_ARGS[_i]}" in
    --weg2-xchg-census) _fmt_args+=(--weg2-xchg-census "${PROFILE_ARGS[_i + 1]}" --weg2-xchg-census-foreign); _i=$((_i + 1)) ;;
    --weg2-vision) _fmt_args+=(--weg2-vision off); _i=$((_i + 1)) ;;
    --p-prefill-graph|--p-prefill-graph-split) _i=$((_i + 1)) ;;   # G5: P eager, Split nur mit dem Graphen
    *) _fmt_args+=("${PROFILE_ARGS[_i]}") ;;
  esac
done
PROFILE_ARGS=("${_fmt_args[@]}" --pp-stage-ratio 42,11,11 --pp-attn-stage-ratio 10,3,3
              "--extra-p=--max-running-requests=2 --speculative-draft-load-format auto"
              "--extra-d=--speculative-draft-load-format auto")
unset _fmt_args _i

# Instrumente: die von 27b.env plus der G3-Pfad-Zensus.
eval "$(declare -f profile_instr_env | sed '1s/^profile_instr_env/_profile_instr_env_27b/')"
profile_instr_env() {
  _profile_instr_env_27b
  _form SGLANG_GGUF_PATH_CENSUS 1
}
