# shellcheck shell=bash
# Profil nf-nvfp4 -- PLATZHALTER (Schnittstelle wie profiles/27b.env). ENTWURF 27B-Sitz R, 24.09.2026.
# Eigentuemer der Form: NF-Sitz (baut die NVFP4-Basis). Bis die Form geliefert UND am Rig gebootet ist, verweigert der
# Entrypoint dieses Profil (PROFILE_PLACEHOLDER=1).
#
# Modellformat: nvfp4-modelopt (Erkennung im Entrypoint: quant_method modelopt + hf_quant_config.json).
# Kernel-/JIT-Pfade je Arch: sm_120: CUTLASS-FP4 / FlashInfer fp4-Module; sm_86: Marlin-FP4; MoE-Experten-Pfad des NF (Offload/Store) je Format
# Modell am Rig: 124 GB, modelopt MIXED_PRECISION (float4 + float8 x2), nvidia.
#
# Zu liefern: PROFILE_ARGS (Argumentzeile des Bestform-Arms dieses Formats, woertlich),
# profile_form_env()/profile_instr_env(), PROFILE_SHM_MIN_GIB, PROFILE_MEMAVAIL_MIN_GIB,
# ggf. PROFILE_DRAFT/PROFILE_CENSUS/PROFILE_TMPFS_*; danach den Rig-JIT-Cache dieses Formats in
# den Build-Kontext uebernehmen (prepare_context.sh liest ~/.cache/flashinfer und ~/.cache/tvm-ffi).
PROFILE_NAME=nf-nvfp4
PROFILE_LINE=nf
PROFILE_FORMAT=nvfp4-modelopt
PROFILE_MODEL="/spinning/llm_stuff/club-3090/models-cache/Qwen3.8-Flash-Next-NVFP4-nvidia"
PROFILE_GPUS="NVIDIA GeForce RTX 5090=1;NVIDIA GeForce RTX 3080=2"
PROFILE_NCCL_STATUS=unproven
PROFILE_PLACEHOLDER=0
PROFILE_STATUS=experimentell    # Operator/Nutzer 25.09.: nf-nvfp4 = experimentell (laeuft nur mit HTSGLANG_ALLOW_EXPERIMENTAL=1)
PROFILE_OWNER="NF-Sitz: NVFP4 experimentell; Form (PROFILE_ARGS) liefert NF -- bis dahin verweigert der Entrypoint mangels Argumenten"
PROFILE_ARGS=()
profile_form_env() { :; }
profile_instr_env() { :; }
