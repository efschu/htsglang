# shellcheck shell=bash
# Profil nf-h91, FORM h91bb4 (H91-Standardform) -- Qwen3.8-Flash-Next INT4 + MTP-Draft, weg2-Flip P=PP3 / D=Form A TP3.
# NEUE Datei (26.09.2026, Auftrag "Docker-Profil fuer die NF-Abnahme in der H91-Form"). Vorlage profiles/nf.env (Form x177)
# wurde nur gelesen und bleibt unveraendert; alles, was hier NICHT als "H91:" markiert ist, ist wortgleich nf.env.
# Nutzer-Order: erste Docker-Abnahme nur NF-INT4, Abnahmeform = H91-Standardform (P staut bis 6 Sitze, D dynamisch 1..6,
# Juengster parkt, Wartegrenze 60 s).
#
# HERKUNFT DER H91-WERTE (die Form steht im ARM, nie im Starter-Env; nur gelesen):
#   Arm      ARB/weg2/boot_nf_h91bb3.sh (zuletzt am Metall) = boot_nf_h91bb4.sh bis auf zwei bb4-Schalter (unten NF_ENV_BB4_FORM)
#            -> boot_nf_h91bb3_start.sh -> ARB/weg2/arm_fnFL2_h91.sh Z.209 (EXTRA_P) / Z.257 (EXTRA_D) / Z.322 (LARGS)
#   Metall   fnFL2h91bb3, Bootbaum 50cd2884ac, 26.09. 15:38Z, Launcher-Log EVID/fnFL2h91bb3_50cd2884ace4_0926_153822.log:
#            group P argv Z.178, D-SITZE Z.198, WEG2-GROUP-ENV P Z.234 / D Z.235, group D argv Z.236, front argv Z.249.
#            bb3 starb am Sleep-Drain des zweiten D-Schlafbeins (W120 -> W29); Fix H91e f1bbba2fa4 steht im Zielbaum.
#   Baum     vereinigter Baum desk/27b-unified-0926 @ 2a7f992c14 (H91b/c/c2/c3, H91d, H95 A/B/c/d/e, H91e, H92, H92d, R12),
#            Image htsglang:cu130-weg2-rc11b-27b-nf (ctx delta-rc11b-27b2a7f992c14-from-rc11a).
#
# STANDARDFORM (Registry, nicht dieses Profil): form.py nextflash standard_form=True -> SGLANG_WEG2_STANDARD_FORM,
#   SGLANG_WEG2_D_PARK, SGLANG_WEG2_ENABLE_D_PARK_DRAFT_KV an; launcher.apply_profile_d_bs_default setzt --d-bs 6 (Obergrenze,
#   n = 1..6 je Phase aus handoff_n) NUR, wenn --d-bs NICHT gesagt ist; dazu --env-d SGLANG_OPT_MOE_POOL_OVERFLOW_WAVES=2 (H95)
#   und SGLANG_OPT_WEG2_D_SEAT_VRAM=1 (H95c), NUR wenn --env-d sie nicht nennt. Darum steht hier BEWUSST:
#   kein --d-bs, kein SGLANG_WEG2_D_PARK, kein SGLANG_WEG2_STANDARD_FORM (Master-Schalter; 0 = x177-Form), keine
#   OVERFLOW_WAVES/D_SEAT_VRAM in --env-d. Front: --p-phase-max-requests 6 / --p-pool-tokens 262144 / --d-wait-bound-s 60
#   sind main()-Defaults unter standard_form (phase_policy.resolve_front_defaults). agent_span bleibt aus (Registry NF off).
#
# GEGEN nf.env (x177) GEAENDERT -- jede Zeile traegt "H91:":
#   FR_P 0.332,0.64,0.39 -> 0.324,0.637,0.39 (bb3 Arm Z.77; -4 Zeilen PP0 fuer +8 Mamba-Slots)
#   SCRATCH_D 118,48,48 -> 100,48,48 (bb3 Arm Z.65; H95-Tabelle: 118 auf TP0 verweigert W130 ab n=4)
#   --p-bs 4 -> 6, P --max-running-requests 4 -> 6, P +--max-mamba-cache-size 32 (bb3 Arm Z.84; retention_budget 32-6x4 = 8)
#   --d-bs 1 GESTRICHEN (Standardform: 6 dyn.), D --max-running-requests 1 -> 6, --cuda-graph-bs-decode 1 -> 1 2 3 4 5 6
#   (bb3 Arm Z.53 EXTRA_D_SET; ohne das meldet der Launcher 'D-SITZE (H91b) BEFUND' -- Front und D zaehlten verschiedene Sitze)
#   Env global (Front + P + D, wie bb3 Launcher-Env Arm Z.93): SGLANG_WEG2_QUIESCE_FAST=1, SGLANG_WEG2_DEPOSIT_LANE_LOOKAHEAD=1,
#   SGLANG_WEG2_MIN_DWELL_EXCLUDE_DRAIN=1, SGLANG_WEG2_CENSUS_O1_EVICT=1 (alle vier Code-Default AUS im Zielbaum);
#   SGLANG_HICACHE_ARENA_QUEUE_REFS=1 auf P und D unveraendert ueber NF_ENV_RC2_FORM (bb3 Arm Z.118, = nf.env).
#   D-Instrument +SGLANG_DEBUG_MOE_POOL_DEMAND=64 (bb3 Arm Z.115, MOE-POOL-DEMAND-Sonde alle 64 Replays; nur bei Instrumenten).
#
# BEWUSST NICHT UEBERNOMMEN (bb3-Arm-Werte ohne Rolle im Container):
#   native Pfade: WT/H91BB3_HEAD/H91BB3_WT, --tree, --evidence-dir, EVID=/spinning/evidence-665-f1 (Entrypoint/Stufe B setzt sie),
#     --weg2-xchg-census/--corridor-budget-sample/--wake-credit-reference-logs als ARB-Pfade (hier die Image-Assets
#     /opt/htsglang/profiles/nf/, dieselben Dateien), CUDA_COREDUMP_FILE=/spinning/evidence-665-f1/... (hier profile_instr_env).
#   devindex: systemctl stop/start devindex-watch/-refresh (DEVINDEX-PAUSE/-RESUME) -- macht das Abnahmeskript per pct (TEN).
#   Arm-Hilfen: boot_loggers_start/stop, store_teardown (bb4), GPUQ_KEEP_WINDOW, DRY_ONLY/H91BB4_DRY_LAUNCHER_EXTRA,
#     EXTRA_PROBE_CMD (xprefix/h91_probe/chunked_abort/resume_series/decode_matrix) + H91BB_T_* + AGENT_HOLD_S +
#     EXTRA_PROBE_TIMEOUT_S, BURST_PROBE/BURST_N/BURST_MIN/BURST_MAX, CONTROL_SHORT/CONTROL_MID_REPEAT, DECODE_PROBE(_KINDS),
#     NEEDLE_N_*/NEEDLE_POS_* (Proben macht nf_short_probes_rc10u.py), CUDA_ENABLE_USER_TRIGGERED_COREDUMP (NF_PROFILE OP-13).
#   SGLANG_WEG2_BAR1_CONNECT_S=480: setzt das Abnahmeskript per CONTAINER_ENV (CONNECT_S=auto bei warmem JIT-Volume),
#     sonst der Entrypoint 900 beim Kaltstart.
#   Starter-Rueckfaelle FR_P=0.26,.. / FR_D=0.06,0.44,0.365 / ENV_D_EXTRA-Default (SPEC_EAGER_VERIFY): greifen im bb3-Lauf
#     nicht (der Arm setzt FR_P/FR_D/ENV_D_EXTRA vorher), gehoeren nicht zur Form.
#   SGLANG_FLA_L2NORM_RUNTIME_T=1: setzt der Launcher selbst fuer beide Gruppen (launcher.py build_env, H103).
#
# RIG-GEBUNDEN wie nf.env: 1x RTX 5090 + 2x RTX 3080, smallbar-Treiber 595.58.03 (NF_PROFILE.md §5.2).

PROFILE_NAME=nf-h91
PROFILE_LINE=nf
PROFILE_FORM=h91bb4            # H91: Form des Arms boot_nf_h91bb4.sh (= bb3-Form; die zwei bb4-Schalter per NF_ENV_BB4_FORM, Default aus)
PROFILE_STATUS=experimentell   # H91: bis die Docker-Abnahme gruen ist (Entrypoint verlangt HTSGLANG_ALLOW_EXPERIMENTAL=1)
PROFILE_PLACEHOLDER=0
PROFILE_OWNER="NF-Sitz (Form H91-Standard = ARB/weg2/boot_nf_h91bb3.sh/bb4.sh, Metall fnFL2h91bb3 50cd2884ac; Zielbaum 2a7f992c14 rc11b)"
PROFILE_FORMAT=int4-mixed     # Formerkennung des Entrypoints fuer Minachist (compressed-tensors, int4 + weitere Gruppen)
PROFILE_NCCL_STATUS=unproven   # NF nie mit --transport nccl gebootet; H91-Form nie unter nccl
PROFILE_MODEL=/spinning/llm_stuff/club-3090/models-cache/Qwen3.8-Flash-Next-INT4-Mixed-AutoRound-Minachist-abl-wxp   # abl: Nutzer 03.10. NF-Standard = abliteriert (Vorbild profiles/nf-int4-h6-abl.env), Item 380
PROFILE_DRAFT=/spinning/llm_stuff/club-3090/models-cache/Qwen3.8-Flash-Next-MTP-INT4-g32-albucino-abl-wxp   # abl (Item 380)
PROFILE_CENSUS=/opt/htsglang/profiles/nf/xchg_census_fnFL2_graph.json                 # bb3 liest dieselbe (Arm LAUNCHER_EXTRA)
PROFILE_CORRIDOR=/opt/htsglang/profiles/nf/corridor_budget_sample_nextflash_0921.json  # bb3: Arm-Default derselben Datei
PROFILE_WAKE_REF_DIR=/opt/htsglang/profiles/nf
PROFILE_WAKE_REF="$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.P.log,$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.D.log,$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.front.log"
PROFILE_REQUIRED_PATHS=(
  "$PROFILE_DRAFT/mtp-dense.safetensors"
  "$PROFILE_DRAFT/mtp-routed-experts-int4.safetensors"
  "$PROFILE_CENSUS"
  "$PROFILE_CORRIDOR"
  "$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.P.log"
  "$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.D.log"
  "$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.front.log"
)
PROFILE_GPUS="NVIDIA GeForce RTX 5090=1;NVIDIA GeForce RTX 3080=2"
# HW-GENERIC 1002: Preflight-Gate aus NVML-Eigenschaften (weg2/card_identity.py: Arch sm_86/sm_120, Kartenzahl,
# Kartenreihenfolge). PROFILE_GPUS oben bleibt fuer Baeume ohne card_identity.py (Namens-Gate wie bisher).
PROFILE_CARD_COUNT=3
# The inventory the profile's positional vectors were measured on (card_identity.CALIBRATED_CLASSES labels,
# in card order: biggest NVML total first). Another inventory -> REFUSED UNCALIBRATED (HW-UNCALIBRATED).
PROFILE_INVENTORY="RTX5090,RTX3080,RTX3080"
PROFILE_SHM_MIN_GIB=16          # x177 8597 MiB; bb3 tmpfs_shm max 8466 MiB (ramcensus_fnFL2h91bb3.csv 15:49:21Z) -- unveraendert
PROFILE_MEMAVAIL_MIN_GIB=88     # H91-Form nativ ungemessen, bb3 nonreclaim-Spitze 88,1 GiB; T nach dem ersten Docker-Boot neu herleiten
PROFILE_TMPFS_STORE=/mnt/nf-experts   # MUSS tmpfs sein (cudaHostRegister auf ZFS-mmap -> cudaError 1)
PROFILE_TMPFS_GIB=72                  # Store fnFL2: bb3 tmpfs_experts max 40144 MiB, Geometrie 183,137,168|0.06,0.51,0.48 wie x177

# FORM-ZAHLEN, die an MEHREREN Stellen stehen muessen (FR_P steht an DREI Stellen: Env, --pp-cut-expert-device-fraction,
# --extra-p --rank-moe-resident-fraction). FEST, nicht per ${..:-} ueberschreibbar: die Store-Geometrie haengt daran.
NF_FR_P=0.324,0.637,0.39     # H91: war 0.332,0.64,0.39 (x177). bb3 Arm Z.77; Launcher-H25-Post -> 0.324,0.637,0.733887 (bb3 P argv Z.178)
NF_FR_D=0.06,0.51,0.48       # Kante K (H30), = bb3 (Arm Z.53 EXTRA_D_SET + Z.64), unveraendert
NF_SCRATCH_D=100,48,48       # H91: war 118,48,48. bb3 Arm Z.65 (H95-Tabelle: 118 auf TP0 verweigert W130 ab n=4)
NF_STORE_DIR=/mnt/nf-experts/fnFL2   # eigenes Verzeichnis je Format, nie zwei Stores zugleich

# RC2-ZUSATZ: KV-Arena-Referenzen ueber die Release-Queue (P und D). bb3 Arm Z.118 setzt es ebenso (Soll: 0 'HICACHE-INDEX
# REFUSED', Zeile 'ARENA-QUEUE-REFS'). Code-Default AUS im Zielbaum -> muss hier stehen.
NF_ENV_RC2_FORM="SGLANG_HICACHE_ARENA_QUEUE_REFS=1"
# H91 (bb4-Option, Default LEER = bb3-Env): boot_nf_h91bb4.sh setzt auf P UND D zusaetzlich
#   SGLANG_ANTHROPIC_INLINE_SYSTEM_IN_PLACE=1;SGLANG_WEG2_TOLD_PROBE_TREE_KEY=1   (Befund M / #1416d; beide im Zielbaum, Default aus;
#   INLINE_SYSTEM muss auf P und D GLEICH sein). bb4 lief nie am Metall (nur Dry bb4d3) -> fuer die Abnahme nicht gesetzt;
#   h91bb4_eval.py meldet ihre Bloecke I1/T1-T4 darum FEHLT/nicht gesetzt. Einschalten = diese Zeile fuellen.
NF_ENV_BB4_FORM=""

# Gruppen-Env (P und D verschieden -> nur ueber --env-p/--env-d, nicht global exportierbar). = nf.env ausser SCRATCH_D/FR_P.
NF_ENV_P_FORM="SGLANG_MOE_SCRATCH_SLOTS=32;SGLANG_MOE_RESIDENT_EXPERT_FRACTION=$NF_FR_P;SGLANG_UNEVEN_MOE_EXPERT_SHARD=1;SGLANG_WEIGHT_LOADER_PREAD=0;SGLANG_LOAD_KEY_WORKERS=4;SGLANG_MOE_OFFLOAD_WAVE_ORDER=expert;SGLANG_QWEN4_PLE_CKPT_GATHER=pread;SGLANG_MOE_EXPERT_STORE_DIR=$NF_STORE_DIR;SGLANG_WEG2_ENABLE_P_TAIL_FOLD=1;SGLANG_WEG2_TAIL_KEEP_MIB=512;SGLANG_WEG2_PLE_STATE_HANDOFF=1;SGLANG_FORCE_QSA_ROWS_CONFIG=inf=64/8/2;SGLANG_WEG2_QSA_FP8_DECODE=ptx;SGLANG_WEG2_QSA_ROWS_FUSED_EAGER=1;SGLANG_WEG2_ENABLE_P_UNDIVIDED_MICRO_BATCH=1;SGLANG_WEG2_ENABLE_P_MULTI_ANCHOR_TAILS=1;SGLANG_WEG2_P_BURST_ASSEMBLY_MS=300;SGLANG_WEG2_REARM_PREFETCH=0;SGLANG_MOE_OFFLOAD_PLAN_VECTOR=1;SGLANG_NAN_GUARD_WAVE=0;SGLANG_NAN_GUARD_FETCH=0;SGLANG_OPT_HICACHE_DEVICE_INDEX_WRITE=0;SGLANG_WEG2_SEQ_BUFFER_DEPTH=2;SGLANG_HICACHE_ARENA_GIB=4;SGLANG_HICACHE_ARENA_KV_PAGE_BYTES=786432;SGLANG_HICACHE_ARENA_MAMBA_SLOTS=32"
NF_ENV_P_INSTR="SGLANG_WEG2_SLEEP_HEAP_CENSUS=0;SGLANG_MOE_OFFLOAD_TIMING=1;SGLANG_QSA_SIDECAR_TRACE=4;SGLANG_WEG2_PREFILL_TIMING=1;SGLANG_WEG2_ENABLE_TIMING_EVENT_FLUSH=1"
NF_ENV_D_FORM="SGLANG_QWEN4_PLE_CKPT_GATHER=pread;SGLANG_MOE_SCRATCH_SLOTS=$NF_SCRATCH_D;SGLANG_MOE_RESIDENT_EXPERT_FRACTION=$NF_FR_D;SGLANG_UNEVEN_MOE_EXPERT_SHARD=1;SGLANG_WEIGHT_LOADER_PREAD=0;SGLANG_LOAD_KEY_WORKERS=4;SGLANG_MOE_OFFLOAD_GRAPH_MODE=pool;SGLANG_MOE_EXPERT_STORE_DIR=$NF_STORE_DIR;SGLANG_WEG2_TAIL_KEEP_MIB=512;SGLANG_WEG2_PLE_STATE_HANDOFF=1;SGLANG_HICACHE_LOAD_ASYNC_INDEX=1;SGLANG_WEG2_REARM_DEFER=1;SGLANG_WEG2_FORM_A_PLE_FULL_VOCAB=1;SGLANG_WEG2_PLE_STAGE_BEHIND_REPLAY=1;SGLANG_QWEN4_PLE_DECODE_PREAD_PROCS=8;SGLANG_QWEN4_PLE_DECODE_PREAD_THREADS=8;SGLANG_WEG2_PLE_STAGE_AUTONOMOUS=1;SGLANG_WEG2_PLE_STAGE_BONUS_EARLY=1;SGLANG_WEG2_TAIL_SKIP_EXTEND=1;SGLANG_WEG2_REARM_PREFETCH=0;SGLANG_QSA_MTP_INDEX_SHARE=0;SGLANG_WEG2_SEQ_BUFFER_DEPTH=2;SGLANG_HICACHE_ARENA_GIB=4;SGLANG_HICACHE_ARENA_KV_PAGE_BYTES=786432;SGLANG_HICACHE_ARENA_MAMBA_SLOTS=32;SGLANG_FORCE_QSA_ROWS_CONFIG=sm120:32=32/8/2,64=64/8/2,128=64/4/2,512=32/4/2,inf=64/8/2"
# H91: +SGLANG_DEBUG_MOE_POOL_DEMAND=64 (bb3 Arm Z.115, WEG2-GROUP-ENV D Z.235) -- Instrument, nur mit HTSGLANG_INSTRUMENTS=1
NF_ENV_D_INSTR="SGLANG_WEG2_SLEEP_HEAP_CENSUS=0;SGLANG_DEBUG_DECODE_PLE_WAIT=1;SGLANG_DEBUG_HOST_ANON_PROBE=1;SGLANG_SPEC_STAGE_SYNC=8;SGLANG_GRAPH_REPLAY_CENSUS=8;SGLANG_BARLINK_EAGER_TRACE=6000;SGLANG_QSA_SIDECAR_TRACE=4;SGLANG_HICACHE_ROUND_TIMING=512;SGLANG_DEBUG_MOE_POOL_DEMAND=64"
_nf_rc2=${NF_ENV_RC2_FORM:+;$NF_ENV_RC2_FORM}${NF_ENV_BB4_FORM:+;$NF_ENV_BB4_FORM}
if [ "${HTSGLANG_INSTRUMENTS:-1}" = "1" ]; then
  NF_ENV_P="$NF_ENV_P_FORM$_nf_rc2;$NF_ENV_P_INSTR"; NF_ENV_D="$NF_ENV_D_FORM$_nf_rc2;$NF_ENV_D_INSTR"
else
  NF_ENV_P="$NF_ENV_P_FORM$_nf_rc2"; NF_ENV_D="$NF_ENV_D_FORM$_nf_rc2"
fi
unset _nf_rc2

# NCCL-BLOCK wie nf.env (gilt NUR bei HTSGLANG_TRANSPORT=nccl; H91-Form unter nccl unbelegt).
if [ "${HTSGLANG_TRANSPORT:-bar1}" = nccl ]; then
  NF_ENV_P="$NF_ENV_P;SGLANG_WEG2_SEQ_BUFFER_DEPTH=1"
  NF_ENV_D="$NF_ENV_D;SGLANG_WEG2_SEQ_BUFFER_DEPTH=1"
fi

# Launcher-Argumente (ohne --tree/--tag/--transport; die setzt der Entrypoint). Quotierung von --extra-p/-d wie nf.env.
PROFILE_ARGS=(
  --corridor-budget-sample "$PROFILE_CORRIDOR"
  --profile nextflash --model "$PROFILE_MODEL"
  --flip-weights family --weg2-weight-source exchange --weg2-xchg-inject authoritative
  --xchg-bounce-depth 1 --weg2-weights-cpu-backup off --weight-chunks 16
  --weg2-xchg-census "$PROFILE_CENSUS"
  --env-p "$NF_ENV_P" --env-d "$NF_ENV_D"
  --d-foreign-context-mib 1446,896,894 --d-nontorch-mib 1981,528,524
  --d-tp-objective maxkv --draft-kv-on-p off --weg2-vision transient --pp-solve-pool-floor 0
  --pp-stage-ratio 29,11,8 --pp-attn-stage-ratio 7,3,2
  --pp-cut-expert-device-fraction "$NF_FR_P" --pp-cut-expert-lru-rows 32,32,32
  --user-reserve-mib 0,0,0 --store-max-gb 150 --max-kv-per-request 262144
  --p-bs 6                                             # H91: war --p-bs 4 --d-bs 1. P 6 Sitze (bb3 Arm Z.84 P_BS=6); --d-bs NICHT sagen -> standard_form 6 dyn.
  --extra-p '--max-total-tokens 262144 --json-model-override-args "{\"language_model_only\":true}" --kv-cache-dtype fp8_e4m3 --page-size 64 --max-running-requests 6 --mamba-ssm-dtype bfloat16 --ple-offload-embedding --ple-offload-backend checkpoint --hicache-mamba-host-mib 300 --hicache-size 2 --speculative-draft-model-path '"$PROFILE_DRAFT"' --rank-moe-resident-fraction '"$NF_FR_P"' --rank-user-reserve-mib 0,0,0 --disable-cuda-graph --context-length 262144 --max-kv-per-request 262144 --max-mamba-cache-size 32'
  --extra-d '--max-total-tokens 262144 --json-model-override-args "{\"language_model_only\":true}" --kv-cache-dtype fp8_e4m3 --page-size 64 --max-running-requests 6 --mamba-ssm-dtype bfloat16 --ple-offload-embedding --ple-offload-backend checkpoint --hicache-mamba-host-mib 300 --rank-role host,worker,worker --rank-tp-ratio 1,0,0 --rank-moe-ratio 183,137,168 --rank-moe-resident-fraction '"$NF_FR_D"' --rank-user-reserve-mib 0,0,0 --speculative-draft-placement solo --speculative-algorithm NEXTN --speculative-num-steps 3 --speculative-eagle-topk 1 --speculative-num-draft-tokens 4 --speculative-draft-model-path '"$PROFILE_DRAFT"' --cuda-graph-bs-decode 1 2 3 4 5 6 --cuda-graph-backend-decode=full --cuda-graph-backend-prefill=disabled --hicache-size 4 --hicache-mamba-host-mib 300 --context-length 262144 --max-kv-per-request 262144'
  --d-replayssm-spec on                                # H64, = bb3 (Arm LAUNCHER_EXTRA)
  --wake-credit-reference-logs "$PROFILE_WAKE_REF"     # H14/H54, Referenz fnFL2x162, = bb3
  --x-ceiling-tokens 12288                             # RC2 (H84) = Registry nextflash x_ceiling_tokens; bb3 nannte es nicht (Registry-Default derselbe Wert)
)

# FORM (global exportiert: der Launcher kopiert os.environ in beide Gruppen UND in die Front, build_env / fenv).
profile_form_env() {
  _form SGLANG_WEG2_WAKE_DEFER_BELOW_MIB 0
  _form SGLANG_MOE_EXPERT_STORE_SLOT_FRACTION 0.82
  _form SGLANG_MOE_COLD_TIER_SHM 1
  _form SGLANG_MOE_COLD_TIER_INSTANCE "${HTSGLANG_TAG}"
  _form MALLOC_ARENA_MAX 2
  _form SGLANG_MOE_OFFLOAD_EXCLUDE_DRAFT 1
  _form SGLANG_MOE_OFFLOAD_WAVE_SLICE 40960
  _form SGLANG_NAN_GUARD 1
  _form SGLANG_HC_MIXER_INT8 1
  _form SGLANG_MOE_MARLIN_ATOMIC_ADD 0
  _form SGLANG_MOE_POOL_STAGING 8
  _form SGLANG_QWEN4_PLE_FILE_SKIP_DEVICE_CHECK 1
  _form SGLANG_HICACHE_ARENA_MAMBA_SLOTS 32
  _form SGLANG_HICACHE_ARENA_KV_PAGE_BYTES 786432
  _form SGLANG_WEG2_DRAFT_ON_P 0
  _form SGLANG_WEG2_P_CHUNKED_PREFILL_TOKENS 16384
  _form SGLANG_WEG2_ENABLE_P_UNDIVIDED_MICRO_BATCH 1
  _form SGLANG_WEG2_ENABLE_P_MULTI_ANCHOR_TAILS 1
  _form SGLANG_WEG2_P_BURST_ASSEMBLY_MS 300
  _form SGLANG_WEG2_P_QUEUE_AHEAD 4                            # liest die FRONT; bb3 = 4 (WEG2-GROUP-ENV Z.234)
  _form SGLANG_WEG2_CTL_KICK_ARRIVAL 1
  _form SGLANG_WEG2_CTL_KICK_AFTER_FLIP 1
  _form SGLANG_WEG2_DC_OFF_PATH 1
  _form SGLANG_WEG2_ENABLE_FORM_A_TP0_FOLLOW 1                 # RC2.1k/l (H98), = Code-Default AN
  # H91 (bb3 Launcher-Env, Arm Z.93; Front und Raenge erben es; alle vier Code-Default AUS in 2a7f992c14):
  _form SGLANG_WEG2_QUIESCE_FAST 1                             # H111: Front-Poll 10 ms + PP0 ohne Wiederwunsch
  _form SGLANG_WEG2_DEPOSIT_LANE_LOOKAHEAD 1                   # H111b: Paar-Lanes vor der Pause (bb3 Default 1, H111d faengt das Staging-Rennen)
  _form SGLANG_WEG2_MIN_DWELL_EXCLUDE_DRAIN 1                  # H91c2: Min-Dwell ohne Drain
  _form SGLANG_WEG2_CENSUS_O1_EVICT 1                          # KR-Census-O1 (e17bd548b5)
  # #244 SA (rc12v 4c866d534a, weg2/seat_age.py): SEAT_ROTATE=1 = Sitzvergabe nach Ankunft + KV-Backfill +
  # Nachrücken des Ältesten (Nutzer-Entscheid 27.09. ~17:50Z über 27B). 0 wäre das alte resume-first.
  _form SGLANG_WEG2_SEAT_ROTATE 1
}
# INSTRUMENTE (global; die gruppenweisen stecken in NF_ENV_*_INSTR oben). Wie nf.env.
profile_instr_env() {
  _form SGLANG_LOAD_PROFILE 1
  _form CUDA_ENABLE_COREDUMP_ON_EXCEPTION 1
  _form CUDA_ENABLE_LIGHTWEIGHT_COREDUMP 1
  _form CUDA_COREDUMP_FILE "${SGLANG_WEG2_EVIDENCE_DIR:-/var/lib/htsglang/evidence}/cudacore_${HTSGLANG_TAG}_%h_%p"
  _form SGLANG_HICACHE_ARENA_REF_CENSUS_S 60
}

# Saat-Dateien der NF-Linie (Image /opt/htsglang/profiles/nf/, Liste profiles/nf.assets), wie nf.env.
PROFILE_SEED_EVIDENCE=(
  /opt/htsglang/profiles/nf/weg2_measured_record.json
)
PROFILE_SEED_SGLANG_CACHE=(
  /opt/htsglang/profiles/nf/phase_footprint-a191a0712717-055c2e4b0867.json
  /opt/htsglang/profiles/nf/phase_footprint-a191a0712717-cc0ac5caf91e.json
  /opt/htsglang/profiles/nf/card_library.json
  /opt/htsglang/profiles/nf/card_library.json.by-uuid.json
)

# ---- E4 (Operator 28.09.): Release-Profil nf = Kopie von profiles/nf-h91-dpr-sa-vis.env (Stand 2026-09-28T05:52Z, sha256 cad85528734ad4d4; nur gelesen).
# Die alte nf-Form (x177) ist nicht Teil des Releases; nf-h91-dpr-sa-vis liegt hier als experimenteller Alias.
PROFILE_NAME=nf
PROFILE_STATUS=abgenommen   # E4: Release-Profil; Metall-Abnahme = Release-Tabelle Zeile 8 (nf-INT4 im fLLiper-Image)
# <<< end of nf.env <<<

_gg_mc=/spinning/llm_stuff/club-3090/models-cache
_gg_old_model=$PROFILE_MODEL
_gg_old_draft=$PROFILE_DRAFT
_gg_old_store=$NF_STORE_DIR

PROFILE_NAME=nf-gguf
PROFILE_FORM=h91bb4-gguf
PROFILE_FORMAT=gguf
PROFILE_STATUS=experimentell
PROFILE_PLACEHOLDER=0
PROFILE_OWNER="NF-GGUF (Plan PLAN-GGUF-NF-1009, AP G5; Form = nf.env h91bb4 + GGUF-Aenderungen oben); am Metall ungebootet"
PROFILE_SIBLING="${NF_GGUF_SIBLING:-$_gg_mc/Qwen3.8-Flash-Next-GGUF-unsloth-sibling}"   # make_nf_gguf_sibling.sh
PROFILE_MODEL="$PROFILE_SIBLING/Qwen3.8-Flash-Next-UD-IQ4_XS-00001-of-00003.gguf"
PROFILE_TOKENIZER="$PROFILE_SIBLING"
# NF-GGUF G3 (Nutzerentscheid 09.10. 22:40Z: kein fremder Draft): Draft = das EIGENE MTP-GGUF der Quantisierung. shared-Q8_0 (2,59 GiB,
# ohne token_embd/output: der Draft teilt die Vokabular-Module des Ziels) ist die Wahl; Rueckfall ist mtp-Qwen3.8-Flash-Next-Q8_0.gguf
# (3,84 GiB, eigene Tabellen, die der Lader ungelesen laesst) -- per HTSGLANG_DRAFT. Die Draft-Config (Geometrie, hc_count, ...) liest der
# Server NEBEN der .gguf-Datei (config.json von genau diesem Modell, W172/W173 wie beim Ziel): ein Verzeichnis mit Symlink auf die
# MTP-Datei plus config.json aus Qwen3.8-Flash-Next-NVFP4-nvidia ist am Rig noch NICHT angelegt (unbelegt).
PROFILE_DRAFT="${HTSGLANG_DRAFT:-$_gg_mc/Qwen3.8-Flash-Next-GGUF-unsloth/MTP/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf}"
NF_STORE_DIR=/mnt/nf-experts/gguf
PROFILE_REQUIRED_PATHS=(
  "$PROFILE_MODEL"
  "$PROFILE_TOKENIZER/config.json"
  "$PROFILE_TOKENIZER/tokenizer.json"
  "$PROFILE_DRAFT"
  "$PROFILE_CENSUS"
  "$PROFILE_CORRIDOR"
  "$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.P.log"
  "$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.D.log"
  "$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.front.log"
)

_gg_args=()
for ((_gg_i = 0; _gg_i < ${#PROFILE_ARGS[@]}; _gg_i++)); do
  _gg_a=${PROFILE_ARGS[_gg_i]}
  case "$_gg_a" in
    --model) _gg_args+=(--model "$PROFILE_MODEL" --tokenizer-path "$PROFILE_TOKENIZER"); _gg_i=$((_gg_i + 1)) ;;
    --weg2-vision) _gg_args+=(--weg2-vision off); _gg_i=$((_gg_i + 1)) ;;
    --weg2-xchg-census) _gg_args+=(--weg2-xchg-census "${PROFILE_ARGS[_gg_i + 1]}" --weg2-xchg-census-foreign); _gg_i=$((_gg_i + 1)) ;;
    *)
      _gg_a=${_gg_a//"$_gg_old_draft"/"$PROFILE_DRAFT"}
      _gg_a=${_gg_a//"$_gg_old_model"/"$PROFILE_MODEL"}
      _gg_a=${_gg_a//"$_gg_old_store"/"$NF_STORE_DIR"}
      _gg_args+=("$_gg_a") ;;
  esac
done
PROFILE_ARGS=("${_gg_args[@]}")
unset _gg_args _gg_a _gg_i _gg_old_model _gg_old_draft _gg_old_store _gg_mc

# FORM: die von nf.env, ohne SGLANG_HC_MIXER_INT8 (siehe oben; `_form` kennt kein Ueberschreiben: eine zweite Zeile derselben Variable
# wuerde als FORM-OVERRIDE gemeldet und den ersten Wert behalten), plus der GGUF-Wert 0.
eval "$(declare -f profile_form_env | grep -v 'SGLANG_HC_MIXER_INT8' | sed '1s/^profile_form_env/_profile_form_env_nf/')"
profile_form_env() {
  _profile_form_env_nf
  _form SGLANG_HC_MIXER_INT8 0                                   # GGUF: Mixer als bf16-Linear (Lader dequantisiert Q8_0)
}
# <<< end of nf-gguf.env <<<

_gd_mc=/spinning/llm_stuff/club-3090/models-cache
_gd_old_draft=$PROFILE_DRAFT
_gd_name=Qwen3.8-Flash-Next-GGUF

PROFILE_NAME=nf-gguf-d
PROFILE_FORM=gguf-d-stufe-a
PROFILE_OWNER="NF-GGUF (Plan PLAN-GGUF-NF-1009, AP G8: Stufe A D-only-Formatnachweis; Form = nf-gguf.env + D-only); am Metall ungebootet"
PROFILE_DRAFT_DIR="${NF_GGUF_DRAFT_DIR:-$_gd_mc/Qwen3.8-Flash-Next-GGUF-unsloth-draft}"   # make_nf_gguf_draft_dir.sh
PROFILE_DRAFT="${HTSGLANG_DRAFT:-$PROFILE_DRAFT_DIR/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf}"
PROFILE_REQUIRED_PATHS=(
  "$PROFILE_SIBLING"
  "$PROFILE_MODEL"
  "$PROFILE_TOKENIZER/config.json"
  "$PROFILE_TOKENIZER/tokenizer.json"
  "$PROFILE_DRAFT_DIR"
  "$PROFILE_DRAFT"
  "$PROFILE_DRAFT_DIR/config.json"
  "$PROFILE_CENSUS"
  "$PROFILE_CORRIDOR"
  "$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.P.log"
  "$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.D.log"
  "$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.front.log"
)

_gd_args=(--d-only)
for ((_gd_i = 0; _gd_i < ${#PROFILE_ARGS[@]}; _gd_i++)); do
  _gd_a=${PROFILE_ARGS[_gd_i]}
  case "$_gd_a" in
    --d-only) ;;                                  # schon im Argv: nicht doppelt
    *)
      _gd_a=${_gd_a//"$_gd_old_draft"/"$PROFILE_DRAFT"}
      # das Gruppen-Extra des Launchers traegt --served-model-name VOR den --extra-p/-d-Woertern: das spaetere gewinnt
      if ((_gd_i > 0)); then
        case "${PROFILE_ARGS[_gd_i - 1]}" in
          --extra-p|--extra-d) _gd_a="$_gd_a --served-model-name $_gd_name" ;;
        esac
      fi
      _gd_args+=("$_gd_a") ;;
  esac
done
PROFILE_ARGS=("${_gd_args[@]}")
unset _gd_args _gd_a _gd_i _gd_old_draft _gd_mc _gd_name

PROFILE_D_ONLY=1                      # Entrypoint: --d-only, D-Server :30032 ueberwachen, keine Front
PROFILE_SERVE_PORT=30032              # Clients sprechen D direkt
