# shellcheck shell=bash
# DIAET-FASSUNG (Auftrag 990, Stufe W2): abgeleitet aus 27b.env; das Original bleibt unveraendert. Gestrichen sind Eintraege, die den
# Code-/Registry-Default nur wiederholen (Audit 970, Spalte unterart "=Default") und tote PROFILE_*-Zeilen; die effektive Konfiguration ist
# gleich (Beleg: /spinning/gpu-arb/deskq/done/990-profil-diaet.out). GILT NUR fuer Baeume, in denen diese Defaults stehen (54a30199b1);
# auf einem aelteren Image aendert das Streichen das Verhalten. Kommentare der gestrichenen Zeilen blieben bewusst stehen (Historie).
# RELEASE-PROFIL 27b (E4, Operator 28.09.2026): Qwen3.8-27B INT8 in der Release-Form = 27b-release-draft (rc10 + drq-D-Form
# wake-seg 652:218:218 + --d-token-placement bandwidth + D-Extend-Trim, Praefix-Schalter aus der Registry qwen27b)
# + Fix B (27b-row-authority: SGLANG_WEG2_P_ROW_AUTHORITY=1). Zusammengesetzt aus den Rig-Dateien Stand 28.09. (nur gelesen,
# unveraendert): profiles/27b.env (-> 27b-base.env), profiles/27b-release-draft.env, profiles/27b-row-authority.env; deren
# Rumpf steht unten WORTGLEICH, abschnittsweise markiert. Nur make_flat_ctx.sh (Release-Kontext) nimmt diese Datei.
# Fix B bleibt ein Profil-_form (Registry ModelProfile.p_row_authority qwen27b=False, Operator 27.09.: der Default kippt erst
# nach dem Metall-Beleg) -- `profile_docker --check` zeigt darum 1 DIFF (SGLANG_WEG2_P_ROW_AUTHORITY), gewollt.
# Die alten Namen 27b-release-draft / 27b-row-authority liegen hier als experimentelle Aliase.
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/27b-base.diet.env"
# ======== Rumpf aus profiles/27b-release-draft.env (wortgleich ab der Zeile nach seinem source) ========
PROFILE_NAME=27b-release-draft
PROFILE_FORM=${PROFILE_FORM}+rc10+prefix
PROFILE_STATUS=experimentell   # Entwurf; abgenommen erst nach Metall-Beleg (Agentenlast rc10 + Praefix), Operator entscheidet
PROFILE_OWNER="27B-Sitz (Agent RD, Release-Entwurf INT8 = rc10 + Praefix-Schalter)"

# --- D-Layout (Zeile 24 + 24b), wie 27b-rc10.env -----------------------------------------------------------------------------
# Knopf HTSGLANG_RC10_D_PLACE (Name wie in 27b-rc10.env, damit Arme und FLLIPER_RC10_D_PLACE unveraendert greifen):
#   rt (Kandidat) | t (nur Token-Platzierung) | off (D-Layout wie 27b); Abweichung = FORM-OVERRIDE, laut.
_rc10_d_place_best=drq  # 26.09. A/B rc11b (dkr27bint8drqbar1i8drq109262005 gegen dkr27bint8drtbar1i8rt109261955): drq an allen 24 Punkten -1,6…-4,1 % Schrittzeit gegen R+T, ueber dem Band
_rc10_d_place=${HTSGLANG_RC10_D_PLACE:-$_rc10_d_place_best}
case "$_rc10_d_place" in
  # rt: Beleg i8rt boot_weg2_dkr27bint8drtbar109261117 (rc9meas, d98b3ba08a) gegen i8h dkr27bbar1mwh09261051: Schrittzeit
  #     code@128k -1,1/-2,6 %, code@240k -1,7/-3,1 % (bs1/bs2), 10k/32k kein Unterschied, Nadel MATCH. R allein = Verlust (i8r).
  rt)  PROFILE_ARGS+=(--d-reshard wake --d-reshard-presets auto --d-token-placement bandwidth) ;;   # auto -> 707,191,190
  # t: T allein (27b-int8-dt) ungemessen.
  t)   PROFILE_ARGS+=(--d-token-placement bandwidth) ;;
  off) ;;
  # drq (ALTERNATIVE, AUSKOMMENTIERT): Segment-Kreuzung 652:218:218 + wake-seg + Token nach Bandbreite, Form wie 27b-int8-drq.env.
  #     MODELL, KEINE MESSUNG (DYN_D_RESHARD_INT8.md: Erwartung gegen drt -2,2 % warm). Kein drq-Boot in docker-acceptance/27b
  #     (26.09. ~18:40Z). Erst nach A/B drq gegen drt (i8rt) gegen 27b (i8h), selbes Fenster, selbes Image, verschraenkt.
  #     Abbruchregel aus 27b-int8-drq.env: drq bei bs1 10k-32k nicht ueber das Band schneller als drt -> verworfen.
  #     Launcher: wake-seg + explizite Presets im vereinigten Baum vorhanden (d_reshard.py POLICY_WAKE_SEG, launcher --d-reshard).
  drq) PROFILE_ARGS+=(--d-reshard wake-seg --d-reshard-presets "drq=652:218:218") ;;
  *) echo "profiles/27b-release-draft.env: HTSGLANG_RC10_D_PLACE='$_rc10_d_place' (rt|t|off)" >&2; exit 3 ;;
esac
if [ "$_rc10_d_place" != "$_rc10_d_place_best" ]; then
  echo "[profiles/27b-release-draft] FORM-OVERRIDE HTSGLANG_RC10_D_PLACE=$_rc10_d_place (Kandidat $_rc10_d_place_best) -- per docker run -e gesetzt" >&2
fi

# --- F2 (27B b1 death 27.09. 06:57:17Z, dkr27breleasedraftbar1w109270652): D-Extend leert den Allokator-Cache auf TP0 --------
# D TP0 (5090) starb bei card_free 5 MiB: jeder Leg-2-Extend liess torch_reserved um bis zu +646 MiB wachsen (rc11a max +576),
# waehrend 1,46-1,6 GiB freier Cache fuer den Treiber unerreichbar waren (#1028c alloc_cache). WEG2-EXTEND-CACHE-TRIM (rc12e,
# weg2/extend_trim.py) gibt vor dem Target-Extend die ganz freien Segmente zurueck, wenn card_free < Schwelle. Schwelle TP0 1200 =
# max. Extend-Zuwachs 646 + ~512 Treiber-Reserve; TP1/TP2 (3080) 0 = nie (dort min. frei 394/532, kein Tod). NUR fuer D (--env-d):
# auf P stuende sonst sync+empty_cache vor jedem P-Chunk. Der 27B-Launcher setzt die Variable nicht selbst (nur der NF-D-Rang-
# Solve-Pfad, launcher.py d_extend_trim_env). Beleg im Lauf: D 'WEG2-EXTEND-CACHE-TRIM rank=0 ... released= card_free_after='.
# Ein zweites --env-d (Arm/Profil darueber) ERSETZT diesen String (argparse: letzter gewinnt) -> dort diesen Eintrag mitnehmen.
PROFILE_ARGS+=(--env-d 'SGLANG_WEG2_EXTEND_TRIM_MIB=1200,0,0')

eval "$(declare -f profile_form_env | sed '1s/^profile_form_env/_profile_form_env_reldraft_base/')"
profile_form_env() {
  _profile_form_env_reldraft_base
  # --- rc10-Teil (1:1 aus 27b-rc10.env; Belege dort ausfuehrlich) --------------------------------------------------------------
  # Zeile 24h (Agent HG): die drei D-Host-Luecken-Schalter NUR zusammen gemessen. Voraussetzung D_DEFER_SEQ_LENS_CPU + D_DEFER_REBUILD
  # (aus 27b.env). Arm dhg boot_weg2_dkr27bint8dhgbar1dhg109261456 gegen i8h boot_weg2_dkr27bbar1i8h109261444 (rc9dwin, bfc6bd87e2):
  # SGLANG_WEG2_D_EARLY_DRAFT=1 entfernt (Profil-Bereinigung Release 30.09.): Code-Default AN seit df762c4bbc (Registry qwen27b d_hostgap_levers); explizit =0 schaltet weiter ab
  # SGLANG_DFLASH_ACCEPT_SYNC_FUSED=1 entfernt (Profil-Bereinigung Release 30.09.): Code-Default AN seit df762c4bbc (Registry qwen27b d_hostgap_levers); explizit =0 schaltet weiter ab
  # SGLANG_BARLINK_BAR1_CANON_ORDER=1 entfernt (Profil-Bereinigung Release 30.09.): Code-Default AN seit df762c4bbc (Registry qwen27b d_hostgap_levers); explizit =0 schaltet weiter ab
  # SGLANG_DFLASH_WINDOW_POOL_DEDUP_CARRY=1 entfernt (Profil-Bereinigung Release 30.09.): Code-Default AN seit ad8b383b08 (Registry qwen27b d_release_fixes); explizit =0 schaltet weiter ab
  # SGLANG_WEG2_CENSUS_O1_EVICT=1 entfernt (Profil-Bereinigung Release 30.09.): Code-Default AN seit ad8b383b08 (Registry qwen27b d_release_fixes); explizit =0 schaltet weiter ab
  # --- Praefix-Schalter: KEINE _form-Zeilen mehr -- die Registry liefert sie (RG 26.09.) ---------------------------------------
  # Beleg-Boot dkr27brc10bar1agent09261821 (Image rc11a, Baum b3180fb493, 26.09. 18:21-18:56Z): 108 Requests, Flips 0,23 je Request
  # (vorher 1,35), verschwendeter Prefill ~7 % (vorher 48 %), 0 Gruppentod; ENV-IM-RANG alle fuenf = 1 auf P, D und Front;
  # Belegzeilen #1416d TOLD-PROBE=8, PACED 8/8, TWIN 7/7, span_inflight 109.
  # Registry-Felder (weg2/form.py PREFIX_SWITCHES, Profil qwen27b = an; nextflash = aus, bis NF freigibt):
  #   inline_system_in_place  SGLANG_ANTHROPIC_INLINE_SYSTEM_IN_PLACE  (MZ; P und D gleich -- der Launcher verweigert einen Split)
  #   told_probe_tree_key     SGLANG_WEG2_TOLD_PROBE_TREE_KEY          (TK; SGLANG_WEG2_TOLD_ABSOLUTE folgt ihm als Rang-Default)
  #   told_paced              SGLANG_WEG2_TOLD_PACED                   (PX2)
  #   p_twin_defer            SGLANG_WEG2_P_TWIN_DEFER                 (TW)
  #   front_span_inflight     SGLANG_WEG2_FRONT_SPAN_INFLIGHT          (#49, wirkt nur mit agent_span)
  #   told_group_fallback     SGLANG_WEG2_TOLD_GROUP_FALLBACK          (PF; qwen27b AN seit d0fd84451b, 01.10. -- z30y14 PP1 STORE-TOLD-Tod; erster Metall-Boot z30y15)
  # Der Launcher nennt Wert und Quelle je Schalter in der Zeile WEG2-PREFIX-SWITCHES (profile qwen27b | env ...).
  # Eine hier (oder per docker run -e) gesetzte _form-Zeile GEWINNT weiter ueber die Registry -- nur fuer Abweichungen verwenden.
  # VORAUSSETZUNG: ein Baum MIT den Registry-Feldern (RG-Commit auf desk/27b-registry-prefix-0926 bzw. nach dem Pick im vereinigten
  # Kopf). Ein aelterer Baum (z.B. rc11a b3180fb493) faehrt diese Datei OHNE die fuenf Schalter -- dort die .bak_0926_rg-Fassung.
  # PF kommt aus der Registry (qwen27b an, d0fd84451b); =0 hier schaltet ihn ab:
  # _form SGLANG_WEG2_TOLD_GROUP_FALLBACK 0
}
# NICHT drin: alles, was 27b-rc10.env ausschliesst (Gruende dort und im Proposal), und die Instrumente des Agentenlast-Arms
# (SGLANG_HICACHE_ARENA_REF_CENSUS_S=10 als FORM-OVERRIDE, SGLANG_DEBUG_HOLD=1).
# ======== Rumpf aus profiles/27b-row-authority.env (wortgleich ab der Zeile nach seinem source) ========
PROFILE_NAME=27b-row-authority
PROFILE_FORM=${PROFILE_FORM}+rowauth
PROFILE_STATUS=experimentell
PROFILE_OWNER="27B-Sitz (Agent PA, 27b-release-draft + Fix B Zeilenautoritaet auf P)"

eval "$(declare -f profile_form_env | sed '1s/^profile_form_env/_profile_form_env_rowauth_base/')"
profile_form_env() {
  _profile_form_env_rowauth_base
  # SGLANG_WEG2_P_ROW_AUTHORITY=1 entfernt (Profil-Bereinigung Release 30.09.): Code-Default AN seit 85d426c6ce (Registry qwen27b p_row_authority); explizit =0 schaltet weiter ab
  # FLIP-HEBEL (NF-Port 30.09., desk/27b-integ-dual-merge-0930 >= b43c19ef1a; Metall hauenh dkr27browauthorityls12bar1fs09301342:
  # D->P stationaer max 1,94 s gegen 8,00 s) -- Code-Default AUS, hier AN wie im Live-Profil 27b-row-authority.env (flip-levers-0930).
  # #49 L1: P-Anker-Praesenz (a59c95ae36; Replay w109290020 59 -> 38 LONG). Metall-Urteil: der naechste 27B-Flip-Boot (W50-REROUTE).
}
# ======== E4-Identitaet ========
PROFILE_NAME=27b
PROFILE_STATUS=abgenommen   # E4: Release-Profil; Metall-Abnahme = Release-Tabelle Zeile 8 (27B-INT8 im fLLiper-Image)
PROFILE_OWNER="27B-Sitz (E4 28.09.: Release 27b = 27b-release-draft + Fix B; Basis 27b-base)"
# ======== Item 380 (Nutzer-Orders 03.10.): 27B bleibt UNSER INT8 gdncov-vocabembed (nicht abl), --model ausdruecklich, L15 AN ========
# --model: 27b-base uebergibt --model bewusst nicht (Launcher-Default = dasselbe gdncov); ein explizites Flag macht den Checkpoint im Argv
# sichtbar und faengt einen Wechsel von PROFILE_MODEL ab (memory 27b-profil-ohne-model-flag-1003: der "abl"-Boot lief mit dem Default).
PROFILE_ARGS+=(--model "$PROFILE_MODEL")
# L15 (Nutzer 02.10.: L15 kommt eingeschaltet ins Release; nur 27B, auf NF verweigert der Launcher W-L15-27B-ONLY, im Dual W-L15-DUAL).
# Schalter wie im 27B-Watcher (L15E): Master + Refill + Hot-Share + VMM-exportierbar; im Env des Launcher-Prozesses (profile_form_env).
eval "$(declare -f profile_form_env | sed '1s/^profile_form_env/_profile_form_env_l15_base/')"
profile_form_env() {
  _profile_form_env_l15_base
  _form SGLANG_WEG2_L15 1
  _form SGLANG_WEG2_L15_REFILL 1
  _form SGLANG_WEG2_L15_HOT_SHARE 1
  _form SGLANG_WEG2_VMM_EXPORTABLE 1
  # ======== Item 430 (03.10.): L15-Kappen -- ohne diese Zeile VERWEIGERT der Launcher (W-L15-NOCAP) ========
  # Warum: L15=1 ohne SGLANG_WEG2_L15_MIB = Modus "auto"; der kennt nur den Rekord P_AWAKE_PEAK_MIB, den es fuer kein Profil gibt
  # (launcher.py:24335 KeyError -> UNMEASURED -> Post 0 je Karte) -> l15_plan.refuse_no_caps (l15_plan.py:176) -> Weg2LaunchRefused
  # (launcher.py:24346-24348). Und selbst ein Post > 0 wuerde den Raengen nichts nuetzen: caps_from_env (l15_shadow.py:85) liest NUR
  # den Override, "auto"/leer = Kappe 0 je Rang (test_weg2_l15_caps_override_1001).
  # Die Zahlen sind eine RIG-KONSTANTE (Boot-1926-Kartenplan, MiB je Budget-Ordinal; c0 = 5090 = ungenannt = 0 = Refill-Rang):
  #   c1 = 7616 MiB (3080, NVML 0), c2 = 1792 MiB (3080, NVML 2). Gleiche Werte wie EXTRA_CENV der Watcher.
  # RIG-GEBUNDEN: gilt nur fuer das Referenz-Rig 5090 + 2x3080 in Budget-Reihenfolge. Auf anderer Bestueckung entweder Zeile
  # ueberschreiben (docker run -e SGLANG_WEG2_L15_MIB=..., _form meldet FORM-OVERRIDE) oder nach 260 HW-GENERIC (de0130eb2f) mit
  # Karten-Identitaet schluesseln (GPU-<uuid>=/pci:<bus>=/nvml<i>=). Dort verweigert der Launcher fremde Bestueckung ohnehin
  # (HW-UNCALIBRATED), die Ordinalform bleibt byte-gleich.
  # SGLANG_WEG2_L15_SHADOW ist bewusst NICHT hier: reines Log-Instrument (l15_shadow.py "log lines only"), kein Verhalten.
  _form SGLANG_WEG2_L15_MIB "c1=7616,c2=1792"
}
