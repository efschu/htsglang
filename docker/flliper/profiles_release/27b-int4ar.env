# shellcheck shell=bash
# PROFIL 27b-int4ar (planer-n2fix2 1023, Review-Auflage A4 aus deskq/done/planer-n2fix-1023.md): Qwen3.8-27B als
# Huihui-Qwen3.8-27B-Abliterated-INT4-W4A16-AutoRound (HF letechlead, Nutzerorder 23.10. ~13:2xZ), lokal VERLUSTFREI nach
# compressed-tensors pack-quantized W4A16 umgepackt (tools/quant/autoround_gptq_to_ct.py, Zweig desk/27b-int4ar-1023 @ a45112428e):
#   W4A16 int, group 128, symmetrisch, kein act-order (0 g_idx; alle qzeros 0x77777777 = CT-Offset 8), 407 quantisierte Linears
#   (400 Sprachmodell + 7 MTP); bf16 bleiben embed_tokens, lm_head, der Vision-Turm (27 Bloecke + Merger, 333 Tensoren, 879 MiB,
#   zusammenhaengend in model-visual.safetensors), GDN in_proj_a/in_proj_b (96), conv1d, Norms, mtp.fc. MTP vorhanden.
#   Formerkennung des Entrypoints: compressed-tensors mit nur ("int", 4) -> int4.
# Form = 27b-fp8.env (27b-base + --model + Census-foreign + P-Chunk fixed) plus ausdruecklicher W8-Draft wie im Boot-Profil des
# Sitzes fable-27b-int4ar (deskq/bl/27b-int4ar-1023/27b-int4ar.json, aus dem metallbewiesenen Duo-Profil abgeleitet):
#   * KEINE FP4-Argumente (--fp8-uniform-marlin/--fp4-native-mixed gehoeren zu NVFP4/FP8);
#   * P-Chunk FIXED: es gibt kein INT4-Stufenmodell, builtin-int8 bzw. das NVFP4-Modell wuerden INT4 falsch bepreisen;
#   * Draft = DFlash2-W8-lued (zielformat-unabhaengig, wie 27b/27b-fp8/27b-gguf), ausdruecklich als --dflash-draft-path,
#     damit Planer und Startprofil denselben Ordner nennen (PROFILE_REQUIRED_PATHS prueft Draft UND Modell);
#   * keine gepinnten P-Schnitte: der Launcher loest Schnitt und Budgets selbst (Trockenlauf des Sitzes 13:46Z: P = TP1 x PP2
#     Schnitt 36,28 / 9,7, D = TP2), der Planer vermerkt sie, pinnt sie nicht (planer-n2fix B2).
# Zielinventar des Sitzes: 2 x RTX 3080 (Flip D = TP2, P = PP2). Das Karteninventar unten bleibt das der 27b-Basis (Rig 5090 +
# 2 x 3080): der Planer setzt PROFILE_CARD_COUNT/PROFILE_GPUS/PROFILE_INVENTORY im Startprofil aus der gewaehlten Kartenliste
# (planer-n2fix B1). --user-reserve-mib erbt dieses Profil von 27b-base.env (1800,1400,1400) -- offene Planer-Schuld, Ticket
# A2 in deskq/done/planer-n2fix2-1023.md (keine-korridor-reserve-nie 19.09.), wird zentral in 27b-base behoben, nicht hier.
# STAND: nie gebootet (erster Boot = Messung, Sitz fable-27b-int4ar). Status-Wechsel entscheidet der Operator.

# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/27b-base.env"   # E4: die alte 27b-Form (profiles_release/27b-base.env)

PROFILE_NAME=27b-int4ar
PROFILE_FORMAT=int4             # compressed-tensors pack-quantized, nur int4-Gruppen (Formaterkennung im Entrypoint)
PROFILE_MODEL=/spinning/llm_stuff/club-3090/models-cache/Huihui-Qwen3.8-27B-Abliterated-INT4-W4A16-AutoRound-ct
PROFILE_DRAFT=${HTSGLANG_DRAFT:-/spinning/llm_stuff/club-3090/models-cache/Qwen3.8-27B-DFlash2-W8-lued}
PROFILE_FORM=int4ar-ct-w4a16    # wie das Boot-Profil des Sitzes (mkprofile.py PROFILE_FORM)
PROFILE_STATUS=experimentell    # nie gebootet; Trockenlauf des Sitzes gruen (deskq/bl/27b-int4ar-1023/dry4.log)
PROFILE_PLACEHOLDER=0
PROFILE_OWNER="27B-int4ar-Sitz (fable-27b-int4ar 23.10.: Huihui-Qwen3.8-27B-Abliterated INT4 W4A16 AutoRound, verlustfrei nach CT umgepackt)"
PROFILE_REQUIRED_PATHS=("$PROFILE_DRAFT/config.json" "$PROFILE_MODEL/config.json")   # Entrypoint: Ordner allein reicht nicht

_fmt_args=(--model "$PROFILE_MODEL")
for ((_i = 0; _i < ${#PROFILE_ARGS[@]}; _i++)); do
  _fmt_args+=("${PROFILE_ARGS[_i]}")
  if [ "${PROFILE_ARGS[_i]}" = "--pdflip-xchg-census" ]; then
    _fmt_args+=("${PROFILE_ARGS[_i + 1]}" --pdflip-xchg-census-foreign)   # INT8-Census, kein eigener INT4-Census
    _i=$((_i + 1))
  fi
done
PROFILE_ARGS=("${_fmt_args[@]}" --dflash-draft-path "$PROFILE_DRAFT")
unset _fmt_args _i
_profile_drop_p_chunk
PROFILE_P_CHUNK_BEST=fixed       # kein INT4-Stufenmodell (siehe Kopf); HTSGLANG_P_CHUNK_POLICY=dynamic waere builtin-int8 und wird hier nicht angeboten
PROFILE_P_CHUNK=fixed
