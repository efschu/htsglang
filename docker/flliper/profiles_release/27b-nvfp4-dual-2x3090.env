# shellcheck shell=bash
# PROFIL 27b-nvfp4-dual-2x3090 (NCARDS 1021, HOCHRECHNUNG): Qwen3.8-27B NVFP4, Dual-Layout (P = PP2 und D = TP2 GLEICHZEITIG wach, kein Flip)
# auf 2 x RTX 3090 = 48 GB. Wie 27b-nvfp4-dual-3x3090.env (Regeln fuer N gleiche Karten, _3090_common.sh), dazu die P-Rang-Budgets, die der Planer fuer
# 2 Karten rechnet (propose, Form dual, regeln.budgets): 5820,6160 MiB je P-Rang (Rig-Wert 6610,5050,5200 gilt nur fuer 5090+2x3080).
# P-Schnitt: der Loeser waehlt (--pp-stage-ratio des Rig-Profils faellt in _p3090_apply). Trockenlauf mit --force: ok (HW-COUNT/HW-BORROWED/
# HW-UNCALIBRATED benannt, METAL-UNPROVEN). Erster Boot = Messung: FLLIPER_FORCE=1. Die DUAL-PFLICHT-Eichung (Boot b9p) gilt nur fuer das Rig:
# "nicht gerechnet" fuer den Pool je Karte, bis ein Boot auf diesen Karten sie ersetzt.
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/27b-nvfp4-dual.env"
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/_3090_common.sh"
PROFILE_NAME=27b-nvfp4-dual-2x3090
PROFILE_STATUS=hochrechnung   # nie auf 3090 gebootet; Trockenlauf mit --force ok (N=2), METAL-UNPROVEN
PROFILE_OWNER="Profil-Planer NCARDS 1021 (Hochrechnung aus dem 27b-nvfp4-dual-Release-Profil, N=2)"
PROFILE_GPUS="NVIDIA GeForce RTX 3090=2"
PROFILE_CARD_COUNT=2
PROFILE_INVENTORY="RTX3090,RTX3090"
_p3090_apply 2
for ((_i = 0; _i < ${#PROFILE_ARGS[@]}; _i++)); do
  case "${PROFILE_ARGS[_i]}" in
    --extra-p=*--rank-gpu-memory-mib\ 6610,5050,5200*) PROFILE_ARGS[_i]="${PROFILE_ARGS[_i]/6610,5050,5200/5820,6160}" ;;
  esac
done
unset _i
