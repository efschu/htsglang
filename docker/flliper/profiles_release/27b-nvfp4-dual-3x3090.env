# shellcheck shell=bash
# PROFIL 27b-nvfp4-dual-3x3090 (PLANER-3090 1021, HOCHRECHNUNG): Qwen3.8-27B NVFP4, Dual-Layout (P = PP3 und D = TP3 GLEICHZEITIG wach,
# kein Flip) auf 3 x RTX 3090. Nur NVFP4: P und D halten je eine volle Gewichtskopie (2 x ~19 GiB) -- INT8 (2 x ~26 GiB + Draft) passt
# neben KV nicht in 72 GB. L15 gilt im Dual nicht (W-L15-DUAL). Basis: Release-Profil 27b-nvfp4-dual + Regeln fuer N gleiche Karten.
# STATUS/ERSTER START/TRANSPORT/HOST: wie 27b-3x3090.env (FLLIPER_FORCE=1 beim ersten Boot; Trockenlauf ok_with_force).
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/27b-nvfp4-dual.env"
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/_3090_common.sh"
PROFILE_NAME=27b-nvfp4-dual-3x3090
PROFILE_STATUS=hochrechnung
PROFILE_OWNER="Profil-Planer PLANER-3090 1021 (Hochrechnung aus dem 27b-nvfp4-dual-Release-Profil)"
PROFILE_GPUS="NVIDIA GeForce RTX 3090=3"
PROFILE_CARD_COUNT=3
PROFILE_INVENTORY="RTX3090,RTX3090,RTX3090"
_p3090_apply 3
