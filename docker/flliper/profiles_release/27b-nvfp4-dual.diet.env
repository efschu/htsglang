# shellcheck shell=bash
# DIAET-FASSUNG (Auftrag 990, Stufe W2): abgeleitet aus 27b-nvfp4-dual.env; das Original bleibt unveraendert. Gestrichen sind Eintraege, die den
# Code-/Registry-Default nur wiederholen (Audit 970, Spalte unterart "=Default") und tote PROFILE_*-Zeilen; die effektive Konfiguration ist
# gleich (Beleg: /spinning/gpu-arb/deskq/done/990-profil-diaet.out). GILT NUR fuer Baeume, in denen diese Defaults stehen (54a30199b1);
# auf einem aelteren Image aendert das Streichen das Verhalten. Kommentare der gestrichenen Zeilen blieben bewusst stehen (Historie).
# RELEASE-PROFIL 27b-nvfp4-dual (Item 310, 03.10.2026, desk) -- 27B NVFP4 im DUAL-TP3PP3-Layout (P und D BEIDE wach, Front ohne Flip,
# P rechnet auf D's TP3-Shards, KV pro Karte vereint, P schlaeft nur unter D-Druck).
# Quelle: die Rig-Kette profiles/27b-nvfp4-dual1m-psleep.env -> 27b-nvfp4-dual1m -> dual1i -> dual1h -> dual1g -> dual1e -> dual1b ->
# 27b-nvfp4-rc10 -> 27b-nvfp4 -> 27b (-> 27b-base). Hier FLACH und nur die dual-relevanten Zeilen; ueberschriebene Zwischenwerte
# (argparse: letzter gewinnt) stehen nur noch mit ihrem ENDWERT, nicht mehr als Verlauf. Aequivalenz: /spinning/gpu-arb/deskq/running/310-dual-release-profile.md (Ergebnis).
#
# Nutzerentscheide 03.10.: Dual bleibt NVFP4 und NICHT abl. L15 gilt NICHT fuer den NVFP4-Dual (schliesst sich im VRAM aus; der Launcher
# verweigert die Kombination als W-L15-DUAL, l15_plan.refuse_dual) -> hier KEIN L15-Env.
#
# MPS-OPT-IN (wichtig): --dual-mps on wird vom Launcher nur akzeptiert, wenn FLLIPER_PDFLIP_DUAL_MPS_OPT_IN=1 in der Umgebung des
# LAUNCHER-PROZESSES steht (resolve_dual_layout, os.environ -- ein --env-p/--env-d oder PROFILE_ARGS erreicht diese Pruefung nicht).
# Der Entrypoint sourct das Profil und ruft profile_form_env im eigenen Hauptprozess, VOR dem Start des Launchers
# (entrypoint.sh: `source "$PROFILE_FILE"`, `profile_form_env`, spaeter `"$PY" "${LAUNCH[@]}" &`); ein dort exportiertes _form-Env erbt der
# Launcher. Darum steht der Schalter unten in profile_form_env. Er ersetzt das Rig-EXTRA_CENV der Dual-Boots. Ein explizites
# `docker run -e FLLIPER_PDFLIP_DUAL_MPS_OPT_IN=0` gewinnt (FORM-OVERRIDE, laut) -> der Launcher verweigert dann --dual-mps on.
# Der Baum muss b855aecfd3 tragen (barlink-BAR1 unter MPS ohne cooperative Full-Card-Grid = Wurzel des kw6pft/ndktv4/scjhru-S1-Wedge)
# UND desk/27b-dual-psleep-share-1001 (--dual-p-sleep unter --dual-share): beide sind Vorfahren von desk/27b-y8p-integ-1003.
# Pruefzeile im D- und P-Log: 'barlink-BAR1: MPS client (CUDA_MPS_PIPE_DIRECTORY set) -- the cooperative full-card grid variant is OFF'.
#
# NICHT im Release (Metall-Probe): FLLIPER_PDFLIP_DUAL_P_SLEEP_PROBE_S=30 (P schlaeft einmal im ersten Leerlauf, 30 s, dann Wake) -- nur
# Probe-Schalter der Rig-Boots (EXTRA_CENV), im Release bewusst nie gesetzt; ohne ihn schlaeft P nur unter echtem KV-Druck.
#
# Status: experimentell (Operator entscheidet; Metall-Abnahme des Dual-Release-Profils steht aus).
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/27b-base.diet.env"   # HW-GENERIC-Gate-Zeilen (Item 250) + INT8-Basisform; setzt PROFILE_NAME=27b-base

PROFILE_NAME=27b-nvfp4-dual
PROFILE_FORMAT=nvfp4-modelopt
PROFILE_MODEL=/spinning/llm_stuff/club-3090/models-cache/Qwen3.8-27B-NVFP4-RadixArk
PROFILE_FORM=rc8-nvfp4-native-mixed+rc10+dual1m+psleep   # Rig: ...+rc10+dual1b+dual1e+dual1g+dual1h+dual1i+dual1m+psleep (Schritte hier flach)
PROFILE_STATUS=experimentell
PROFILE_OWNER="27B-Sitz (Release-Dual NVFP4, Item 310; Form = Rig-Kette dual1m-psleep, flach)"
# Draft: NVFP4-DFlash2 als Standard (wie 27b-nvfp4), W8 per HTSGLANG_DRAFT. 27b-base setzt PROFILE_DRAFT auf den W8-Pfad -- hier ueberschrieben.
PROFILE_DRAFT=${HTSGLANG_DRAFT:-/spinning/llm_stuff/club-3090/models-cache/Qwen3.8-27B-DFlash2-NVFP4-RTNcal}
PROFILE_P_CHUNK_MODEL_NVFP4="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/27b-nvfp4.pchunk.json"
PROFILE_REQUIRED_PATHS=("$PROFILE_DRAFT/config.json")
if [ "$_p_chunk" = dynamic ]; then PROFILE_REQUIRED_PATHS+=("$PROFILE_P_CHUNK_MODEL_NVFP4"); fi

# ---- NVFP4-native-mixed-Form (aus 27b-nvfp4.env, RC9): --model per Flag, Census-Foreign hinter --pdflip-xchg-census --------------------------
_fmt_args=(--model "$PROFILE_MODEL" --fp8-uniform-marlin --fp4-native-mixed)
for ((_i = 0; _i < ${#PROFILE_ARGS[@]}; _i++)); do
  _fmt_args+=("${PROFILE_ARGS[_i]}")
  if [ "${PROFILE_ARGS[_i]}" = "--pdflip-xchg-census" ]; then
    _fmt_args+=("${PROFILE_ARGS[_i + 1]}" --pdflip-xchg-census-foreign); _i=$((_i + 1))
  fi
done
PROFILE_ARGS=("${_fmt_args[@]}")
unset _fmt_args _i

# ---- Hilfen: ein Basis-Flag an Ort und Stelle auf den Dual-Endwert setzen / entfernen (genau EIN Treffer, sonst Abbruch) --------------------
_dual_set_flag() {   # _dual_set_flag <flag> <altwert> <neuwert>
  local _n=0 _k
  for ((_k = 0; _k < ${#PROFILE_ARGS[@]}; _k++)); do
    if [ "${PROFILE_ARGS[_k]}" = "$1" ] && [ "${PROFILE_ARGS[_k + 1]}" = "$2" ]; then PROFILE_ARGS[_k + 1]=$3; _n=$((_n + 1)); fi
  done
  [ "$_n" = 1 ] || { echo "profiles/27b-nvfp4-dual.env: $1 $2 in der Basis nicht genau einmal gefunden ($_n)" >&2; exit 3; }
}
_dual_drop_flag() {   # _dual_drop_flag <flag-ohne-wert>
  local _o=() _k _n=0
  for ((_k = 0; _k < ${#PROFILE_ARGS[@]}; _k++)); do
    if [ "${PROFILE_ARGS[_k]}" = "$1" ]; then _n=$((_n + 1)); else _o+=("${PROFILE_ARGS[_k]}"); fi
  done
  [ "$_n" = 1 ] || { echo "profiles/27b-nvfp4-dual.env: $1 in der Basis nicht genau einmal gefunden ($_n)" >&2; exit 3; }
  PROFILE_ARGS=("${_o[@]}")
}

# ---- INSTRUMENT entfernt: --p-hostgap -----------------------------------------------------------------------------------------------------
# Das #PGAP-Instrument der Gruppe P (FLLIPER_PDFLIP_P_HOSTGAP=1: eine Zeile je Forward mit Karten-Idle und Host-Phasen, fuer den
# --p-host-overlap-A/B; Launcher-Help: "default off"). Reine Logzeilen, keine Verhaltensform -> im Dual-Release aus. (27b-base fuehrt es mit;
# das Flip-Release-Profil 27b-nvfp4 behaelt es.)
_dual_drop_flag --p-hostgap

# ---- Dual-Endwerte der Basis-Flags (Rig-Kette ueberschreibt sie schrittweise; hier nur der Endwert) --------------------------------------------
# --extra-p: P laeuft mit genau EINEM Request (dual1e 07:00Z: ein langer Prompt, PP3 pipelinet seine Chunks), P-Rang-Budgets in MiB je Rang
# (PP0 5090, PP1 3080 nvml0, PP2 3080 nvml2; dual1h GERECHNET, W64/PP-CUT am Rig geprueft) und --max-mamba-cache-size=8 (P haelt hoechstens 2 Requests).
_dual_p_seats=1   # EINE Quelle (Diaet W2): --p-bs und P --max-running-requests
_n=0
for ((_i = 0; _i < ${#PROFILE_ARGS[@]}; _i++)); do
  if [ "${PROFILE_ARGS[_i]}" = "--extra-p=--max-running-requests=2" ]; then
    PROFILE_ARGS[_i]="--extra-p=--max-running-requests=$_dual_p_seats --rank-gpu-memory-mib 8740,3000,3500 --max-mamba-cache-size=8"; _n=$((_n + 1))
  fi
done
[ "$_n" = 1 ] || { echo "profiles/27b-nvfp4-dual.env: --extra-p=--max-running-requests=2 nicht genau einmal gefunden ($_n)" >&2; exit 3; }
unset _n _i
_dual_set_flag --p-bs 1 "$_dual_p_seats"; unset _dual_p_seats
# Pro-Request-Deckel 131072 (dual1g; P-Pool virtuell 196608 per --dual-p-kv-max-tokens, D-Pool 1048576)
PROFILE_ARGS+=(--max-kv-per-request 131072)

# ---- P-Schnitt Dual: 45,10,9 / attn 11,2,3 (dual1h, MESSBASIERT gerechnet: +5,0 % D-idle, +9,4 % D-busy gegen 46,11,7; auch die makespan-Wahl des Launchers) ----
PROFILE_ARGS+=(--pp-stage-ratio 45,10,9 --pp-attn-stage-ratio 11,2,3)
PROFILE_ARGS+=(--dflash-draft-path "$PROFILE_DRAFT")

# ---- P-Chunk-Politik: dynamic wie 27b-nvfp4 (NVFP4-Stufenmodell als Datei), Decke aber 1024 statt 2048 (dual1e 07:00Z: halbiert die Transienten
# der Shell-Gathers, so haelt --dual-p-overhead-mib 2500 ~330 MiB Luft; halbiert auch die Zeitscheiben, hinter denen D wartet; Kosten ~+9 % je Token an PP0).
_profile_drop_p_chunk
if [ "$_p_chunk" = dynamic ]; then
  PROFILE_ARGS+=(--p-chunk-policy dynamic --p-chunk-max 1024 --p-chunk-model "$PROFILE_P_CHUNK_MODEL_NVFP4" --p-chunk-mscale nvfp4)
else
  PROFILE_ARGS+=(--p-chunk-max 1024)   # wie die Rig-Kette unter fixed: dual1e haengt --p-chunk-max 1024 unbedingt an
fi

# ---- rc10-Basis (aus 27b-nvfp4-rc10.env): D-Reshard wake (Vektor 98,19,19) + Prefill-Graph-Politik auto OHNE Kalibrier-Tabelle ----------------------
# Item 390 (03.10.): 27b-nvfp4.graphcal.json traegt pp_layer_ratio [49,8,7] (gemessen am Flip-Schnitt, graphcal_nvfp4 G/E 26.09.); der Dual-Schnitt
# ist 45,10,9 -> der Launcher meldete bei JEDEM Dual-Boot "PREFILL-GRAPH-CALIBRATION CUT-MISMATCH table=49,8,7 boot=45,10,9 -> fallback", verwarf die
# Tabelle und loeste den Schnitt ein zweites Mal ohne sie (Metall: Front-Log boot_weg2_dkr27bnvfp4dual1mpsleepbar1fs10030828_bd2e3bc22d, 08:28:20Z:
# "P-PREFILL-GRAPH-POLICY policy=auto captured=[512] calibration=none"). Die Tabelle war im Dual also nie wirksam. Darum hier ehrlich ohne:
# --p-prefill-graph-calibration ist gestrichen, der Endzustand ist derselbe wie am Metall (calibration=none, captured=[512], Hauptbucket Graph,
# keine Extra-Buckets, kein Graphcal-Overlay im Chunk-Plan), nur ohne die CUT-MISMATCH-Zeile und den doppelten Schnitt-Solve.
# Eine echte Dual-Kalibrierung braucht zwei Metall-Boots (G und E) auf Schnitt 45,10,9 mit docker/graphcal_eval.py -> dann Datei
# 27b-nvfp4-dual.graphcal.json (pp_layer_ratio [45,10,9]) und diese Flagge wieder setzen. Keine Tabelle fuer einen fremden Schnitt wiederverwenden.
# (pchunk.json traegt keinen Schnitt: CUT-UNKNOWN-Warnung wie auf der Rig-Kette, Tabelle wird benutzt.)
PROFILE_ARGS+=(--d-reshard wake)
PROFILE_ARGS+=(--p-prefill-graph-policy auto)

# ---- DUAL-TP3PP3 (dual1b..dual1m + psleep, Endwerte) -------------------------------------------------------------------------------------------
# --dual-share (impliziert --dual-layout): P rechnet auf D's TP3-Shards, D bootet als Union-Besitzer, P haelt nur das Diff.
# --dual-p-overhead-mib 2500: was P je Karte ausserhalb seines Budgets haelt (Kontext + Allokator + Workspaces); GEMESSEN 2170 bei 1024er Chunks (a3t5js), +330 Luft;
#   D wird aus P's Plan (Budget + 2500) bemessen. Der Launcher-Default 1500 war fuer MPS gedacht.
# --d-token-placement bandwidth: D traegt die Tokenverteilung der Serienlinie (neue Tokens nach Bandbreite, sonst Kapazitaet).
# --p-barlink-bar1-window-mib 16,PP_0=64: die 3080 hat 256 MiB BAR1, im Dual-Layout liegen ZWEI Gruppen darauf (P world 16 + pp 64, D 88, Treiber ~19).
# --draft-kv-on-p off: der Draft auf P existiert nur fuer den Flip (kalte Bytes); das Dual flippt nie -> spart 1548 MiB Gewichte + 10240 B/Token auf PP2.
# --dual-mps on: P und D-Kernels laufen gleichzeitig statt zu timeslicen (Messung 29.09.: D-All-Reduce unter P-Last ~0,08 ms statt 0,53-0,80 ms);
#   braucht FLLIPER_PDFLIP_DUAL_MPS_OPT_IN=1 (siehe Kopf, profile_form_env unten).
# --dual-p-sm-pct 100: P darf alle SMs belegen (Launcher-Default, explizit weil unter MPS die Wirkgroesse; dual1e).
# --dual-p-duty 1.0: PAUSENFREI (Nutzerentscheid 01.10.: Default ist pausenfrei; dual1i, die Drosselung 0,3/0,5 war Verlust). Launcher-Default 1.0, explizit.
# --dual-unified-kv on: EIN KV-Pool je Karte fuer P und D (card_kv_ledger.py); P-Pool virtuell 196608 Tokens, D-Pool 1048576 global.
# --dual-p-sleep on: D-PRIORITY Stufe 2 -- unter KV-Druck schlaeft P und parkt seine Gewichte im Systemram (Launcher-Default unter --dual-share ist im
#   y8p-Baum ON, hier ausdruecklich, damit ein aelterer Baum nicht stillschweigend ohne Schlaf bootet).
PROFILE_ARGS+=(
  --draft-kv-on-p off
  --dual-share
  --dual-p-overhead-mib 2500
  --d-token-placement bandwidth
  --p-barlink-bar1-window-mib "16,PP_0=64"
  --dual-mps on
  --dual-p-sm-pct 100
  --dual-p-duty 1.0
  --dual-unified-kv on
  --dual-p-kv-max-tokens 196608
  --dual-d-kv-max-tokens 1048576
  --dual-p-sleep on
)
unset -f _dual_set_flag _dual_drop_flag

# ---- FORM-Env: Basis + rc10-Fehlerfixes + MPS-Opt-in --------------------------------------------------------------------------------------------
eval "$(declare -f profile_form_env | sed '1s/^profile_form_env/_profile_form_env_27b_base_dual/')"
profile_form_env() {
  _profile_form_env_27b_base_dual
  # rc10 Fehlerfix Canon-Order (Zeile 24h): Rang-Bitgleichheit des oneshot-all_reduce (<= 64 KiB), Test bf16-Emulation rangfrei.
  # rc10 Fehlerfix Draft-Fenster DEDUP_CARRY (DK 7faa13dc1c): ~2046 Loecher je Runde in nvfp4dr-D-Logs.
  # rc10 Fehlerfix Census-O1-Evict (KR e54ac95c65): Desk 5,69 s -> 0,19 s, Inhalt/Reihenfolge gleich.
  # DUAL-MPS-Opt-in: der Launcher-Prozess prueft ihn (resolve_dual_layout), sonst "--dual-mps on is refused" (kw6pft/ndktv4/scjhru-S1-Wedge).
  # Der Baum traegt den Wurzelfix b855aecfd3 (BAR1 unter MPS ohne cooperative Full-Card-Grid). Ersetzt EXTRA_CENV der Rig-Boots.
  _form FLLIPER_PDFLIP_DUAL_MPS_OPT_IN 1
  # NICHT gesetzt (Metall-Probe, nie im Release): FLLIPER_PDFLIP_DUAL_P_SLEEP_PROBE_S.
}
