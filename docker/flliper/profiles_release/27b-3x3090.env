# shellcheck shell=bash
# PROFIL 27b-3x3090 (PLANER-3090 1021, HOCHRECHNUNG): Qwen3.8-27B INT8 W8A8 + DFlash2-W8-Draft, Flip P = PP3 / D = TP3, KV fp8, auf
# 3 x RTX 3090 (24576 MiB, sm86, 936 GB/s, PCIe 4.0 x16). Das Release-Profil 27b (Referenz-Rig 5090 + 2 x 3080, gleiche 72 GB) mit den
# Regeln des Profil-Planers fuer N gleiche Karten (pdflip/propose.py, PLANER-3090 1021); jede Zahl samt Herleitung im Bericht
# /spinning/gpu-arb/deskq/done/planer-3090-profile-1021.md.
#
# STATUS: nie auf einer 3090 gebootet. Der Launcher-Trockenlauf auf einem NVML-Replay von 3 x 3090 laeuft NUR MIT --force durch
# (outcome ok_with_force): die Rekorde des Profils qwen27b (P-Ueberstand, D-Ruhe-Rest, ms je Schicht, Census, Attention-Anker ...) sind
# auf dem Referenz-Rig gemessen und werden fuer die 3090 vom Arch-Zwilling 3080 GEBORGT (HW-UNCALIBRATED / HW-BORROWED).
# ERSTER START DARUM: docker run ... -e MODE=pdflip -e HTSGLANG_PROFILE=27b-3x3090 -e FLLIPER_FORCE=1 ; der erste Boot ist die Messung
# (Rekorde schreibt ein geforcter Boot NICHT, refusals.records_allowed). Vorher einmal: python -m flliper.srt.planner.card_rate_pass --run.
# Transport: bar1 (barlink) braucht den gepatchten nvidia-open 595.58.03 mit RMSmallBarP2PPeerBar1=1/PeerMappingOverride=1 (kartenplan_
# transport.FACTS["host"]); ohne ihn --transport nccl (Profil-Status PROFILE_NCCL_STATUS=unproven, nie mit der 27B-DFLASH-Form gebootet).
# Host: wie 27b -- PROFILE_MEMAVAIL_MIN_GIB=78, PROFILE_SHM_MIN_GIB=40 (Gewichtstausch ueber den Host); ein 3090-Host mit 64 GB reicht NICHT.
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/27b.env"
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/_3090_common.sh"
PROFILE_NAME=27b-3x3090
PROFILE_STATUS=hochrechnung   # Planer-Regel, keine Messung auf 3090; Abnahme erst nach Metall
PROFILE_OWNER="Profil-Planer PLANER-3090 1021 (Hochrechnung aus dem 27b-Release-Profil)"
PROFILE_GPUS="NVIDIA GeForce RTX 3090=3"
PROFILE_CARD_COUNT=3
PROFILE_INVENTORY="RTX3090,RTX3090,RTX3090"
_p3090_apply 3
eval "$(declare -f profile_form_env | sed '1s/^profile_form_env/_profile_form_env_3090_base/')"
profile_form_env() {
  _profile_form_env_3090_base
  _form FLLIPER_PDFLIP_L15_MIB "$P3090_L15_MIB"
}
