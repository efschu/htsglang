# shellcheck shell=bash
# PROFIL nf-4x3090 (NCARDS 1021, HOCHRECHNUNG): Qwen3.8-Flash-Next INT4 + MTP-Draft (NF), Flip P = PP4 / D = Form A TP4
# (Rang 0 = Attention-Host, die uebrigen Rang-Experten-Worker) auf 4 x RTX 3090 (24576 MiB, sm86, 936 GB/s, PCIe 4.0 x16).
# Das Release-Profil nf (Rig 5090 + 2 x 3080) mit den Planer-Werten fuer N gleiche Karten. DIE ZAHLEN STEHEN NICHT VON HAND HIER:
# der Block unten wird von tools/ncards_profile_gen.py aus propose() (pdflip/propose.py, Stufe A, Form flip) erzeugt, jede Zeile ist
# der Unterschied zwischen dem Rig-Profil nf.env und dem Vorschlag fuer diese Karten (Experten-Verteilung, residente Anteile, P-Schnitt,
# D-Kontext, Reserven). test_ncards_profiles_1021 erzeugt den Block neu und vergleicht (Drift = rot). Unverifizierte Eingaben des
# Vorschlags stehen als Kommentar im Block.
# STATUS: nie auf einer 3090 gebootet. Launcher-Trockenlauf auf einem NVML-Replay von 4 x 3090: ok_with_force (HW-UNCALIBRATED /
# HW-BORROWED, HW-COUNT); die Rekorde des Profils nextflash sind auf dem Rig gemessen und werden vom Arch-Zwilling 3080 GEBORGT.
# D-PRUEFUNG (Review 1021 A1): der D-Rechenweg des Launchers (FRACTION-SOLVE D, W122/W130) LAEUFT auf jeder Rangzahl -- fuer N != 3 mit der 3-Rang-Referenz fnFL2
# nach Rolle (Host / mittlerer / letzter Worker) auf N Raenge genommen, im Log benannt ("BORROWED BY RANK ROLE", UNMEASURED bei dieser Rangzahl). Der Planer rechnet
# die residente Fraction mit min(R + S, E) Zeilen gegen das Rangbudget, leitet den Host-Scratch aus dem Budget der Karte ab und bucht die Host-Differenz zu den
# Rollen-Rekorden des Launchers als benannten Posten (propose_rules.launcher_host_gap_mib). Ergebnis im Trockenlauf: W122/W130 PASST auf jedem Rang jeder Rangzahl.
# N = 4 (nfblock 1022, vorher D-BUDGET): D-EIGENTUM behaelt Form A (der Host haelt den KV, kein Token-Schnitt). In Form A sind die Worker-Experten
# (fast) alle resident; jeder Token-Schnitt nimmt Worker-Zeilen fuer KV und erhoeht ihre Fehlgriffe, die x1-Regel verwirft ihn. Vorher wurde das als
# "keine tragbare Form" verweigert, obwohl Form A alle Pruefungen (W122/W130/Pool-Schritt) besteht. Startbar (Hochrechnung).
# ERSTER START: FLLIPER_FORCE=1 (der erste Boot ist die Messung); vorher card_rate_pass --run. Host-Seite (Experten-Store im tmpfs, MEMAVAIL,
# SHM) haengt nicht an N und bleibt wie nf.env: der Store traegt alle Experten, die Karten halten nur den residenten Anteil.
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/nf.env"
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/_3090_common.sh"
PROFILE_NAME=nf-4x3090
PROFILE_STATUS=hochrechnung   # Planer-Rechnung, keine Messung auf 3090; Abnahme erst nach Metall
PROFILE_OWNER="Profil-Planer NCARDS 1021 (Hochrechnung aus dem nf-Release-Profil, N=4)"
PROFILE_GPUS="NVIDIA GeForce RTX 3090=4"
PROFILE_CARD_COUNT=4
PROFILE_INVENTORY="RTX3090,RTX3090,RTX3090,RTX3090"
# >>> ncards_profile_gen: basis=nf n=4 card=rtx3090-24 -- python tools/ncards_profile_gen.py --basis nf --n 4 --card rtx3090-24
# Planner outputs (pdflip/propose.py stage A, flip form), NOT measurements: every line below is HOCHRECHNUNG. Do not edit by hand;
# regenerate. Unverified inputs of this proposal (first boot = measurement, FLLIPER_FORCE=1):
#   - GEMM rates: datasheet/unverified: FP16 peak rate per card (no measured rate)
#   - --d-foreign-context-mib: Class maximum of the profile measurement nf.env [RTX5090,RTX3080,RTX3080] -> [RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86]: borrowe
#   - --d-nontorch-mib: Class maximum of the profile measurement nf.env [RTX5090,RTX3080,RTX3080] -> [RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86]: borrowed: RTX3
#   - host posts: the launcher's NF role records book 397 MiB more on the Form A host than the fn8ah-borrowed posts (KV cell 14143 B/token of the reference boot against 13056 B/token of the model profile, p
#   - Runtime items of form A (host 3.20 / worker 1.45 GiB, corridor 1.90, dispatch 0.20, router 0.12, speculative state 0.15) are the measured items of boot fn8ah: borrowed, unverified for this model and t
#   - resident share of rank 0,1,2,3 limited to the swap buffer (solver: 1.000,1.000,1.000,1.000, limit: 0.948,0.987,0.987,0.987): a rank with fewer than 2 scratch rows builds no buffer, the launcher refuse
#   - --pp-stage-ratio: Rule: layer cut of the P stages by GEMM rate and memory capacity for the cards [RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86]
#   - --pp-cut-expert-device-fraction: Rule: resident expert share per P stage from the rest of the stage for the cards [RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm
#   - --extra-p --rank-moe-resident-fraction: Rule: resident expert share per P stage from the rest of the stage for the cards [RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86,RTX3090/2457
#   - --env-p FLLIPER_MOE_RESIDENT_EXPERT_FRACTION: Rule: resident expert share per P stage from the rest of the stage for the cards [RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86,RTX309
#   - --pp-cut-expert-lru-rows: Profile nf.env: re-keyed by rank role (first/middle/last entry) to 4 cards; inventory of the profile [RTX5090,RTX3080,RTX3080], here [RTX3090/24576MiB/sm86,RTX3090/24576MiB/s
#   - --extra-d --rank-moe-ratio: Rule form A: expert ownership per D rank for the cards [RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86]
_p3090_set --d-foreign-context-mib 896,896,896,896
_p3090_set --d-nontorch-mib 1981,528,528,528
_p3090_set --pp-attn-stage-ratio 3,3,3,3
_p3090_set --pp-cut-expert-device-fraction 0.747,0.996,0.996,0.987
_p3090_set --pp-cut-expert-lru-rows 32,32,32,32
_p3090_set --pp-stage-ratio 12,12,12,12
_p3090_set --user-reserve-mib 0,0,0,0
_p3090_drop --wake-credit-reference-logs
_p3090_extra p --rank-moe-resident-fraction 0.747,0.996,0.996,0.987
_p3090_extra p --rank-user-reserve-mib 0,0,0,0
_p3090_env p FLLIPER_MOE_RESIDENT_EXPERT_FRACTION 0.747,0.996,0.996,0.987
_p3090_extra d --rank-moe-ratio 38,158,158,158
_p3090_extra d --rank-moe-resident-fraction 0.948,0.987,0.987,0.987
_p3090_extra d --rank-role host,worker,worker,worker
_p3090_extra d --rank-tp-ratio 1,0,0,0
_p3090_extra d --rank-user-reserve-mib 0,0,0,0
_p3090_env d FLLIPER_MOE_RESIDENT_EXPERT_FRACTION 0.948,0.987,0.987,0.987
_p3090_env d FLLIPER_MOE_SCRATCH_SLOTS 48,48,48,48
# <<< ncards_profile_gen
eval "$(declare -f profile_form_env | sed '1s/^profile_form_env/_profile_form_env_nf_base/')"
profile_form_env() {
  _profile_form_env_nf_base
  _p3090_form_apply
}
