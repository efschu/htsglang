# shellcheck shell=bash
# PROFIL nf-3x3090 (NCARDS 1021, HOCHRECHNUNG): Qwen3.8-Flash-Next INT4 + MTP-Draft (NF), Flip P = PP3 / D = Form A TP3
# (Rang 0 = Attention-Host, die uebrigen Rang-Experten-Worker) auf 3 x RTX 3090 (24576 MiB, sm86, 936 GB/s, PCIe 4.0 x16).
# Das Release-Profil nf (Rig 5090 + 2 x 3080) mit den Planer-Werten fuer N gleiche Karten. DIE ZAHLEN STEHEN NICHT VON HAND HIER:
# der Block unten wird von tools/ncards_profile_gen.py aus propose() (pdflip/propose.py, Stufe A, Form flip) erzeugt, jede Zeile ist
# der Unterschied zwischen dem Rig-Profil nf.env und dem Vorschlag fuer diese Karten (Experten-Verteilung, residente Anteile, P-Schnitt,
# D-Kontext, Reserven). test_ncards_profiles_1021 erzeugt den Block neu und vergleicht (Drift = rot). Unverifizierte Eingaben des
# Vorschlags stehen als Kommentar im Block.
# STATUS: nie auf einer 3090 gebootet. Launcher-Trockenlauf auf einem NVML-Replay von 3 x 3090: ok_with_force (HW-UNCALIBRATED /
# HW-BORROWED); die Rekorde des Profils nextflash sind auf dem Rig gemessen und werden vom Arch-Zwilling 3080 GEBORGT.
# N = 3 (bekannter Defekt, nicht verdeckt): das D-Budget des Launchers (W122/W130/D-EIGENTUM) verweigert die Planer-Verteilung, auch mit
# --force -- "groesste tragbare Fraction je Rang: keine, 0.553, 0.566"; der Planer-Regel fuer Form A fehlt dort ~5 GB je Rang. N = 2 und N = 4
# bestehen dieselbe Pruefung. Siehe /spinning/gpu-arb/deskq/done/planer-ncards-1021.md.
# ERSTER START: FLLIPER_FORCE=1 (der erste Boot ist die Messung); vorher card_rate_pass --run. Host-Seite (Experten-Store im tmpfs, MEMAVAIL,
# SHM) haengt nicht an N und bleibt wie nf.env: der Store traegt alle Experten, die Karten halten nur den residenten Anteil.
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/nf.env"
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/_3090_common.sh"
PROFILE_NAME=nf-3x3090
PROFILE_STATUS=blockiert-d-budget   # Launcher-D-Budget (W122/W130) verweigert die Planer-Verteilung auch mit --force (D-BUDGET): nicht startbar, siehe Kopf
PROFILE_OWNER="Profil-Planer NCARDS 1021 (Hochrechnung aus dem nf-Release-Profil, N=3)"
PROFILE_GPUS="NVIDIA GeForce RTX 3090=3"
PROFILE_CARD_COUNT=3
PROFILE_INVENTORY="RTX3090,RTX3090,RTX3090"
# >>> ncards_profile_gen: basis=nf n=3 card=rtx3090-24 -- python tools/ncards_profile_gen.py --basis nf --n 3 --card rtx3090-24
# Planner outputs (pdflip/propose.py stage A, flip form), NOT measurements: every line below is HOCHRECHNUNG. Do not edit by hand;
# regenerate. Unverified inputs of this proposal (first boot = measurement, FLLIPER_FORCE=1):
#   - GEMM rates: datasheet/unverified: FP16 peak rate per card (no measured rate)
#   - --d-foreign-context-mib: Class maximum of the profile measurement nf.env [RTX5090,RTX3080,RTX3080] -> [RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86]: borrowed: RTX3080 (unverified
#   - --d-nontorch-mib: Class maximum of the profile measurement nf.env [RTX5090,RTX3080,RTX3080] -> [RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86]: borrowed: RTX3080 (unverified); host
#   - --user-reserve-mib: Class maximum of the profile measurement nf.env [RTX5090,RTX3080,RTX3080] -> [RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86]: borrowed: RTX3080 (unverified); bo
#   - --extra-p --rank-user-reserve-mib: Class maximum of the profile measurement nf.env [RTX5090,RTX3080,RTX3080] -> [RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86]: borrowed: RTX3080 (
#   - --extra-d --rank-user-reserve-mib: Class maximum of the profile measurement nf.env [RTX5090,RTX3080,RTX3080] -> [RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86]: borrowed: RTX3080 (
#   - Runtime items of form A (host 3.20 / worker 1.45 GiB, corridor 1.90, dispatch 0.20, router 0.12, speculative state 0.15) are the measured items of boot fn8ah: borrowed, unverified for this model and t
#   - --pp-stage-ratio: Rule: layer cut of the P stages by GEMM rate and memory capacity for the cards [RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86]
#   - --pp-cut-expert-device-fraction: Rule: resident expert share per P stage from the rest of the stage for the cards [RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86]
#   - --extra-p --rank-moe-resident-fraction: Rule: resident expert share per P stage from the rest of the stage for the cards [RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86]
#   - --env-p FLLIPER_MOE_RESIDENT_EXPERT_FRACTION: Rule: resident expert share per P stage from the rest of the stage for the cards [RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86,RTX3090/24576MiB/sm86]
#   - --pp-cut-expert-lru-rows: Profile nf.env: re-keyed by rank role (first/middle/last entry) to 3 cards; inventory of the profile [RTX5090,RTX3080,RTX3080], here [RTX3090/24576MiB/sm86,RTX3090/24576MiB/s
_p3090_set --d-foreign-context-mib 896,896,896
_p3090_set --d-nontorch-mib 1981,528,528
_p3090_set --pp-attn-stage-ratio 4,4,4
_p3090_set --pp-cut-expert-device-fraction 0.511,0.718,0.691
_p3090_set --pp-stage-ratio 16,16,16
_p3090_drop --wake-credit-reference-logs
_p3090_extra p --rank-moe-resident-fraction 0.511,0.718,0.691
_p3090_env p FLLIPER_MOE_RESIDENT_EXPERT_FRACTION 0.511,0.718,0.691
_p3090_extra d --rank-moe-ratio 89,212,211
_p3090_extra d --rank-moe-resident-fraction 0.494,0.787,0.791
_p3090_env d FLLIPER_MOE_RESIDENT_EXPERT_FRACTION 0.494,0.787,0.791
# <<< ncards_profile_gen
eval "$(declare -f profile_form_env | sed '1s/^profile_form_env/_profile_form_env_nf_base/')"
profile_form_env() {
  _profile_form_env_nf_base
  _p3090_form_apply
}
