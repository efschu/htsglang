# shellcheck shell=bash
# PROFIL 27b-nvfp4-3x3090 (PLANER-3090 1021, HOCHRECHNUNG): Qwen3.8-27B NVFP4 (modelopt) + DFlash2-NVFP4-Draft, Flip P = PP3 / D = TP3,
# KV fp8, auf 3 x RTX 3090. sm86 hat keine FP4-Tensorkerne: die Gewichte laufen auf den INT8-Kernen (W4A8: E2M1 x 2 exakt in INT8, FP8-
# Blockskala je 16 im Epilog, Nutzerentscheid 25.09.) bzw. Marlin-FP4 W4A16 -- derselbe Pfad, den die 3080 des Referenz-Rigs heute fahren.
# Basis: Release-Profil 27b-nvfp4 + die Regeln des Profil-Planers fuer N gleiche Karten; der Rig-Schnitt 49,8,7 (5090-lastig) entfaellt,
# der Schnitt-Solver rechnet ihn (Trockenlauf: 22,21,21). Herleitung: /spinning/gpu-arb/deskq/done/planer-3090-profile-1021.md.
# STATUS/ERSTER START/TRANSPORT/HOST: wie 27b-3x3090.env (FLLIPER_FORCE=1 beim ersten Boot; Trockenlauf ok_with_force).
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/27b-nvfp4.env"
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/_3090_common.sh"
PROFILE_NAME=27b-nvfp4-3x3090
PROFILE_STATUS=hochrechnung
PROFILE_OWNER="Profil-Planer PLANER-3090 1021 (Hochrechnung aus dem 27b-nvfp4-Release-Profil)"
PROFILE_GPUS="NVIDIA GeForce RTX 3090=3"
PROFILE_CARD_COUNT=3
PROFILE_INVENTORY="RTX3090,RTX3090,RTX3090"
_p3090_apply 3
