# shellcheck shell=bash
# PROFIL 27b-7x3090 (RELEASE 1022, HOCHRECHNUNG, N=7): 7 x RTX 3090 = 168 GB, Flip P = PP7 / D = TP7.
# NCARDS 1021: der Launcher traegt N gleiche Karten (pdflip/launcher.py p_group_stages / _p_chunk_by_class, PROFILE_INVENTORY ist die
# Rig-Wahrheit): der Trockenlauf auf einer 7 x RTX 3090 NVML-Wiedergabe laeuft mit --force durch (HW-BORROWED/HW-UNCALIBRATED/HW-COUNT
# benannt; METAL-UNPROVEN: topology.PROVEN_CARD_COUNTS = (3,) bis ein Metallboot N einträgt). Erster Boot = Messung: FLLIPER_FORCE=1.
# Werte HOCHRECHNUNG (Sm86-3080-Messung + 3090-Datenblatt), Herleitung je Zeile: /spinning/gpu-arb/deskq/done/planer-ncards-1021.md.
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/27b.env"
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/_3090_common.sh"
PROFILE_NAME=27b-7x3090
PROFILE_STATUS=hochrechnung   # nie auf 3090 gebootet; Trockenlauf mit --force ok (N=7), METAL-UNPROVEN
PROFILE_OWNER="Profil-Planer PLANER-3090 1021 (Hochrechnung, N=7, Trockenlauf mit --force)"
PROFILE_GPUS="NVIDIA GeForce RTX 3090=7"
PROFILE_CARD_COUNT=7
PROFILE_INVENTORY="RTX3090,RTX3090,RTX3090,RTX3090,RTX3090,RTX3090,RTX3090"
_p3090_apply 7
eval "$(declare -f profile_form_env | sed '1s/^profile_form_env/_profile_form_env_3090_base/')"
profile_form_env() {
  _profile_form_env_3090_base
  _form FLLIPER_PDFLIP_L15_MIB "$P3090_L15_MIB"
}
