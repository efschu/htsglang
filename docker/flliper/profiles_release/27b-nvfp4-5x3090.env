# shellcheck shell=bash
# PROFIL 27b-nvfp4-5x3090 (RELEASE 1022, HOCHRECHNUNG, N=5): 5 x RTX 3090 = 120 GB, Flip P = PP5 / D = TP5.
# NCARDS 1021: der Launcher traegt N gleiche Karten (pdflip/launcher.py p_group_stages / _p_chunk_by_class, PROFILE_INVENTORY ist die
# Rig-Wahrheit): der Trockenlauf auf einer 5 x RTX 3090 NVML-Wiedergabe laeuft mit --force durch (HW-BORROWED/HW-UNCALIBRATED/HW-COUNT
# benannt; METAL-UNPROVEN: topology.PROVEN_CARD_COUNTS = (3,) bis ein Metallboot N einträgt). Erster Boot = Messung: FLLIPER_FORCE=1.
# Werte HOCHRECHNUNG (Sm86-3080-Messung + 3090-Datenblatt), Herleitung je Zeile: /spinning/gpu-arb/deskq/done/planer-ncards-1021.md.
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/27b-nvfp4.env"
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/_3090_common.sh"
PROFILE_NAME=27b-nvfp4-5x3090
PROFILE_STATUS=hochrechnung   # nie auf 3090 gebootet; Trockenlauf mit --force ok (N=5), METAL-UNPROVEN
PROFILE_OWNER="Profil-Planer PLANER-3090 1021 (Hochrechnung, N=5, Trockenlauf mit --force)"
PROFILE_GPUS="NVIDIA GeForce RTX 3090=5"
PROFILE_CARD_COUNT=5
PROFILE_INVENTORY="RTX3090,RTX3090,RTX3090,RTX3090,RTX3090"
_p3090_apply 5
