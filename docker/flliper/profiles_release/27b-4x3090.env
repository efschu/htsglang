# shellcheck shell=bash
# PROFIL 27b-4x3090 (PLANER-3090 1021, HOCHRECHNUNG, NICHT STARTFAEHIG im heutigen Baum): 4 x RTX 3090 = 96 GB, Flip P = PP4 / D = TP4.
# N != 3 ist ein EIGENER Strang (Code, keine Profilfrage): der Launcher-Trockenlauf verweigert auch mit --force W40 PdFlipPPCutRefused
# ("not one cut of 64 layers over 4 stages is priceable at all"); dahinter stehen die 3-Karten-Konstanten des Gewichtstauschs
# (weight_exchange_region.N_CARDS = 3, CROSS_PAIRS; topology.PROVEN_CARD_COUNTS = (3,), METAL-UNPROVEN fuer N != 3) und die
# Kreuzungspreise je Rig-Ordinal (PCIe-Breiten 8,4,8). Dieses Profil haelt die Planer-Regeln fuer N gleiche Karten fest, damit der
# Strang N != 3 ein Ziel hat; bis dahin fuer 4 x 3090 den Server-Modus (MODE=server, TP_SIZE=4) nehmen -- Werte im Bericht
# /spinning/gpu-arb/deskq/done/planer-3090-profile-1021.md.
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/27b.env"
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/_3090_common.sh"
PROFILE_NAME=27b-4x3090
PROFILE_STATUS=blockiert-n4   # Launcher N != 3 (W40 / Gewichtstausch 3 Karten), siehe Kopf
PROFILE_OWNER="Profil-Planer PLANER-3090 1021 (Hochrechnung, N != 3 blockiert)"
PROFILE_GPUS="NVIDIA GeForce RTX 3090=4"
PROFILE_CARD_COUNT=4
PROFILE_INVENTORY="RTX3090,RTX3090,RTX3090,RTX3090"
_p3090_apply 4
eval "$(declare -f profile_form_env | sed '1s/^profile_form_env/_profile_form_env_3090_base/')"
profile_form_env() {
  _profile_form_env_3090_base
  _form FLLIPER_PDFLIP_L15_MIB "$P3090_L15_MIB"
}
