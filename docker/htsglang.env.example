# htsglang compose environment — copy to `.env` next to the compose file you
# use and edit the paths.
#
#   cp docker/htsglang.env.example .env
#   docker compose -f docker/htsglang.yml up
#
# Variables marked REQUIRED have no default; compose refuses to start without
# them. Everything else may be left empty, in which case the corresponding
# flag is omitted and sglang's own default applies.

# ---------------------------------------------------------------------------
# image and container
# ---------------------------------------------------------------------------
HTSGLANG_IMAGE=htsglang:cu130-nccl2307
CONTAINER_NAME=htsglang
GUI_CONTAINER_NAME=htsglang-gui
NODE2_CONTAINER_NAME=htsglang-node2
RESTART_POLICY=no
# Publish the API here. Keep it on loopback unless the LAN is trusted —
# sglang has no authentication.
BIND_HOST=127.0.0.1
PUBLISH_PORT=30000
PLANNER_PUBLISH_PORT=8780
RIGMON_PUBLISH_PORT=8770
# /dev/shm for NCCL and CUDA IPC. Too small -> multi-rank boots hang or die in
# the first collective.
SHM_SIZE=16gb
# Cold model load + cold flashinfer cache can take minutes; the healthcheck
# must not fire before that.
HEALTH_START_PERIOD=600s

# ---------------------------------------------------------------------------
# GPUs
# ---------------------------------------------------------------------------
# `all`, or an explicit list like `0,1,2`, or GPU UUIDs. Note this is the
# CONTAINER-visible set; RANK_GPU_ID below indexes into it.
NVIDIA_VISIBLE_DEVICES=all
# `utility` is what provides nvidia-smi/NVML. Read-only NVML works in a
# container; clock and power control do not, at any privilege level.
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ---------------------------------------------------------------------------
# mount points (host side)
# ---------------------------------------------------------------------------
# REQUIRED. The main model tree, mounted read-only at /models.
MODEL_DIR=/spinning/llm_stuff/models-cache
# The draft/speculative model. A separate variable on purpose — draft
# checkpoints often live on a different disk. Defaults to MODEL_DIR.
# Mounted at /draft.
DRAFT_MODEL_DIR=
# Chat templates and other swappable jinja assets, mounted at /templates. The
# froggeric v21.3 template is baked into the image and needs no mount.
TEMPLATE_DIR=./templates

# --- state that must survive a restart -------------------------------------
# HiCache L3 disk tier. Missing -> falls back to /tmp inside the container and
# is lost on recreate.
HICACHE_DIR=./state/hicache
# Hibernate (#89) per-rank weight shards. Missing -> every boot is a cold load.
# The shards are rank-indexed: one directory per node and per rank layout.
HIBERNATE_DIR_HOST=./state/hibernate
# ~/.cache/sglang: hw_profile-*.json (NVML rig probe), kv_budget-*.json (the
# MEASURED KV budget one boot writes for the next), planner_profiles.json,
# graph_mem_anchors.json, power_profile.json, quality_shots.jsonl,
# gguf_headers/, rigmon/node_tokens.json.
# Missing -> re-probe and re-derive on every boot.
SGLANG_CACHE_DIR=./state/sglang-cache
# flashinfer JIT cubins. Missing -> minutes of recompilation per cold start.
FLASHINFER_CACHE_DIR=./state/flashinfer
# The HiCache page-hash C++ extension, JIT-compiled against openssl/sha.h.
TORCH_EXT_CACHE_DIR=./state/torch-extensions
# Triton kernel cache. Matters most on sm75 and on Triton attention backends.
TRITON_CACHE_DIR_HOST=./state/triton
LOG_DIR=./state/logs
# GUI mode only: /tmp inside the container, where the planner's supervisor
# writes sglang_boot_<port>.log and where the graph-memory scraper reads them
# back. The path is hardcoded in GUI mode.
PLANNER_LOG_DIR=./state/planner-logs
# GUI mode only: the planner's result stores, which the code otherwise writes
# INSIDE the installed package (measured_results.jsonl, hicache_savings.json).
PLANNER_RESULTS_DIR=./state/planner-results

# ---------------------------------------------------------------------------
# model and identity (container-side paths)
# ---------------------------------------------------------------------------
# REQUIRED. Model directory, or the .gguf FILE for GGUF.
MODEL_PATH=/models/Qwen3.6-27B-AEON-Ultimate-Uncensored-FP8-MTP
SERVED_MODEL_NAME=qwen3.6-27b
# GGUF needs this: the sibling directory holding config.json + tokenizer.
TOKENIZER_PATH=
# auto | gguf | hibernate | sharded_state | dummy | remote | ...
LOAD_FORMAT=
# gguf | fp8 | compressed-tensors | awq | gptq | ...
QUANTIZATION=
# auto | bfloat16 | float16. sm75 (Turing) has no bf16 — use float16 there.
DTYPE=
CONTEXT_LENGTH=32768
CHAT_TEMPLATE=/etc/htsglang/chat_template.jinja
REASONING_PARSER=
TOOL_CALL_PARSER=
# 1 executes model code from the checkpoint. Off by default.
TRUST_REMOTE_CODE=0

# ---------------------------------------------------------------------------
# tensor parallelism — even, uneven, and co-located
# ---------------------------------------------------------------------------
TP_SIZE=1
# One physical GPU id per rank. Duplicates co-locate ranks on one GPU and
# require NCCL >= 2.30 (bundled). Example for 5090 + 2x3080: 0,1,2
RANK_GPU_ID=
# Proportional shards for mismatched cards. `auto` derives the ratio from free
# VRAM; or give it explicitly, e.g. 4,3,3.
RANK_TP_RATIO=
# Headroom left on each GPU in ratio mode.
RANK_AUTO_RESERVE_MIB=2048
# Absolute per-rank budget in MiB. REQUIRED for co-location; mutually
# exclusive with the ratio/reserve pair (the entrypoint clears them for you).
RANK_GPU_MEMORY_MIB=
# KV token split across ranks: capacity | speed | an explicit vector.
RANK_KV_RATIO=
RANK_MLP_RATIO=
RANK_MOE_RATIO=
RANK_VOCAB_RATIO=
# Decode context parallel size.
DCP_SIZE=
# MLP self-calibration vector. The first boot logs a suggestion; set it here
# and restart to get the full KV pool.
SGLANG_UNEVEN_MLP_VECTOR=

# ---------------------------------------------------------------------------
# kv cache and speculative decoding
# ---------------------------------------------------------------------------
KV_CACHE_DTYPE=auto
# Stock global memory fraction. Ignored once RANK_GPU_MEMORY_MIB or
# RANK_TP_RATIO is set.
MEM_FRACTION_STATIC=
# NEXTN | EAGLE | EAGLE3 | DFLASH | ...
SPECULATIVE_ALGORITHM=
SPECULATIVE_NUM_STEPS=3
SPECULATIVE_EAGLE_TOPK=1
SPECULATIVE_NUM_DRAFT_TOKENS=4
# Usually a path under /draft. For Qwen3.5/3.6 GGUF the MTP layer is inside
# the main .gguf, so point this at the same file as MODEL_PATH.
SPECULATIVE_DRAFT_MODEL_PATH=

# ---------------------------------------------------------------------------
# caches and offload
# ---------------------------------------------------------------------------
ENABLE_HIERARCHICAL_CACHE=0
HICACHE_STORAGE_BACKEND=file
HICACHE_RATIO=0.5
HICACHE_MEM_LAYOUT=page_first_direct
# Hibernate (suspend-to-disk of the per-rank weight shards). The fork requires
# --hibernate-dir and --enable-weights-disk-backup TOGETHER, so set both of
# these or neither.
#   HIBERNATE_ENABLE=1
#   HIBERNATE_DIR=/var/lib/htsglang/hibernate     <- CONTAINER path
# The host side of that mount is HIBERNATE_DIR_HOST above.
HIBERNATE_ENABLE=
HIBERNATE_DIR=
ENABLE_KV_SESSION_OFFLOAD=
KV_SESSION_OFFLOAD_HOST_RAM_GIB=

# ---------------------------------------------------------------------------
# sizing and observability
# ---------------------------------------------------------------------------
MAX_RUNNING_REQUESTS=8
# flashinfer | triton | torch_native. Turing and gfx900 need triton or
# torch_native for the paths sgl-kernel does not cover.
ATTENTION_BACKEND=
# 1 on rigs without GPUDirect P2P — this one has none, all links are PHB.
DISABLE_CUSTOM_ALL_REDUCE=1
# 1 disables CUDA graphs (emits sglang's --disable-cuda-graph; sglang has no
# --enforce-eager, that is vLLM's spelling). Mandatory with HTCCL.
ENFORCE_EAGER=
ENABLE_METRICS=1
LOG_LEVEL=info
# Anything the entrypoint does not model. Word-split, no quoting support.
EXTRA_ARGS=

# ---------------------------------------------------------------------------
# GUI mode (docker/htsglang-gui.yml)
# ---------------------------------------------------------------------------
# Container-side model roots the planner UI scans, os.pathsep-separated.
SGLANG_MODEL_ROOTS=/models:/draft
PLANNER_ARGS=--results-store /var/lib/htsglang/planner-results/measured_results.jsonl
# For the UI's model-download button. Public repos need no token.
HF_TOKEN=

# ---------------------------------------------------------------------------
# second node (docker/htsglang-node2.yml)
# ---------------------------------------------------------------------------
NNODES=2
NODE_RANK=1
# REQUIRED on the second node: <head-rig-ip>:<port>, reachable from both.
DIST_INIT_ADDR=192.168.0.10:20000
# The model on the SECOND rig. Either a local copy or the mountpoint of an
# NFS/SMB export from the head rig — sglang reads it from disk either way, it
# never receives weights over the process group. See the header of
# docker/htsglang-node2.yml for the cost comparison.
NODE2_MODEL_DIR=/spinning/llm_stuff/models-cache
NODE2_DRAFT_MODEL_DIR=
# Container-side path; defaults to MODEL_PATH, which is right when both rigs
# mount the tree at the same place.
NODE2_MODEL_PATH=
NODE2_NVIDIA_VISIBLE_DEVICES=all
NODE2_SGLANG_CACHE_DIR=./state/node2-sglang-cache
NODE2_FLASHINFER_CACHE_DIR=./state/node2-flashinfer
NODE2_TORCH_EXT_CACHE_DIR=./state/node2-torch-extensions
NODE2_TRITON_CACHE_DIR=./state/node2-triton
NODE2_HIBERNATE_DIR=./state/node2-hibernate
NODE2_EXTRA_ARGS=
# RDMA device node. Comment the `devices:` entry out entirely if this rig has
# no RoCE NIC.
IB_DEVICE=/dev/infiniband
# Host-staged cross-vendor collectives. 1 to enable.
SGLANG_HTCCL=
SGLANG_HTCCL_TRANSPORT=ucx
# Point at a matching libucp.so.0 if you do not use the image's own UCX. Both
# rigs must run the same UCX release.
SGLANG_HTCCL_UCX_LIB=
UCX_TLS=rc,self,sm
UCX_IB_GID_INDEX=3
# The RoCE port, e.g. mlx5_0:1
UCX_NET_DEVICES=
