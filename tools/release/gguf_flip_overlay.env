# shellcheck shell=bash
# ======== GGUF-FLIP-OVERLAY (NF-GGUF Stufe B, 14.10.2026, Planer-Implementierer ggufb) ========
# Wird von tools/release/gguf_flip_profile.py ANS ENDE des NF-Dauerstand-Profils kopiert
# (nf-int4-h6-abl-xc-w3sp-mlr-hl-vw.env, Image int24f8) und macht daraus die GGUF-FLIP-Form:
# P = PP3 mit GGUF-Gewichten, D = TP3 Form A, Flip family, Lanes/Void-Pass (Code-Default an), STRICT=0, MTP aus dem GGUF.
# Es ersetzt NICHTS im Dauerstand-Profil (eigene Datei, eigener Name): es ist exakt das, was profconv/nf-gguf.env
# auf nf.env anwendet (Entscheide dort einzeln), nur auf die Dauerstand-Form und in der Schreibweise des Rigs
# (SGLANG_*, --weg2-*) statt der fLLiper-Schreibweise der Quellen.
#
# JEDE Aenderung gegen den Dauerstand (nichts anderes wird angefasst):
#   PROFILE_NAME / FORM / FORMAT / STATUS   nf-gguf-flip-int24f8 / +gguf-flip / gguf / experimentell (der Entrypoint verlangt
#                              HTSGLANG_ALLOW_EXPERIMENTAL=1; nf_dauer_loop_v2.sh setzt es)
#   --model                    = Teil 1 (.gguf-Datei im Sibling-Verzeichnis), dazu --tokenizer-path = Sibling-Verzeichnis (ohne: W163)
#   --weg2-vision              off (kein mmproj im GGUF-Ordner; sonst transient -> W-Verweigerung)
#   --weg2-vision-place weights  GESTRICHEN (-vw verdraengt den Vision-Turm; mit vision off verweigert vision_stage_knobs_refusal W111)
#   --weg2-xchg-census         + --weg2-xchg-census-foreign (der Census ist der des INT4-Layouts; ein GGUF-Boot misst seinen eigenen)
#   PROFILE_DRAFT              = die shared-MTP-GGUF-DATEI im Draft-Verzeichnis (tools/release/make_nf_gguf_draft_dir.sh; Datei, nie
#                              Verzeichnis: check_gguf_file), ersetzt in --extra-p UND --extra-d UND --env-*
#   NF_STORE_DIR               /mnt/nf-experts/gguf (eigenes Store-Verzeichnis je Format, nie zwei Stores zugleich); ersetzt in
#                              --env-p/--env-d (dort steht der alte Pfad schon ausgeschrieben)
#   SGLANG_HC_MIXER_INT8       aus profile_form_env GESTRICHEN und 0 (der GGUF-Lader dequantisiert die Q8_0-Hyper-Connection-Mixer
#                              zu bf16-Linear und verweigert SGLANG_HC_MIXER_INT8, gguf_qwen4exp.build_name_map)
#   --served-model-name        Qwen3.8-Flash-Next-GGUF an --extra-p und --extra-d (sonst der DATEINAME ...-00001-of-00003.gguf;
#                              dasselbe wie nf-gguf-d, G8)
#   SGLANG_WEG2_LANES=1 / SGLANG_WEG2_PP_VOID_PASS_ENABLE=1  ausdruecklich an (global, P; Lanes auch D); Code-Default ist schon an, siehe Block unten
#   --d-residency-reference-logs / --d-residency-reference-seats 6   das D-Log des ersten GGUF-READY (Stufe A Versuch 6, 13.10. 12:03Z, Image
#                              int24egguf16): OHNE ein D-Log DIESER Form entfaellt der ganze D-FRACTION-SOLVE ("die eingebaute Referenz gilt fuer das
#                              INT4-Modell", launcher.py _reference_for) und damit Eigentums-Solve, KV-Stufen und Sitztabelle; unter --d-kv-token-cut owned
#                              verweigert der Flip-Boot dann #239 S3h ("KV-Worker ohne Trim-Zelle"). Das Log traegt 6 Sitze (--max-running-requests 6).
#                              Pfad im Container: $SGLANG_WEG2_EVIDENCE_DIR (= /var/lib/htsglang/evidence, Mount von docker-acceptance/nf/evidence).
#   SGLANG_WEG2_DENSE_REPACK_OUTSIDE_POOL=0 in --env-d   der Zustand, in dem dieses Log gemessen ist ("H39 aus"): ein GGUF-Boot hat keinen Dense-Repack
#                              (kein Leser dieser Env in layers/quantization/gguf.py; nur modelopt_quant, fp8, compressed_tensors_wNa16), der Planer
#                              waehlt die Referenz aber nach dem Zustand (_boots_dense_repack_state) und verwirft sonst das Log. Laufzeitwirkung fuer GGUF: keine.
#   --d-kv-token-cut           $NF_GGUF_D_KV_TOKEN_CUT (Default owned = Dauerstand); "off" ist der benannte Ausweg, falls der erste Flip-Boot den Eigentums-Solve
#                              nicht tragen soll (kein Solve, kein Token-Schnitt; D traegt dann den vollen KV je Rang -- unbelegt fuer GGUF)
#   PROFILE_REQUIRED_PATHS     GGUF-Form: Sibling, Teil 1, Tokenizer, Draft-Verzeichnis/-Datei/-config, Census, Korridor, Wake-Referenzen;
#                              OHNE Store-Verzeichnis (/mnt/nf-experts ist im Container ein frisches tmpfs, preflight_model laeuft vor
#                              preflight_state: ein "erforderlicher" Store-Pfad kann nie existieren, G13)
# UNVERAENDERT UEBERNOMMEN, fuer GGUF UNBELEGT (am Metall nie gemessen; nichts hier gerechnet): NF_FR_P / NF_FR_D / NF_SCRATCH_D,
# --pp-stage-ratio 29,11,8 (der Planer rechnet je Layer, Schnitt 29/11/8 bleibt: G5 "P-CUT UNCALIBRATED gguf"),
# --d-foreign-context-mib / --d-nontorch-mib, PROFILE_TMPFS_GIB 72 / PROFILE_MEMAVAIL_MIN_GIB 88 (INT4-Werte; Host-RAM = warnen,
# nicht verweigern), --disable-cuda-graph in --extra-p (P eager bis die GGUF-MMQ-Kernel im P-Graphen belegt sind).
# NICHT geliefert (Code, nicht Profil): D-Store-Adopt fuer GGUF (G4: jeder D-Rang liest seine Experten selbst), PLE-pread/Prefetch fuer
# die GGUF-Tabelle (SGLANG_QWEN4_PLE_CKPT_GATHER=pread und SGLANG_WEG2_PLE_DECODE_PREFETCH stehen im Dauerstand, ihr GGUF-Pfad ist
# ungelesen), X-Kurven (NF_XC_CURVE bleibt aus: Kurve ist INT4-geeicht).

_gf_mc=/spinning/llm_stuff/club-3090/models-cache
_gf_old_model=$PROFILE_MODEL
_gf_old_draft=$PROFILE_DRAFT
_gf_old_store=$NF_STORE_DIR
_gf_name=Qwen3.8-Flash-Next-GGUF

PROFILE_NAME=nf-gguf-flip-int24f8
PROFILE_FORM="$PROFILE_FORM+gguf-flip"
PROFILE_FORMAT=gguf
PROFILE_STATUS=experimentell
PROFILE_PLACEHOLDER=0
PROFILE_OWNER="NF-GGUF Stufe B (Plan PLAN-GGUF-NF-1009, ggufb 14.10.): Dauerstand int24f8 + GGUF-Flip-Overlay; am Metall ungebootet"
PROFILE_SIBLING="${NF_GGUF_SIBLING:-$_gf_mc/Qwen3.8-Flash-Next-GGUF-unsloth-sibling}"          # make_nf_gguf_sibling.sh
PROFILE_MODEL="$PROFILE_SIBLING/Qwen3.8-Flash-Next-UD-IQ4_XS-00001-of-00003.gguf"
PROFILE_TOKENIZER="$PROFILE_SIBLING"
PROFILE_DRAFT_DIR="${NF_GGUF_DRAFT_DIR:-$_gf_mc/Qwen3.8-Flash-Next-GGUF-unsloth-draft}"        # make_nf_gguf_draft_dir.sh
PROFILE_DRAFT="${HTSGLANG_DRAFT:-$PROFILE_DRAFT_DIR/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf}"
# das D-Log des ersten GGUF-READY (siehe Kopf); Container: Evidence-Mount, Host: /spinning/docker-acceptance/nf/evidence
PROFILE_D_REF_LOG="${NF_GGUF_D_REF_LOG:-${SGLANG_WEG2_EVIDENCE_DIR:-/var/lib/htsglang/evidence}/boot_weg2_dkrnfdggufdbar110131203_12b375f3dc_1013_120342.D.log}"
NF_STORE_DIR=/mnt/nf-experts/gguf
PROFILE_REQUIRED_PATHS=(
  "$PROFILE_SIBLING"
  "$PROFILE_MODEL"
  "$PROFILE_TOKENIZER/config.json"
  "$PROFILE_TOKENIZER/tokenizer.json"
  "$PROFILE_DRAFT_DIR"
  "$PROFILE_DRAFT"
  "$PROFILE_DRAFT_DIR/config.json"
  "$PROFILE_D_REF_LOG"
  "$PROFILE_CENSUS"
  "$PROFILE_CORRIDOR"
  "$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.P.log"
  "$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.D.log"
  "$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.front.log"
)

# EXPLIZIT AN (Nutzerorder 14.10. "neue Features immer eingeschaltet"; Auftrag Stufe B: Lanes an, Void-Pass an, STRICT 0):
#   SGLANG_WEG2_LANES=1            Prioritaets-Lanes (Code-Default im Baum an, environ.py EnvBool(True); hier ausdruecklich, global + P + D wie
#                                  done/lanes-default-profil-delta-1013.patch fuer den Dauerstand)
#   SGLANG_WEG2_PP_VOID_PASS_ENABLE=1  Void-Pass der PP-Gruppe auf der traegerlosen NF-P-Form (Code-Default an; global + P)
#   SGLANG_ENABLE_STRICT_MEM_CHECK_DURING_IDLE=0  steht schon im Dauerstand (P und D) und bleibt (Nutzerwort)
export SGLANG_WEG2_LANES=1
export SGLANG_WEG2_PP_VOID_PASS_ENABLE=1
NF_ENV_P="$NF_ENV_P;SGLANG_WEG2_LANES=1;SGLANG_WEG2_PP_VOID_PASS_ENABLE=1"
NF_ENV_D="$NF_ENV_D;SGLANG_WEG2_LANES=1;SGLANG_WEG2_DENSE_REPACK_OUTSIDE_POOL=0"
for _gf_e in "${!PROFILE_ARGS[@]}"; do
  case "${PROFILE_ARGS[$_gf_e]}" in
    --env-p) PROFILE_ARGS[$((_gf_e+1))]="$NF_ENV_P" ;;
    --env-d) PROFILE_ARGS[$((_gf_e+1))]="$NF_ENV_D" ;;
  esac
done
unset _gf_e

_gf_args=()
for ((_gf_i = 0; _gf_i < ${#PROFILE_ARGS[@]}; _gf_i++)); do
  _gf_a=${PROFILE_ARGS[_gf_i]}
  case "$_gf_a" in
    --model) _gf_args+=(--model "$PROFILE_MODEL" --tokenizer-path "$PROFILE_TOKENIZER"); _gf_i=$((_gf_i + 1)) ;;
    --weg2-vision) _gf_args+=(--weg2-vision off); _gf_i=$((_gf_i + 1)) ;;
    --weg2-vision-place) _gf_i=$((_gf_i + 1)) ;;       # nur mit einer Vision-Stufe sinnvoll; hier gestrichen (W111)
    --d-kv-token-cut) _gf_args+=(--d-kv-token-cut "${NF_GGUF_D_KV_TOKEN_CUT:-owned}"); _gf_i=$((_gf_i + 1)) ;;
    --weg2-xchg-census) _gf_args+=(--weg2-xchg-census "${PROFILE_ARGS[_gf_i + 1]}" --weg2-xchg-census-foreign); _gf_i=$((_gf_i + 1)) ;;
    *)
      _gf_a=${_gf_a//"$_gf_old_draft"/"$PROFILE_DRAFT"}
      _gf_a=${_gf_a//"$_gf_old_model"/"$PROFILE_MODEL"}
      _gf_a=${_gf_a//"$_gf_old_store"/"$NF_STORE_DIR"}
      # das Gruppen-Extra des Launchers traegt --served-model-name VOR den --extra-p/-d-Woertern: das spaetere gewinnt (argparse)
      if ((_gf_i > 0)); then
        case "${PROFILE_ARGS[_gf_i - 1]}" in
          --extra-p|--extra-d) _gf_a="$_gf_a --served-model-name $_gf_name" ;;
        esac
      fi
      _gf_args+=("$_gf_a") ;;
  esac
done
PROFILE_ARGS=("${_gf_args[@]}" --d-residency-reference-logs "$PROFILE_D_REF_LOG" --d-residency-reference-seats 6)
unset _gf_args _gf_a _gf_i _gf_old_model _gf_old_draft _gf_old_store _gf_mc _gf_name

# FORM: die des Dauerstands, ohne SGLANG_HC_MIXER_INT8 (siehe oben; `_form` kennt kein Ueberschreiben: eine zweite Zeile derselben
# Variable wuerde als FORM-OVERRIDE gemeldet und den ersten Wert behalten), plus der GGUF-Wert 0.
eval "$(declare -f profile_form_env | grep -v 'SGLANG_HC_MIXER_INT8' | sed '1s/^profile_form_env/_profile_form_env_nf/')"
profile_form_env() {
  _profile_form_env_nf
  _form SGLANG_HC_MIXER_INT8 0                                    # GGUF: Mixer als bf16-Linear (Lader dequantisiert Q8_0)
}
