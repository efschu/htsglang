# NF-Sitz, 25.09.2026: Profil nf-nvfp4-d = nvidia Qwen3.8-Flash-Next-NVFP4 im REINEN D-LAYOUT (Nutzer-Order ueber 27B:
# "der nf nvfp4 boot koennte ggf. nicht funktionieren mit flip, wegen zu wenig systemram. dann nur einen test im reinen D
# layout - reiner drei rank betrieb dort kurz zeigen"). Nur Gruppe D (TP3 Form A), KEIN P, KEIN Flip, KEINE Front:
# Clients sprechen D direkt auf Port 30032, D prefillt jede Laenge selbst (W50 = 262144).
# ERZEUGT von make_nf_nvfp4_d.py als eigenstaendige Kopie von nf.env.x177 (NICHT einlesen und ueberschreiben: die Basis
# baut PROFILE_ARGS und NF_ENV_* beim Einlesen). Ersetzt: PROFILE_MODEL, PROFILE_FORMAT/STATUS/FORM/OWNER, NF_FR_D,
# NF_SCRATCH_D, NF_STORE_DIR, PROFILE_MEMAVAIL_MIN_GIB, PROFILE_TMPFS_GIB; neu: PROFILE_D_ONLY, PROFILE_SERVE_PORT,
# --d-only in PROFILE_ARGS.
#
# Code: rc2.1l = d1c7094ba6 (desk/nf-rc2.1l-0926; Metall-Form unten auf rc2.1b = 5723c43fd3). Metall: fnNV4d1 (25.09. 11:01-11:10Z, Bootbaum 479af24ea8 = rc2.1b ohne H86; H86 greift in
# D-only nicht). D READY 186 s; Nadeln 4/4 MATCH; Decode Code 81,9/82,8, Prosa 69,7, Thinking 73,9 tok/s;
# 0 Traceback/W50/W53/413/Watchdog; Host-RAM-Spitze 76,2 GiB nonreclaim (anon 20,8 + shmem 54,2; Store 46G).
# PREFILL-GRENZE: vielfaeltiger Text (12,6k Code) ~160 tok/s (expert-major prefill, 0,43 GiB H2D je Schicht, D-Residenz
# 5090 6 %); die ~1.000 tok/s der 97k-Nadel gelten nur fuer wiederholten Text. D-only = Decode-/Kurzprompt-Betrieb.
# Status: Formnachweis (Nutzer: NVFP4 "nur grundsaetzlich zeigen", keine Optimierung).
# shellcheck shell=bash
# Profil nf, FORM x177 -- Qwen3.8-Flash-Next INT4 + MTP-Draft (NF-Linie), pdflip-Flip P=PP3 / D=Form A TP3.
# ENTWURF NF-Sitz (Agent H83), 25.09.2026. NEUE Datei neben Rs profiles/nf.env (x163-Stand aus NF_PROFILE.md §11.1);
# Rs Datei bleibt unberuehrt. Uebernahme: diese Datei als profiles/nf.env einsetzen (R/Operator). Delta mit Belegen:
# /spinning/gpu-arb/docker/NF_PROFILE_x177_DELTA.md.
#
# HERKUNFT (die Form steht im ARM, nie im Starter-Env):
#   Arm-Kette  ARB/pdflip/boot_nf_bestform_0925_x177.sh (Bestform-Arm des NF-Sitzes)
#              -> Arm-Wrapper des NF-Sitzes (FR_P/FR_D, Coredump-Env) -> ARB/pdflip/arm_fnFL2_long.sh Z.321 (LARGS)
#   Metall     fnFL2x177, Bootbaum 09729d97c4, 25.09. 04:46-04:53Z, Launcher-Log EVID/fnFL2x177_09729d97c495_0925_044618.log:
#              group P argv Z.175, PDFLIP-GROUP-ENV P Z.220 / D Z.221, group D argv Z.222, front argv Z.235.
#              Ergebnis (Arm-Protokoll fnFL2x177): Nadeln MATCH (97 841 Tok Z.31), Code 120,4/131,9, Prosa 91,3, Thinking
#              105,7 tok/s (Z.46-49), Burst 8x4,2k 22,80 s 8/8 (Z.53/63); P 97k 24,47 s, Flips 2,0-2,44 s, 97k-Flip 3,04 s
#              (Bestform-Kopf Z.1).
#   Release    NF-RC2 c5a5407a7c (Freeze erst nach den Boots f3/x178) = d93a17316b (NF-RC1) + H81 (4fb67489f2 Arena-
#   RC2-STAND 25.09. ~08:10Z: b89592806a = c5a5407a7c + H84 X-Fix (890b655dc4 D meldet pdflip_prefill_s, b89592806a r_D ehrlich + X-Decke --x-ceiling-tokens + Einzelgaenger-Sperre); Nutzer-Order 'X-Fix einbauen im docker'. Metallbeweis f3/x178 GRUEN (25.09. 08:15Z), RC2 eingefroren + gepusht desk/nf-rc2-0925.
#   RC2.1 25.09. 08:58Z: fd3ad2e326 = b89592806a + FLLIPER_PINNED_HOST_RESERVE_GIB (Pinned-Host-Reserve per Env, Default 10 = nativ byte-gleich); der Container setzt 2 (profile_form_env) -- NF-Host-Abnahme 82g: 413 durch 0 nutzbare Reserve. Gepusht desk/nf-rc2.1-0925.
#   RC2.1l 26.09. 08:44Z: d1c7094ba6 (desk/nf-rc2.1l-0926) = rc2.1k 2eed285057 + H99 (Form-A-Worker enthalten sich im Span des #580-Prefetch-Votes); Kette rc2.1h..l = H93/H96/H97/H98/H99 (Rang-Einigkeit Host-Treffer/Anker). NF-Feld der Delta-Kontexte ab rc9p. Profil 26.09. (Operator-Zusage an den NF-Sitz, Agent MW): +FLLIPER_PDFLIP_ENABLE_FORM_A_TP0_FOLLOW=1 (H98-Schalter, profile_form_env), +FLLIPER_HICACHE_ARENA_REF_CENSUS_S=60 (profile_instr_env).
#              Referenzen beim Flip-Reset zurueck + Carrier-Hold, c5a5407a7c Tail-Hand-off ohne Temp-Namens-Wettlauf).
#              d93a17316b = 09729d97c4 + H79 (nur NVFP4-Flip; INT4 laut H79-Commit byte-identisch, COVER/PLAN-PARAM cmp-gleich).
#              Ein INT4-Boot AUF d93a17316b oder c5a5407a7c existiert noch nicht (x178 steht aus).
#   RC2-Zusatz FLLIPER_HICACHE_ARENA_QUEUE_REFS=1 auf P und D (NF_ENV_RC2_FORM unten) -- RC2 AM METALL BEWIESEN (f3 NVFP4 + x178 INT4, 25.09. 07:56-08:15Z).
#              H81 selbst braucht keine Env: FLLIPER_PDFLIP_ENABLE_MAMBA_CARRIER_HOLD ist im Baum Default AN.
#   Stufe B    FLLIPER_PDFLIP_{EVIDENCE_DIR,GPU_ARB,DEVTOOLS_DIR,STORE_ROOT,VENV,TMS_OUT_DIR}: Commit b6bd57ae6f im NF-Baum
#              (Vorfahr von d93a17316b und c5a5407a7c; patch-id == bae049a3b4). Setzt der Entrypoint, nicht dieses Profil.
#
# GEGEN x163 (Rs nf.env) GEAENDERT -- Details und Metall-Zeilen im DELTA:
#   FR_P 0.36 -> 0.332 (PP0); --d-replayssm-spec on (H64); --wake-credit-reference-logs <x162> (H14/H54);
#   P-Form +H65 (QSA 64/8/2, ptx, fused eager) +H63d/H63b/H63c (Tail-Faltung, Teilevorrat 512 MiB, PLE-Zustands-Handoff);
#   D-Form +H69/H69b/H73 (PLE volles Vokabular, Stage hinter dem Replay, 8x8 Pread, autonom + Bonus frueh) +H62
#   (Load-Async-Index) +H31b (Rearm-Defer) +H63b/H63c; global +Flipfast-Front (CTL_KICK x2, DC_OFF_PATH);
#   Instrumente +PREFILL_TIMING, +TIMING_EVENT_FLUSH (H67), +HICACHE_ROUND_TIMING, +CUDA-Coredump (Arm-Wrapper).
#   Code-Defaults ohne Env (im Baum an): H74 (Backup-Ack-Drain, TP-Publish-Fenster), H75 (Launcher-Prewarm der Front),
#   H77 (Idle-Runde nur frisch), H78 (Front-Loop im Flip frei; Teil (2) braucht DC_OFF_PATH=1, steht unten).
#
# RIG-GEBUNDEN wie 27b: 1x RTX 5090 + 2x RTX 3080 (Census, Korridor-Sample und Record sind per GPU-UUID an genau diese
# Karten gebunden), gepatchter smallbar-Treiber 595.58.03 fuer BAR1 (NF_PROFILE.md §5.2).

PROFILE_NAME=nf-nvfp4-d
PROFILE_LINE=nf
PROFILE_FORM=nvfp4-d-fnNV4d1
PROFILE_STATUS=formnachweis      # fnNV4d1 gruen; Entrypoint: nur mit HTSGLANG_ALLOW_EXPERIMENTAL=1
PROFILE_PLACEHOLDER=0
PROFILE_OWNER="NF-Sitz (Form fnNV4d1, Arm des NF-Sitzes; Code rc2.1b 5723c43fd3)"
PROFILE_FORMAT=nvfp4-modelopt   # Experten NVFP4 W4A4 (Marlin W4A16 auf sm86/sm120), Attention/GDN/Shared BF16, PLE FP8
PROFILE_NCCL_STATUS=unproven   # NF nie mit --transport nccl gebootet (NF_PROFILE.md §5.3, OP-02)
PROFILE_MODEL=/spinning/llm_stuff/club-3090/models-cache/Qwen3.8-Flash-Next-NVFP4-nvidia
# NF HAT einen externen Draft (MTP INT4 g32), geladen nur von Gruppe D (P bootet ohne Draft, H25).
# Die .safetensors darin sind ABSOLUTE Symlinks nach .../albucino-mtp-int4-g32/runtime/mtp-int4-g32/ (NF_PROFILE.md §1.1):
# die REQUIRED_PATHS unten folgen den Links (-e), ein toter Link verweigert im Preflight statt beim Laden.
PROFILE_DRAFT=/spinning/llm_stuff/club-3090/models-cache/Qwen3.8-Flash-Next-MTP-INT4-g32-albucino
PROFILE_CENSUS=/opt/htsglang/profiles/nf/xchg_census_fnFL2_graph.json                 # Quelle ARB/pdflip/census/
PROFILE_CORRIDOR=/opt/htsglang/profiles/nf/corridor_budget_sample_nextflash_0921.json  # Quelle ARB/pdflip/
# NEU x177: Referenz des WAKE-CREDIT-Riegels W126 (erster Wake D->P) = die drei Logs von fnFL2x162 (Arm x177 Z.115-116).
# Ohne sie rechnet der Launcher gegen die eingebaute Referenz x114d und verweigert W126 (x167, 24.09. 20:32:58Z).
# Image-Asset: die drei Dateien in profiles/nf.assets eintragen (prepare_context.sh -> /opt/htsglang/profiles/nf/).
PROFILE_WAKE_REF_DIR=/opt/htsglang/profiles/nf
PROFILE_WAKE_REF="$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.P.log,$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.D.log,$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.front.log"
PROFILE_REQUIRED_PATHS=(
  "$PROFILE_DRAFT/mtp-dense.safetensors"
  "$PROFILE_DRAFT/mtp-routed-experts-int4.safetensors"
  "$PROFILE_CENSUS"
  "$PROFILE_CORRIDOR"
  "$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.P.log"
  "$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.D.log"
  "$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.front.log"
)
PROFILE_GPUS="NVIDIA GeForce RTX 5090=1;NVIDIA GeForce RTX 3080=2"
PROFILE_SHM_MIN_GIB=16          # x177: tmpfs_shm max 8597 MiB (ramcensus Z.671), shm_G 9 (hostram Z.360); +TAIL_KEEP <= 512 MiB
PROFILE_MEMAVAIL_MIN_GIB=78     # T (26.09., HOST_RAM_THRESHOLDS.md), NICHT in Docker gemessen (mem_dnvfp4dbar1 brach nach 40 s ab):
                                # fnNV4d1 nativ 76,2 minus CT999-Grundstock 9,0 = 67,2 + Host-Zuschlag 6 + 4 Reserve -> 78.
                                # Alt 85 zaehlte den Grundstock mit, den MemAvailable schon abzieht.
PROFILE_TMPFS_STORE=/mnt/nf-experts   # MUSS tmpfs sein (cudaHostRegister auf ZFS-mmap -> cudaError 1); Pruefung wie Arm Z.341
PROFILE_TMPFS_GIB=56                  # Store nvfp4f1 = 47 085 MiB (Teardown fnNV4d1)
PROFILE_D_ONLY=1                      # Entrypoint: --d-only, D-Server :30032 ueberwachen, keine Front
PROFILE_SERVE_PORT=30032              # Clients sprechen D direkt

# FORM-ZAHLEN, die an MEHREREN Stellen stehen muessen (Arm-Kommentar Z.14: "FR_P steht an DREI Stellen").
# FEST, nicht per ${..:-} ueberschreibbar: die Store-Geometrie beider Gruppen haengt daran (shared_pinned.py verweigert).
NF_FR_P=0.273,0.472,0.37      # R 25.09. ~12:20Z (Container-Abnahme): NVFP4-P-Fraktion wie der native Arm fnNV4d1 -- Launcher-Log
# "PP-CUT draft post (H25) FR_P [0.273, 0.472, 0.37] -> 0.273,0.472,0.687012". --d-only startet P nicht, der P-Schnitt-Solve
# liest env_p aber trotzdem: mit der INT4-Fraktion 0.332,0.64,0.39 bepreiste er 29,11,8 auf 203774 Token < Boden 262144 (W40).
# War: NF_FR_P=0.332,0.64,0.39      # x177 (Arm x177 Z.111); Launcher-H25-Post -> 0.332,0.64,0.733887 (Launcher-Log Z.57). x163: 0.36,...
NF_FR_D=0.06,0.462,0.389     # H68c NVFP4 (fnNV4d1 PDFLIP-GROUP-ENV D)
NF_SCRATCH_D=66,48,48        # f4-Form (TP0 46 -> 66), fnNV4d1
NF_STORE_DIR=/mnt/nf-experts/nvfp4f1   # eigener Store je Format

# RC2-ZUSATZ (NF-RC2 c5a5407a7c, Koordinator 25.09.): KV-Arena-Referenzen ueber die Release-Queue zurueckgeben
# (Dauerlauf-Leck). Schalter seit b25d1618d6 ([27b-up], Default AUS; 27B faehrt ihn in 27b.env). NICHT im x177-Metall:
# RC2 AM METALL BEWIESEN (f3 NVFP4 + x178 INT4, 25.09. 07:56-08:15Z). Rueckfall bis dahin = diese Zeile leeren (dann exakt die x177-Env).
NF_ENV_RC2_FORM="FLLIPER_HICACHE_ARENA_QUEUE_REFS=1"

# Gruppen-Env (P und D verschieden -> nur ueber --env-p/--env-d, nicht global exportierbar).
# P: Arm Z.321 --env-p + ENV_P_EXTRA (Arm x177 Z.100/118/119/120/124/128); SEQ_DEPTH 1 -> 2 durch ARENA_ENV (letzter gewinnt).
NF_ENV_P_FORM="FLLIPER_MOE_SCRATCH_SLOTS=32;FLLIPER_MOE_RESIDENT_EXPERT_FRACTION=$NF_FR_P;FLLIPER_UNEVEN_MOE_EXPERT_SHARD=1;FLLIPER_WEIGHT_LOADER_PREAD=0;FLLIPER_LOAD_KEY_WORKERS=4;FLLIPER_MOE_OFFLOAD_WAVE_ORDER=expert;FLLIPER_QWEN4_PLE_CKPT_GATHER=pread;FLLIPER_MOE_EXPERT_STORE_DIR=$NF_STORE_DIR;FLLIPER_PDFLIP_ENABLE_P_TAIL_FOLD=1;FLLIPER_PDFLIP_TAIL_KEEP_MIB=512;FLLIPER_PDFLIP_PLE_STATE_HANDOFF=1;FLLIPER_FORCE_QSA_ROWS_CONFIG=inf=64/8/2;FLLIPER_PDFLIP_QSA_FP8_DECODE=ptx;FLLIPER_PDFLIP_QSA_ROWS_FUSED_EAGER=1;FLLIPER_PDFLIP_ENABLE_P_UNDIVIDED_MICRO_BATCH=1;FLLIPER_PDFLIP_ENABLE_P_MULTI_ANCHOR_TAILS=1;FLLIPER_PDFLIP_P_BURST_ASSEMBLY_MS=300;FLLIPER_PDFLIP_REARM_PREFETCH=0;FLLIPER_MOE_OFFLOAD_PLAN_VECTOR=1;FLLIPER_NAN_GUARD_WAVE=0;FLLIPER_NAN_GUARD_FETCH=0;FLLIPER_OPT_HICACHE_DEVICE_INDEX_WRITE=0;FLLIPER_PDFLIP_SEQ_BUFFER_DEPTH=2;FLLIPER_HICACHE_ARENA_GIB=4;FLLIPER_HICACHE_ARENA_KV_PAGE_BYTES=786432;FLLIPER_HICACHE_ARENA_MAMBA_SLOTS=32"
NF_ENV_P_INSTR="FLLIPER_PDFLIP_SLEEP_HEAP_CENSUS=0;FLLIPER_MOE_OFFLOAD_TIMING=1;FLLIPER_QSA_SIDECAR_TRACE=4;FLLIPER_PDFLIP_PREFILL_TIMING=1;FLLIPER_PDFLIP_ENABLE_TIMING_EVENT_FLUSH=1"
# D: Arm Z.321 --env-d + ENV_D_EXTRA (Arm x177 Z.101/121/123/129). Der ENV_D_EXTRA-Default des Arm-Wrappers
# (SPEC_EAGER_VERIFY ...) greift NICHT, weil der Arm ENV_D_EXTRA schon setzt (Gruppen-Env D Z.221 ohne SPEC_EAGER_VERIFY).
NF_ENV_D_FORM="FLLIPER_MOE_SCRATCH_SLOTS=$NF_SCRATCH_D;FLLIPER_MOE_RESIDENT_EXPERT_FRACTION=$NF_FR_D;FLLIPER_UNEVEN_MOE_EXPERT_SHARD=1;FLLIPER_WEIGHT_LOADER_PREAD=0;FLLIPER_LOAD_KEY_WORKERS=4;FLLIPER_MOE_OFFLOAD_GRAPH_MODE=pool;FLLIPER_MOE_EXPERT_STORE_DIR=$NF_STORE_DIR;FLLIPER_PDFLIP_TAIL_KEEP_MIB=512;FLLIPER_PDFLIP_PLE_STATE_HANDOFF=1;FLLIPER_HICACHE_LOAD_ASYNC_INDEX=1;FLLIPER_PDFLIP_REARM_DEFER=1;FLLIPER_PDFLIP_FORM_A_PLE_FULL_VOCAB=1;FLLIPER_PDFLIP_PLE_STAGE_BEHIND_REPLAY=1;FLLIPER_QWEN4_PLE_DECODE_PREAD_PROCS=8;FLLIPER_QWEN4_PLE_DECODE_PREAD_THREADS=8;FLLIPER_PDFLIP_PLE_STAGE_AUTONOMOUS=1;FLLIPER_PDFLIP_PLE_STAGE_BONUS_EARLY=1;FLLIPER_PDFLIP_TAIL_SKIP_EXTEND=1;FLLIPER_PDFLIP_REARM_PREFETCH=0;FLLIPER_QSA_MTP_INDEX_SHARE=0;FLLIPER_PDFLIP_SEQ_BUFFER_DEPTH=2;FLLIPER_HICACHE_ARENA_GIB=4;FLLIPER_HICACHE_ARENA_KV_PAGE_BYTES=786432;FLLIPER_HICACHE_ARENA_MAMBA_SLOTS=32;FLLIPER_FORCE_QSA_ROWS_CONFIG=sm120:32=32/8/2,64=64/8/2,128=64/4/2,512=32/4/2,inf=64/8/2"
NF_ENV_D_INSTR="FLLIPER_PDFLIP_SLEEP_HEAP_CENSUS=0;FLLIPER_DEBUG_DECODE_PLE_WAIT=1;FLLIPER_DEBUG_HOST_ANON_PROBE=1;FLLIPER_SPEC_STAGE_SYNC=8;FLLIPER_GRAPH_REPLAY_CENSUS=8;FLLIPER_BARLINK_EAGER_TRACE=6000;FLLIPER_QSA_SIDECAR_TRACE=4;FLLIPER_HICACHE_ROUND_TIMING=512"
# Default 1 = Paritaet mit dem Metall (x177 lief MIT allen Instrumenten). Der Entrypoint exportiert HTSGLANG_INSTRUMENTS
# vorher (Release-Default 0, F8) -- dieser Default greift nur, wenn ein Gate die Datei ohne Entrypoint sourct.
# Der RC2-Zusatz geht an BEIDE Gruppen (P und D), hinter die x177-Form.
_nf_rc2=${NF_ENV_RC2_FORM:+;$NF_ENV_RC2_FORM}
if [ "${HTSGLANG_INSTRUMENTS:-1}" = "1" ]; then
  NF_ENV_P="$NF_ENV_P_FORM$_nf_rc2;$NF_ENV_P_INSTR"; NF_ENV_D="$NF_ENV_D_FORM$_nf_rc2;$NF_ENV_D_INSTR"
else
  NF_ENV_P="$NF_ENV_P_FORM$_nf_rc2"; NF_ENV_D="$NF_ENV_D_FORM$_nf_rc2"
fi
unset _nf_rc2

# NCCL-BLOCK (25.09. ~09:45Z, NF-Entscheid auf Cs Analyse der Host-Abnahme; gilt NUR bei HTSGLANG_TRANSPORT=nccl).
# Unter nccl fehlen die barlink-Gruppenfenster, die 3080-Ziele leihen kein BAR1-Fenster mehr (bar1_lanes.py:786-804):
# p0/p1/p3/p5 fahren den Host-Pfad, Ganz-Tag-Form x Tiefe 2 = 8 Dateien /dev/shm/pdflip-seq-*/p*_unit_buffer.bin
# a 537-628 MiB = 4,66 GiB shmem (+0,4-0,5 NCCL-SHM, +0,6-0,9 anon) -> nccl@82g: Nadel W53. Tiefe 1 spart 3,07 GiB;
# am NF-Metall erprobt (NVFP4-Arme f2-f4 fahren SEQ_DEPTH 1), Preis +0..0,4 s je Flip, Einmal-Stall des ersten
# P->D-Flips (cudaHostRegister der Lane-Puffer, 14,3 s) etwa halbiert. Muss VOR PROFILE_ARGS stehen: bash setzt
# NF_ENV_P beim Anlegen des Arrays ein, und im --env-p gewinnt der letzte Eintrag. Unter bar1 unveraendert Tiefe 2.
if [ "${HTSGLANG_TRANSPORT:-bar1}" = nccl ]; then
  NF_ENV_P="$NF_ENV_P;FLLIPER_PDFLIP_SEQ_BUFFER_DEPTH=1"
  NF_ENV_D="$NF_ENV_D;FLLIPER_PDFLIP_SEQ_BUFFER_DEPTH=1"
fi

# Launcher-Argumente (ohne --tree/--tag/--transport; die setzt der Entrypoint). Wirksame Werte von fnFL2x177.
# BEWUSST NICHT uebergeben: --evidence-dir (Default EVIDENCE_DIR folgt FLLIPER_PDFLIP_EVIDENCE_DIR, Stufe B) und die
# doppelte Census-Angabe des Arms (Z.321 _computed.json, dann LAUNCHER_EXTRA _graph.json; der letzte gewinnt -> einmal graph).
# --extra-p/-d: Quotierung WIE Arm Z.208 / Arm x177 Z.87 -- der Launcher zerlegt die Zeichenkette mit shlex.split, das
# JSON muss darin doppelt gequotet stehen, sonst kommt {language_model_only:true} (kein JSON) an.
PROFILE_ARGS=(
  --corridor-budget-sample "$PROFILE_CORRIDOR"
  --profile nextflash --model "$PROFILE_MODEL"
  --d-only
  --flip-weights family --pdflip-weight-source exchange --pdflip-xchg-inject authoritative
  --xchg-bounce-depth 1 --pdflip-weights-cpu-backup off --weight-chunks 16
  --pdflip-xchg-census "$PROFILE_CENSUS"
  --env-p "$NF_ENV_P" --env-d "$NF_ENV_D"
  --d-foreign-context-mib 1446,896,894 --d-nontorch-mib 1981,528,524
  --d-tp-objective maxkv --draft-kv-on-p off --pdflip-vision off --pp-solve-pool-floor 0
  --pp-stage-ratio 29,11,8 --pp-attn-stage-ratio 7,3,2
  --pp-cut-expert-device-fraction "$NF_FR_P" --pp-cut-expert-lru-rows 32,32,32
  --user-reserve-mib 0,0,0 --store-max-gb 150 --max-kv-per-request 262144
  --p-bs 4 --d-bs 1
  --extra-p '--max-total-tokens 262144 --json-model-override-args "{\"language_model_only\":true}" --kv-cache-dtype fp8_e4m3 --page-size 64 --max-running-requests 4 --mamba-ssm-dtype bfloat16 --ple-offload-embedding --ple-offload-backend checkpoint --hicache-mamba-host-mib 300 --hicache-size 2 --speculative-draft-model-path '"$PROFILE_DRAFT"' --rank-moe-resident-fraction '"$NF_FR_P"' --rank-user-reserve-mib 0,0,0 --disable-cuda-graph --context-length 262144 --max-kv-per-request 262144'
  # R 25.09. (cu130, Operator): --moe-runner-backend marlin wie der native Arm fnNV4d1 -- das D2-Formgate rc2.1c2 zeigte
  # sie als einzige FORM-Differenz der Gruppe D (native=['marlin'], Container=None); wahrscheinliche OOM-Ursache 82g.
  --extra-d '--max-total-tokens 262144 --json-model-override-args "{\"language_model_only\":true}" --kv-cache-dtype fp8_e4m3 --page-size 64 --max-running-requests 1 --mamba-ssm-dtype bfloat16 --ple-offload-embedding --ple-offload-backend checkpoint --hicache-mamba-host-mib 300 --rank-role host,worker,worker --rank-tp-ratio 1,0,0 --rank-moe-ratio 183,137,168 --rank-moe-resident-fraction '"$NF_FR_D"' --rank-user-reserve-mib 0,0,0 --speculative-draft-placement solo --speculative-algorithm NEXTN --speculative-num-steps 3 --speculative-eagle-topk 1 --speculative-num-draft-tokens 4 --speculative-draft-model-path '"$PROFILE_DRAFT"' --cuda-graph-bs-decode 1 --cuda-graph-backend-decode=full --cuda-graph-backend-prefill=disabled --hicache-size 4 --hicache-mamba-host-mib 300 --context-length 262144 --max-kv-per-request 262144 --moe-runner-backend marlin'
  --d-replayssm-spec on                                # NEU x173/x174 (H64): D --enable-linear-replayssm-spec --linear-replayssm-cache-len 16
  --wake-credit-reference-logs "$PROFILE_WAKE_REF"     # NEU seit x164 (H14/H54): Referenz fnFL2x162, siehe PROFILE_WAKE_REF
  --x-ceiling-tokens 12288                             # NEU RC2 (H84): D-Riegel W50 = 12288 (3 D-Stuecke a 4096), Front klemmt ihr Live-X darauf, Start-X bleibt 4096; Rueckfall = Zeile streichen (dann exakt x177-Routing)
)

# FORM (global exportiert: der Launcher kopiert os.environ in beide Gruppen UND in die Front, launcher.py build_env /
# fenv = dict(os.environ)). Arm Z.64/92/201-206, Arm x177 Z.88-96/117/125.
profile_form_env() {
  _form FLLIPER_PDFLIP_WAKE_DEFER_BELOW_MIB 0
  _form FLLIPER_MOE_EXPERT_STORE_SLOT_FRACTION 0.82
  _form FLLIPER_MOE_COLD_TIER_SHM 1
  _form FLLIPER_MOE_COLD_TIER_INSTANCE "${HTSGLANG_TAG}"        # Arm: <TAG><HHMMSS>; eine Instanz fuer beide Gruppen
  _form MALLOC_ARENA_MAX 2
  _form FLLIPER_MOE_OFFLOAD_EXCLUDE_DRAFT 1
  _form FLLIPER_MOE_OFFLOAD_WAVE_SLICE 40960
  _form FLLIPER_NAN_GUARD 1
  _form FLLIPER_HC_MIXER_INT8 1
  _form FLLIPER_MOE_MARLIN_ATOMIC_ADD 0
  _form FLLIPER_MOE_POOL_STAGING 8
  _form FLLIPER_QWEN4_PLE_FILE_SKIP_DEVICE_CHECK 1
  _form FLLIPER_HICACHE_ARENA_MAMBA_SLOTS 32
  _form FLLIPER_HICACHE_ARENA_KV_PAGE_BYTES 786432
  _form FLLIPER_PDFLIP_DRAFT_ON_P 0
  _form FLLIPER_PDFLIP_P_CHUNKED_PREFILL_TOKENS 16384
  _form FLLIPER_PDFLIP_ENABLE_P_UNDIVIDED_MICRO_BATCH 1
  _form FLLIPER_PDFLIP_ENABLE_P_MULTI_ANCHOR_TAILS 1
  _form FLLIPER_PDFLIP_P_BURST_ASSEMBLY_MS 300
  _form FLLIPER_PDFLIP_P_QUEUE_AHEAD 4                            # liest die FRONT
  # NEU x173 (27B-Flipfast 32456152e3, alle drei Code-Default AUS; liest die FRONT, front.py CTL_KICK_* / DC_OFF_PATH):
  _form FLLIPER_PDFLIP_CTL_KICK_ARRIVAL 1
  _form FLLIPER_PDFLIP_CTL_KICK_AFTER_FLIP 1
  _form FLLIPER_PDFLIP_DC_OFF_PATH 1                              # H78 (2): Erstschlaf-Messung im Thread nur mit diesem Schalter
  # RC2.1 (NF-Host-Abnahme 25.09.): Pinned-Host-OS-Reserve im cgroup von 10 auf 2 GiB. Deckel, oom_score_adj und
  # Deckel+4 <= MemAvailable schuetzen den Host bereits; mit 10 GiB blieb bei Deckel 82g 0 nutzbar (8,73 - 10,74) und
  # die Read-Buffer des Hand-backs wurden verweigert -> W53 -> 413. Nur im Container; nativ bleibt der Default 10.
  _form FLLIPER_PINNED_HOST_RESERVE_GIB 2
  # RC2.1k/l (H98, Operator-Zusage 26.09.): Form-A-Worker folgen TP0 im Praefix-/Anker-Verdikt (tp_match_floor.py; hier
  # ausdruecklich = Code-Default AN, environ.py EnvBool(True)). Wirksam ab NF 2eed285057, aeltere Baeume ignorieren sie.
  _form FLLIPER_PDFLIP_ENABLE_FORM_A_TP0_FOLLOW 1
}
# INSTRUMENTE (global; die gruppenweisen stecken in NF_ENV_*_INSTR oben). F8: im Release AUS, HTSGLANG_INSTRUMENTS=1 = Paritaet.
profile_instr_env() {
  _form FLLIPER_LOAD_PROFILE 1
  # GPU-Coredump je CUDA-Exception (Arm-Wrapper des NF-Sitzes), Ziel im Evidenz-Verzeichnis des Containers.
  _form CUDA_ENABLE_COREDUMP_ON_EXCEPTION 1
  _form CUDA_ENABLE_LIGHTWEIGHT_COREDUMP 1
  _form CUDA_COREDUMP_FILE "${FLLIPER_PDFLIP_EVIDENCE_DIR:-/var/lib/htsglang/evidence}/cudacore_${HTSGLANG_TAG}_%h_%p"
  # CUDA_ENABLE_USER_TRIGGERED_COREDUMP=1 lief im Arm mit (Wrapper Z.9); im Container erst nach eigenem Test (NF_PROFILE OP-13).
  # Arena-Referenz-Zensus alle 60 s (hicache_arena.py, wie 27b.env; Operator-Zusage 26.09.)
  _form FLLIPER_HICACHE_ARENA_REF_CENSUS_S 60
}

# --- R (27B-Sitz), 25.09. ~06:30Z: Uebernahme dieser Datei als profiles/nf.env (NF-Lieferung H83, ueber den Operator).
# Saat-Dateien der NF-Linie (NF-Hinweis (c)). Sie liegen im Image unter /opt/htsglang/profiles/nf/ (Liste
# profiles/nf.assets); der Entrypoint (seed_profile_files) kopiert sie beim Start NUR, wenn sie am Ziel fehlen --
# ein gemountetes evidence-/Cache-Verzeichnis mit eigenen Messungen gewinnt immer.
PROFILE_SEED_EVIDENCE=(               # -> $FLLIPER_PDFLIP_EVIDENCE_DIR/ (host_ledger MEASURED_RECORD_NAME; sonst P-Budget 28264 statt 28120)
  /opt/htsglang/profiles/nf/weg2_measured_record.json
)
PROFILE_SEED_FLLIPER_CACHE=(           # -> ~/.cache/flliper/ (rigmon/card_probe.CACHE_DIR)
  /opt/htsglang/profiles/nf/phase_footprint-a191a0712717-055c2e4b0867.json
  /opt/htsglang/profiles/nf/phase_footprint-a191a0712717-cc0ac5caf91e.json
  /opt/htsglang/profiles/nf/card_library.json
  /opt/htsglang/profiles/nf/card_library.json.by-uuid.json
)
