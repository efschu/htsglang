# shellcheck shell=bash
# Profil nf-gguf-d -- Stufe A des GGUF-NF-Plans (PLAN-GGUF-NF-1009.md Abschnitt 0 Entscheid 2 und Abschnitt 3): D-ONLY-FORMATNACHWEIS des
# unsloth Qwen3.8-Flash-Next UD-IQ4_XS (GGUF arch qwen4exp, 3 Teile) + GGUF-eigenes MTP (shared-Q8_0) im REINEN D-LAYOUT (TP3 Form A,
# KEIN P, KEIN Flip, KEINE Front; Clients sprechen D direkt auf Port 30032). NF-GGUF AP G8 (10.10.2026).
#
# MUSTER nf-nvfp4-d.env (Aufruf --d-only, PROFILE_D_ONLY=1, PROFILE_SERVE_PORT=30032), ABER nicht als eigenstaendige Kopie: das Profil
# liest nf-gguf.env (die GGUF-Form von nf.env h91bb4, Entscheide dort einzeln genannt) und aendert danach NUR das hier Genannte. So kann
# die GGUF-Form nie von nf-gguf.env wegdriften (die Kopie von nf-nvfp4-d.env stammt von der alten x177-Form).
#
# STAND: EXPERIMENTELL (PROFILE_STATUS=experimentell: der Entrypoint verlangt HTSGLANG_ALLOW_EXPERIMENTAL=1), am Metall NIE gebootet.
#
# WAS GEGEN nf-gguf.env GEAENDERT IST (jede Zeile einzeln):
#   --d-only                   an PROFILE_ARGS (der Entrypoint haengt es sonst an: entrypoint.sh PROFILE_D_ONLY; hier steht es wie bei nf-nvfp4-d
#                              ausdruecklich im Argv, damit der Dry-Run und der Planer es sehen)
#   PROFILE_D_ONLY=1, PROFILE_SERVE_PORT=30032   (Entrypoint: D-Server :30032 ueberwachen, keine Front)
#   --served-model-name Qwen3.8-Flash-Next-GGUF  in --extra-d (und --extra-p, damit die Gruppen gleich heissen): sonst ist der Name der
#                              DATEINAME ...-UD-IQ4_XS-00001-of-00003.gguf (launcher.served_model_name leitet ihn aus dem Modellpfad ab;
#                              ein --served-model-name in den Gruppen-Extras steht NACH dem des Launchers und gewinnt, argparse last-wins)
#   Draft                      PROFILE_DRAFT = <PROFILE_DRAFT_DIR>/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf (die Symlink-Datei IM Draft-
#                              Verzeichnis, neben der die config.json liegt: tools/release/make_nf_gguf_draft_dir.sh). Der Server bekommt
#                              die DATEI, nie das Verzeichnis: eine GGUF-Draft wird per check_gguf_file (Datei, Suffix .gguf) erkannt, ein
#                              Verzeichnis wuerde als safetensors-Checkpoint gelesen (load_config.resolve_draft_load_format). Ohne das
#                              Verzeichnis hat der Draft keine config.json neben sich -> W172 fuer den Draft (G3, am Rig vorher
#                              nicht angelegt). Rueckfall mtp-Qwen3.8-Flash-Next-Q8_0.gguf per HTSGLANG_DRAFT (dann im Verzeichnis verlinken).
#   PROFILE_REQUIRED_PATHS     Sibling-Verzeichnis (Ziel: Teile + config.json + Tokenizer), Draft-Verzeichnis (Symlink + config.json) und das
#                              Store-Verzeichnis /mnt/nf-experts/gguf; der Entrypoint verweigert vor dem Boot, wenn eins fehlt. Angelegt
#                              werden die Verzeichnisse mit make_nf_gguf_sibling.sh / make_nf_gguf_draft_dir.sh (beide mit --check).
#   Vision                     aus (--pdflip-vision off kommt schon aus nf-gguf.env; kein mmproj im GGUF-Ordner)
#   PLE                        --ple-offload-embedding --ple-offload-backend checkpoint steht aus nf.env in --extra-p/--extra-d (das GGUF-Modell
#                              verlangt es, sonst benannte Verweigerung vor jeder Allokation: Metall-Auftrag Abschnitt 0 Punkt 8)
# UNVERAENDERT UEBERNOMMEN, fuer GGUF UNBELEGT (nichts hier gerechnet oder gemessen): NF_FR_D/NF_SCRATCH_D (INT4-Werte der Form h91bb4),
# PROFILE_MEMAVAIL_MIN_GIB / PROFILE_TMPFS_GIB (INT4: 88 / 72; nf-nvfp4-d hat fuer NVFP4 78 / 56 gemessen, GGUF-D-only nicht),
# --pp-stage-ratio & Co. (der P-Schnitt-Solve liest env_p auch bei --d-only: nf-nvfp4-d.env Z. "NF_FR_P"; er wird gerechnet, P startet nicht).
# D-Store-Adopt fuer GGUF ist NICHT geliefert (G4): D liest jeden eigenen Experten selbst, der D-Ladevorgang ist laenger als bei INT4.
#
# Aufruf (Metall-Auftrag Stufe A): PROF=nf-gguf-d bash acc_nf_m1_donly.sh (Kopf des Skripts lesen; fuer dieses Format unbelegt).

# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/nf-gguf.env"   # GGUF-Form von nf.env (setzt PROFILE_ARGS, PROFILE_SIBLING, PROFILE_DRAFT, ...)

_gd_mc=/spinning/llm_stuff/club-3090/models-cache
_gd_old_draft=$PROFILE_DRAFT
_gd_name=Qwen3.8-Flash-Next-GGUF

PROFILE_NAME=nf-gguf-d
PROFILE_FORM=gguf-d-stufe-a
PROFILE_OWNER="NF-GGUF (Plan PLAN-GGUF-NF-1009, AP G8: Stufe A D-only-Formatnachweis; Form = nf-gguf.env + D-only); am Metall ungebootet"
PROFILE_DRAFT_DIR="${NF_GGUF_DRAFT_DIR:-$_gd_mc/Qwen3.8-Flash-Next-GGUF-unsloth-draft}"   # make_nf_gguf_draft_dir.sh
PROFILE_DRAFT="${HTSGLANG_DRAFT:-$PROFILE_DRAFT_DIR/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf}"
PROFILE_REQUIRED_PATHS=(
  "$PROFILE_SIBLING"
  "$PROFILE_MODEL"
  "$PROFILE_TOKENIZER/config.json"
  "$PROFILE_TOKENIZER/tokenizer.json"
  "$PROFILE_DRAFT_DIR"
  "$PROFILE_DRAFT"
  "$PROFILE_DRAFT_DIR/config.json"
  "$NF_STORE_DIR"
  "$PROFILE_CENSUS"
  "$PROFILE_CORRIDOR"
  "$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.P.log"
  "$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.D.log"
  "$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.front.log"
)

_gd_args=(--d-only)
for ((_gd_i = 0; _gd_i < ${#PROFILE_ARGS[@]}; _gd_i++)); do
  _gd_a=${PROFILE_ARGS[_gd_i]}
  case "$_gd_a" in
    --d-only) ;;                                  # schon im Argv: nicht doppelt
    *)
      _gd_a=${_gd_a//"$_gd_old_draft"/"$PROFILE_DRAFT"}
      # das Gruppen-Extra des Launchers traegt --served-model-name VOR den --extra-p/-d-Woertern: das spaetere gewinnt
      if ((_gd_i > 0)); then
        case "${PROFILE_ARGS[_gd_i - 1]}" in
          --extra-p|--extra-d) _gd_a="$_gd_a --served-model-name $_gd_name" ;;
        esac
      fi
      _gd_args+=("$_gd_a") ;;
  esac
done
PROFILE_ARGS=("${_gd_args[@]}")
unset _gd_args _gd_a _gd_i _gd_old_draft _gd_mc _gd_name

PROFILE_D_ONLY=1                      # Entrypoint: --d-only, D-Server :30032 ueberwachen, keine Front
PROFILE_SERVE_PORT=30032              # Clients sprechen D direkt
