# shellcheck shell=bash
# Profil nf-gguf -- unsloth Qwen3.8-Flash-Next UD-IQ4_XS (GGUF arch qwen4exp, 3 Teile, 87,24 GiB) + GGUF-eigenes MTP (shared-Q8_0),
# pdflip-Flip P=PP3 / D=Form A TP3.  NF-GGUF AP G5 (09.10.2026, Plan deskq/PLAN-GGUF-NF-1009.md Abschnitt 0 Entscheide 7/9/10 und 2 Zeile G5).
#
# STAND: EXPERIMENTELL (PROFILE_PLACEHOLDER=0, PROFILE_STATUS=experimentell: der Entrypoint verlangt HTSGLANG_ALLOW_EXPERIMENTAL=1).
# Der Platzhalter vom 24.09. ist weg; am Metall ist dieses Profil NIE gebootet (Stufe A = D-only-Formatnachweis, Stufe B = Flip: Plan
# Abschnitt 3). Was es voraussetzt und was noch fehlt:
#   * G1 (qwen4exp-Adapter, gemergt in diesen Branch), G2 (PLE IQ4_NL: --ple-offload-backend checkpoint liest GGUF), G3 (MTP aus GGUF:
#     Draft-Namenskarte, Draft-Preis aus dem GGUF-Kopf), G4 (Platztausch/Store mit GGUF-Zeilen), G6 (IQ-MoE-MMQ-Kernel) liegen auf eigenen
#     Branches. Bis G6 am Metall belegt ist, laeuft P EAGER ueber moe_vec (--disable-cuda-graph steht schon in --extra-p von nf.env).
#   * Das Sibling-Verzeichnis (PROFILE_SIBLING): der unsloth-Ordner traegt nur die .gguf-Teile. Der Server liest die Geometrie eines
#     Bespoke-GGUF NUR aus einer config.json neben der Datei (W172) und den Tokenizer nur aus Geschwisterdateien oder --tokenizer-path
#     (W163). tools/release/make_nf_gguf_sibling.sh baut EIN Verzeichnis, das beides ist (Symlinks auf alle Teile + config.json und
#     Tokenizer des safetensors-Originals Qwen3.8-Flash-Next-NVFP4-nvidia). Es MUSS vor dem Start existieren (PROFILE_REQUIRED_PATHS).
#
# FORM: alles aus nf.env (per `source`, Release-Form h91bb4/E4) AUSSER den GGUF-Aenderungen unten; jede ist hier einzeln genannt:
#   --model                 = Teil 1 (.gguf-Datei im Sibling-Verzeichnis), nicht ein Verzeichnis (model_is_gguf_file, launcher.py)
#   --tokenizer-path        = das Sibling-Verzeichnis (beide Gruppen; ohne: W163)
#   --pdflip-vision off     (kein mmproj im Ordner; statt transient; Plan 0.10, Ist-Bericht 7.13)
#   --pdflip-xchg-census-foreign  (der Census ist der des INT4-Layouts; ein GGUF-Boot misst seinen eigenen, wie 27b-gguf.env)
#   --speculative-draft-model-path = die shared-MTP-GGUF-Datei (G3-Form; in --extra-p UND --extra-d)
#   FLLIPER_MOE_EXPERT_STORE_DIR   = /mnt/nf-experts/gguf (eigenes Store-Verzeichnis je Format, nie zwei Stores zugleich)
#   FLLIPER_HC_MIXER_INT8   aus nf.env GESTRICHEN und auf 0 gesetzt: der GGUF-Lader dequantisiert die Q8_0-Hyper-Connection-Mixer zu
#                           bf16-nn.Linear-Gewichten und verweigert SGLANG_HC_MIXER_INT8 (gguf_qwen4exp.build_name_map)
# NICHT geaendert, aber fuer GGUF UNBELEGT: --pp-stage-ratio 29,11,8 (der Planer rechnet je Layer, siehe Bericht G5: PP2 traegt 350 MiB mehr
# Expertenbytes als der Mittelwert-Preis sagte), FR_P/FR_D/SCRATCH_D (INT4-Werte der Form h91bb4), PROFILE_MEMAVAIL_MIN_GIB (98-GB-Ladespitze
# privater Pools gegen die 88-GB-Marke, Plan Risiken: Host-RAM-Regel = warnen, nicht verweigern).
#
# Kernel-/JIT-Pfade je Arch: GGUF-Dequant/MMVQ/moe_vec des Forks auf sm_86 und sm_120; IQ3_S/IQ4_NL/IQ4_XS haben (bis G6) kein MMQ.
# Modell am Rig: Qwen3.8-Flash-Next-GGUF-unsloth/UD-IQ4_XS/ (3 Teile) und MTP/ (mtp-...-Q8_0.gguf, mtp-...-shared-Q8_0.gguf).

# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/nf.env"   # die NF-Release-Form (profconv/nf.env)

_gg_mc=/spinning/llm_stuff/club-3090/models-cache
_gg_old_model=$PROFILE_MODEL
_gg_old_draft=$PROFILE_DRAFT
_gg_old_store=$NF_STORE_DIR

PROFILE_NAME=nf-gguf
PROFILE_FORM=h91bb4-gguf
PROFILE_FORMAT=gguf
PROFILE_STATUS=experimentell
PROFILE_PLACEHOLDER=0
PROFILE_OWNER="NF-GGUF (Plan PLAN-GGUF-NF-1009, AP G5; Form = nf.env h91bb4 + GGUF-Aenderungen oben); am Metall ungebootet"
PROFILE_SIBLING="${NF_GGUF_SIBLING:-$_gg_mc/Qwen3.8-Flash-Next-GGUF-unsloth-sibling}"   # make_nf_gguf_sibling.sh
PROFILE_MODEL="$PROFILE_SIBLING/Qwen3.8-Flash-Next-UD-IQ4_XS-00001-of-00003.gguf"
PROFILE_TOKENIZER="$PROFILE_SIBLING"
PROFILE_DRAFT="$_gg_mc/Qwen3.8-Flash-Next-GGUF-unsloth/MTP/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf"   # shared-Variante: Embedding/lm_head vom Ziel
NF_STORE_DIR=/mnt/nf-experts/gguf
PROFILE_REQUIRED_PATHS=(
  "$PROFILE_MODEL"
  "$PROFILE_TOKENIZER/config.json"
  "$PROFILE_TOKENIZER/tokenizer.json"
  "$PROFILE_DRAFT"
  "$PROFILE_CENSUS"
  "$PROFILE_CORRIDOR"
  "$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.P.log"
  "$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.D.log"
  "$PROFILE_WAKE_REF_DIR/boot_weg2_fnFL2x162_7517ff598d_0924_171421.front.log"
)

_gg_args=()
for ((_gg_i = 0; _gg_i < ${#PROFILE_ARGS[@]}; _gg_i++)); do
  _gg_a=${PROFILE_ARGS[_gg_i]}
  case "$_gg_a" in
    --model) _gg_args+=(--model "$PROFILE_MODEL" --tokenizer-path "$PROFILE_TOKENIZER"); _gg_i=$((_gg_i + 1)) ;;
    --pdflip-vision) _gg_args+=(--pdflip-vision off); _gg_i=$((_gg_i + 1)) ;;
    --pdflip-xchg-census) _gg_args+=(--pdflip-xchg-census "${PROFILE_ARGS[_gg_i + 1]}" --pdflip-xchg-census-foreign); _gg_i=$((_gg_i + 1)) ;;
    *)
      _gg_a=${_gg_a//"$_gg_old_draft"/"$PROFILE_DRAFT"}
      _gg_a=${_gg_a//"$_gg_old_model"/"$PROFILE_MODEL"}
      _gg_a=${_gg_a//"$_gg_old_store"/"$NF_STORE_DIR"}
      _gg_args+=("$_gg_a") ;;
  esac
done
PROFILE_ARGS=("${_gg_args[@]}")
unset _gg_args _gg_a _gg_i _gg_old_model _gg_old_draft _gg_old_store _gg_mc

# FORM: die von nf.env, ohne FLLIPER_HC_MIXER_INT8 (siehe oben; `_form` kennt kein Ueberschreiben: eine zweite Zeile derselben Variable
# wuerde als FORM-OVERRIDE gemeldet und den ersten Wert behalten), plus der GGUF-Wert 0.
eval "$(declare -f profile_form_env | grep -v 'FLLIPER_HC_MIXER_INT8' | sed '1s/^profile_form_env/_profile_form_env_nf/')"
profile_form_env() {
  _profile_form_env_nf
  _form FLLIPER_HC_MIXER_INT8 0                                   # GGUF: Mixer als bf16-Linear (Lader dequantisiert Q8_0)
}
