# shellcheck shell=bash
# Profil nf-gguf -- PLATZHALTER (Schnittstelle wie profiles/27b.env). ENTWURF 27B-Sitz R, 24.09.2026.
# Eigentuemer der Form: offen (GGUF folgt). Bis die Form geliefert UND am Rig gebootet ist, verweigert der
# Entrypoint dieses Profil (PROFILE_PLACEHOLDER=1).
#
# Modellformat: gguf (Erkennung im Entrypoint aus config.json bzw. *.gguf).
# Kernel-/JIT-Pfade je Arch: GGUF-Dequant/Matmul des Forks auf sm_86 und sm_120, MoE-GGUF-Pfad
# Modell am Rig (24.09. ~22:35Z): Download laeuft nach Qwen3.8-Flash-Next-GGUF-unsloth/UD-IQ4_XS/ (3 Teile);
# MTP-Kopf als GGUF daneben unter MTP/ (mtp-...-Q8_0.gguf, mtp-...-shared-Q8_0.gguf).
#
# Zu liefern: PROFILE_ARGS (Argumentzeile des Bestform-Arms dieses Formats, woertlich),
# profile_form_env()/profile_instr_env(), PROFILE_SHM_MIN_GIB, PROFILE_MEMAVAIL_MIN_GIB,
# ggf. PROFILE_DRAFT/PROFILE_CENSUS/PROFILE_TMPFS_*; danach den Rig-JIT-Cache dieses Formats in
# den Build-Kontext uebernehmen (prepare_context.sh liest ~/.cache/flashinfer und ~/.cache/tvm-ffi).
PROFILE_NAME=nf-gguf
PROFILE_LINE=nf
PROFILE_FORMAT=gguf
PROFILE_MODEL="/spinning/llm_stuff/club-3090/models-cache/Qwen3.8-Flash-Next-GGUF-unsloth/UD-IQ4_XS"   # Download laeuft
# NF-GGUF G3 (Planer 10.10.2026): Draft = das EIGENE MTP-GGUF der Quantisierung (Nutzerentscheid 09.10. 22:40Z: kein fremder
# Draft). shared-Q8_0 (2,59 GiB, ohne token_embd/output: der Draft teilt die Vokabular-Module des Ziels) ist die Wahl; Rueckfall
# ist mtp-Qwen3.8-Flash-Next-Q8_0.gguf (3,84 GiB, eigene Tabellen, die der Lader ungelesen laesst) -- per HTSGLANG_DRAFT.
# Die Draft-Config (Geometrie, hc_count, ...) liest der Server NEBEN der .gguf-Datei (config.json von genau diesem Modell,
# W172/W173 wie beim Ziel): ein Verzeichnis mit Symlink auf die MTP-Datei plus config.json aus Qwen3.8-Flash-Next-NVFP4-nvidia
# ist am Rig noch NICHT angelegt (unbelegt), deshalb steht hier der Pfad der Datei im MTP/-Ordner des Downloads.
# Der Profil-Argv (--speculative-draft-model-path "$PROFILE_DRAFT") gehoert G5 (PROFILE_ARGS bleibt leer, PLACEHOLDER=1).
PROFILE_DRAFT=${HTSGLANG_DRAFT:-/spinning/llm_stuff/club-3090/models-cache/Qwen3.8-Flash-Next-GGUF-unsloth/MTP/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf}
PROFILE_GPUS="NVIDIA GeForce RTX 5090=1;NVIDIA GeForce RTX 3080=2"
PROFILE_NCCL_STATUS=unproven
PROFILE_PLACEHOLDER=1
PROFILE_STATUS=geplant          # Operator/Nutzer 25.09.: nf-gguf = geplant
PROFILE_OWNER="offen (GGUF folgt)"
PROFILE_ARGS=()
profile_form_env() { :; }
profile_instr_env() { :; }
