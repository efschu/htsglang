# shellcheck shell=bash
# E4-ALIAS (28.09.): der alte Release-Entwurf 27b-release-draft -- das Release-Profil 27b OHNE Fix B, also die alte Datei:
# 27b-base (= alte 27b-Form) + der Rumpf von profiles/27b-release-draft.env WORTGLEICH (Rig-Datei nur gelesen, unveraendert).
# Nicht per `source 27b.env` + `_form ... 0`: der Entrypoint-_form laesst den ERSTEN Wert stehen (ein zweiter gilt als
# FORM-OVERRIDE), der Alias waere dann still MIT Fix B.
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/27b-base.env"
PROFILE_NAME=27b-release-draft
PROFILE_FORM=${PROFILE_FORM}+rc10+prefix
PROFILE_STATUS=experimentell   # Entwurf; abgenommen erst nach Metall-Beleg (Agentenlast rc10 + Praefix), Operator entscheidet
PROFILE_OWNER="27B-Sitz (Agent RD, Release-Entwurf INT8 = rc10 + Praefix-Schalter)"

# --- D-Layout (Zeile 24 + 24b), wie 27b-rc10.env -----------------------------------------------------------------------------
# Knopf HTSGLANG_RC10_D_PLACE (Name wie in 27b-rc10.env, damit Arme und FLLIPER_RC10_D_PLACE unveraendert greifen):
#   rt (Kandidat) | t (nur Token-Platzierung) | off (D-Layout wie 27b); Abweichung = FORM-OVERRIDE, laut.
PROFILE_RC10_D_PLACE_BEST=drq  # 26.09. A/B rc11b (dkr27bint8drqbar1i8drq109262005 gegen dkr27bint8drtbar1i8rt109261955): drq an allen 24 Punkten -1,6…-4,1 % Schrittzeit gegen R+T, ueber dem Band
PROFILE_RC10_D_PLACE=${HTSGLANG_RC10_D_PLACE:-$PROFILE_RC10_D_PLACE_BEST}
case "$PROFILE_RC10_D_PLACE" in
  # rt: Beleg i8rt boot_weg2_dkr27bint8drtbar109261117 (rc9meas, d98b3ba08a) gegen i8h dkr27bbar1mwh09261051: Schrittzeit
  #     code@128k -1,1/-2,6 %, code@240k -1,7/-3,1 % (bs1/bs2), 10k/32k kein Unterschied, Nadel MATCH. R allein = Verlust (i8r).
  rt)  PROFILE_ARGS+=(--d-reshard wake --d-reshard-presets auto --d-token-placement bandwidth) ;;   # auto -> 707,191,190
  # t: T allein (27b-int8-dt) ungemessen.
  t)   PROFILE_ARGS+=(--d-token-placement bandwidth) ;;
  off) ;;
  # drq (ALTERNATIVE, AUSKOMMENTIERT): Segment-Kreuzung 652:218:218 + wake-seg + Token nach Bandbreite, Form wie 27b-int8-drq.env.
  #     MODELL, KEINE MESSUNG (DYN_D_RESHARD_INT8.md: Erwartung gegen drt -2,2 % warm). Kein drq-Boot in docker-acceptance/27b
  #     (26.09. ~18:40Z). Erst nach A/B drq gegen drt (i8rt) gegen 27b (i8h), selbes Fenster, selbes Image, verschraenkt.
  #     Abbruchregel aus 27b-int8-drq.env: drq bei bs1 10k-32k nicht ueber das Band schneller als drt -> verworfen.
  #     Launcher: wake-seg + explizite Presets im vereinigten Baum vorhanden (d_reshard.py POLICY_WAKE_SEG, launcher --d-reshard).
  drq) PROFILE_ARGS+=(--d-reshard wake-seg --d-reshard-presets "drq=652:218:218" --d-token-placement bandwidth) ;;
  *) echo "profiles/27b-release-draft.env: HTSGLANG_RC10_D_PLACE='$PROFILE_RC10_D_PLACE' (rt|t|off)" >&2; exit 3 ;;
esac
if [ "$PROFILE_RC10_D_PLACE" != "$PROFILE_RC10_D_PLACE_BEST" ]; then
  echo "[profiles/27b-release-draft] FORM-OVERRIDE HTSGLANG_RC10_D_PLACE=$PROFILE_RC10_D_PLACE (Kandidat $PROFILE_RC10_D_PLACE_BEST) -- per docker run -e gesetzt" >&2
fi

# --- F2 (27B b1 death 27.09. 06:57:17Z, dkr27breleasedraftbar1w109270652): D-Extend leert den Allokator-Cache auf TP0 --------
# D TP0 (5090) starb bei card_free 5 MiB: jeder Leg-2-Extend liess torch_reserved um bis zu +646 MiB wachsen (rc11a max +576),
# waehrend 1,46-1,6 GiB freier Cache fuer den Treiber unerreichbar waren (#1028c alloc_cache). PDFLIP-EXTEND-CACHE-TRIM (rc12e,
# pdflip/extend_trim.py) gibt vor dem Target-Extend die ganz freien Segmente zurueck, wenn card_free < Schwelle. Schwelle TP0 1200 =
# max. Extend-Zuwachs 646 + ~512 Treiber-Reserve; TP1/TP2 (3080) 0 = nie (dort min. frei 394/532, kein Tod). NUR fuer D (--env-d):
# auf P stuende sonst sync+empty_cache vor jedem P-Chunk. Der 27B-Launcher setzt die Variable nicht selbst (nur der NF-D-Rang-
# Solve-Pfad, launcher.py d_extend_trim_env). Beleg im Lauf: D 'PDFLIP-EXTEND-CACHE-TRIM rank=0 ... released= card_free_after='.
# Ein zweites --env-d (Arm/Profil darueber) ERSETZT diesen String (argparse: letzter gewinnt) -> dort diesen Eintrag mitnehmen.
PROFILE_ARGS+=(--env-d 'FLLIPER_PDFLIP_EXTEND_TRIM_MIB=1200,0,0')

eval "$(declare -f profile_form_env | sed '1s/^profile_form_env/_profile_form_env_reldraft_base/')"
profile_form_env() {
  _profile_form_env_reldraft_base
  # --- rc10-Teil (1:1 aus 27b-rc10.env; Belege dort ausfuehrlich) --------------------------------------------------------------
  # Zeile 24h (Agent HG): die drei D-Host-Luecken-Schalter NUR zusammen gemessen. Voraussetzung D_DEFER_SEQ_LENS_CPU + D_DEFER_REBUILD
  # (aus 27b.env). Arm dhg boot_weg2_dkr27bint8dhgbar1dhg109261456 gegen i8h boot_weg2_dkr27bbar1i8h109261444 (rc9dwin, bfc6bd87e2):
  _form FLLIPER_PDFLIP_D_EARLY_DRAFT 1                  # Beleg dhg09261456: Schrittzeit 10k -2,6..-4,6 %, 240k -3,4/-2,3 %; Nadel MATCH
  _form FLLIPER_DFLASH_ACCEPT_SYNC_FUSED 1            # Beleg dhg09261456 (mitgemessen); Desk: test_pdflip_d_hostgap_levers_0926.py 24 gruen
  _form FLLIPER_BARLINK_BAR1_CANON_ORDER 1            # Fehlerfix Rang-Bitgleichheit; Beleg dhg09261456 (mitgemessen) + Desk-Test (bf16-Emulation)
  _form FLLIPER_DFLASH_WINDOW_POOL_DEDUP_CARRY 1      # Fehlerfix (DK 7faa13dc1c); Desk: test_dflash_solo_pool.py 48; am Metall ungemessen (rc10-Plan)
  _form FLLIPER_PDFLIP_CENSUS_O1_EVICT 1                # Fehlerfix (KR e54ac95c65); Befund n4h dkr27bnvfp4bar1mwh09261131 (KV-Resume 6,3 s); Desk 5,69->0,19 s
  # --- Praefix-Schalter: KEINE _form-Zeilen mehr -- die Registry liefert sie (RG 26.09.) ---------------------------------------
  # Beleg-Boot dkr27brc10bar1agent09261821 (Image rc11a, Baum b3180fb493, 26.09. 18:21-18:56Z): 108 Requests, Flips 0,23 je Request
  # (vorher 1,35), verschwendeter Prefill ~7 % (vorher 48 %), 0 Gruppentod; ENV-IM-RANG alle fuenf = 1 auf P, D und Front;
  # Belegzeilen #1416d TOLD-PROBE=8, PACED 8/8, TWIN 7/7, span_inflight 109.
  # Registry-Felder (pdflip/form.py PREFIX_SWITCHES, Profil qwen27b = an; nextflash = aus, bis NF freigibt):
  #   inline_system_in_place  FLLIPER_ANTHROPIC_INLINE_SYSTEM_IN_PLACE  (MZ; P und D gleich -- der Launcher verweigert einen Split)
  #   told_probe_tree_key     FLLIPER_PDFLIP_TOLD_PROBE_TREE_KEY          (TK; FLLIPER_PDFLIP_TOLD_ABSOLUTE folgt ihm als Rang-Default)
  #   told_paced              FLLIPER_PDFLIP_TOLD_PACED                   (PX2)
  #   p_twin_defer            FLLIPER_PDFLIP_P_TWIN_DEFER                 (TW)
  #   front_span_inflight     FLLIPER_PDFLIP_FRONT_SPAN_INFLIGHT          (#49, wirkt nur mit agent_span)
  #   told_group_fallback     FLLIPER_PDFLIP_TOLD_GROUP_FALLBACK          (PF; Feld im Baum, qwen27b AUS -- am Metall ungeprueft)
  # Der Launcher nennt Wert und Quelle je Schalter in der Zeile PDFLIP-PREFIX-SWITCHES (profile qwen27b | env ...).
  # Eine hier (oder per docker run -e) gesetzte _form-Zeile GEWINNT weiter ueber die Registry -- nur fuer Abweichungen verwenden.
  # VORAUSSETZUNG: ein Baum MIT den Registry-Feldern (RG-Commit auf desk/27b-registry-prefix-0926 bzw. nach dem Pick im vereinigten
  # Kopf). Ein aelterer Baum (z.B. rc11a b3180fb493) faehrt diese Datei OHNE die fuenf Schalter -- dort die .bak_0926_rg-Fassung.
  # PF erst nach Metall-Beleg:
  # _form FLLIPER_PDFLIP_TOLD_GROUP_FALLBACK 1          # ungemessen; Registry-Feld told_group_fallback (qwen27b aus)
}
# NICHT drin: alles, was 27b-rc10.env ausschliesst (Gruende dort und im Proposal), und die Instrumente des Agentenlast-Arms
# (FLLIPER_HICACHE_ARENA_REF_CENSUS_S=10 als FORM-OVERRIDE, FLLIPER_DEBUG_HOLD=1).
