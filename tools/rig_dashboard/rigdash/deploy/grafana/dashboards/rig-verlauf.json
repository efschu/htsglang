      "type": "prometheus",
      "uid": "vm"
     },
     "refId": "A",
     "expr": "max by (model) (pdflip_front_ttft_ms_max{model=~\"$model\"}) / 1000",
     "legendFormat": "max {{model}}"
    }
   ]
  },
  {
   "id": 4,
