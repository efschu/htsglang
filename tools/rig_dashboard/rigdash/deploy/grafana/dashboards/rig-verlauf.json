     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "refId": "A",
     "expr": "max by (model, dir) (pdflip_flip_user_view_ms{def=\"t2t\",part=\"total\",model=~\"$model\"}) / 1000",
     "legendFormat": "Flipzeit {{dir}} {{model}}"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "refId": "B",
