{
 "uid": "rig-verlauf",
 "title": "Rig – Verlauf",
 "tags": [
  "rig",
  "pdflip"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "graphTooltip": 1,
 "editable": true,
 "templating": {
  "list": [
   {
    "name": "model",
    "label": "Modell",
    "type": "custom",
    "query": "NF,27B",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "includeAll": true,
    "allValue": ".*",
    "multi": false,
    "options": []
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Nutzer-Latenz",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "TTFT der Nutzer (Punkt je 5-s-Takt)",
   "description": "Ankunft an der Front -> erster Inhalt von D (front.py LEG2-FIRST-CONTENT), IPC-Zähler state.json front.arrival_seat.ttft_* (NF). Mittel der Anfragen, deren erstes Token im Intervall kam. 27B: fehlt bis zum Image mit pdflip_ttft_seconds (TSDB-Delta 01.10.). Über P / direkt D getrennt: fehlt in IPC (front.arrival_seat.ttft_by_via).",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "points",
      "lineWidth": 0,
      "fillOpacity": 12,
      "pointSize": 6,
      "showPoints": "always",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "refId": "A",
     "expr": "sum by (model) (increase(pdflip_front_ttft_ms_sum{model=~\"$model\"}[5s])) / (sum by (model) (increase(pdflip_front_ttft_count{model=~\"$model\"}[5s])) > 0) / 1000",
     "legendFormat": "{{model}}"
    }
   ],
   "interval": "5s"
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "TTFT max seit Boot / Anfragen je min",
   "description": "state.json front.arrival_seat.ttft_ms_max",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "line",
