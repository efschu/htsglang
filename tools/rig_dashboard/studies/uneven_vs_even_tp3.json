{
  "_": [
    "The first real A/B: capacity-proportional TP shards against the stock",
    "even split, on the same three mismatched cards.",
    "",
    "Run noise_floor_tp3.json first. This study runs its own A-vs-A boots at",
    "the head of the schedule anyway -- the executor will not compare before",
    "it has a floor -- but a floor already in hand can be passed in and the",
    "boots skipped.",
    "",
    "The yardstick is ms_per_verify_round. tok_s is reported beside it and is",
    "not the comparison: it follows the output content (r = 0.90) and under",
    "speculation fuses accept length with round time.",
    "",
    "Both arms carry the same load and the same prompt set on purpose. If the",
    "verdict comes back not_comparable, read the reason: it names the term",
    "that drifted, and that term is the experiment, not a nuisance."
  ],
  "scenario": "noise_floor",
  "point": {},
  "policy": {
    "noise_floor_boots": 3,
    "comparison_repeats": 2,
    "num_prompts": 32,
    "settle_s": 8,
    "reset_kv_budget": true,
    "own_vram_timeout_s": 180,
    "budget": {"target_low_s": 10.0, "target_high_s": 20.0, "ceiling_s": 60.0},
    "env": {
      "SGLANG_ENABLE_METRICS_DEVICE_TIMER": "1",
      "SGLANG_MAMBA_SSM_DTYPE": "bfloat16",
      "SGLANG_UNEVEN_DCP": "1",
      "SGLANG_UNEVEN_DCP_WEIGHTED": "1",
      "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"
    }
  },
  "arms": [
    {
      "label": "even-tp3",
      "note": "baseline: stock even TP split across three mismatched cards",
      "settings": {
        "model_path": "/spinning/llm_stuff/club-3090/models-cache/Qwen3.6-27B-FP8",
        "served_model_name": "Qwen3.6-27B",
        "tp_size": 3,
        "rank_gpu_id": [0, 1, 2],
        "kv_cache_dtype": "fp8_e5m2",
        "context_length": 262144,
        "max_running_requests": 2,
        "spec_mode": "off",
        "trust_remote_code": true,
        "host": "127.0.0.1",
        "port": 30000,
        "python_exe": "/spinning/htsglang-gpu/.venv/bin/python",
        "extra_flags": [
          "--enable-metrics-for-all-schedulers",
          "--speculative-algorithm", "DFLASH",
          "--speculative-draft-model", "/spinning/llm_stuff/club-3090/models-cache/qwen3.6-27b-dflash",
          "--speculative-dflash-block-size", "16",
          "--speculative-draft-placement", "solo"
        ]
      },
      "conditions": {
        "model": "Qwen3.6-27B-FP8",
        "quant": "fp8",
        "prompt_set": "random/seed1"
      }
    },
    {
      "label": "uneven-tp3",
      "note": "candidate: shards proportional to measured per-card capacity",
      "settings": {
        "model_path": "/spinning/llm_stuff/club-3090/models-cache/Qwen3.6-27B-FP8",
        "served_model_name": "Qwen3.6-27B",
        "tp_size": 3,
        "rank_gpu_id": [0, 1, 2],
        "rank_tp_ratio": "auto-performance",
        "kv_cache_dtype": "fp8_e5m2",
        "context_length": 262144,
        "max_running_requests": 2,
        "spec_mode": "off",
        "trust_remote_code": true,
        "host": "127.0.0.1",
        "port": 30000,
        "python_exe": "/spinning/htsglang-gpu/.venv/bin/python",
        "extra_flags": [
          "--enable-metrics-for-all-schedulers",
          "--rank-auto-reserve-mib", "3000,2200,2200",
          "--speculative-algorithm", "DFLASH",
          "--speculative-draft-model", "/spinning/llm_stuff/club-3090/models-cache/qwen3.6-27b-dflash",
          "--speculative-dflash-block-size", "16",
          "--speculative-draft-placement", "solo"
        ]
      },
      "conditions": {
        "model": "Qwen3.6-27B-FP8",
        "quant": "fp8",
        "prompt_set": "random/seed1"
      }
    }
  ]
}
