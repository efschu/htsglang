# shellcheck shell=bash
# RC9-FORM (RC9 e914e89fde = RC8 d342caa832 + N4D 78c2f16a90 + F 871d55fd45; Soll /spinning/gpu-arb/weg2/arm_rc8_n4_soll.txt):
#   NVFP4 native-mixed (Nutzer-Order 25.09. 17:33Z) -- 5090 IMMER W4A4 nativ (FlashInfer CUTLASS mm_fp4, auch im Decode),
#   3080 IMMER W4A8 auf den INT8-Kernen (N4D-Decode-Kern M<=48, N4A-Kern darueber; tvm-ffi nvfp4_w4a8_decode_sm86 /
#   nvfp4_w4a8_sm86, im Image vorgebaut), Hauptmodell UND NVFP4-Draft; KEINE Umformung am Flip mehr. Gegenueber der RC5-Form:
#     --fp4-native-mixed zusaetzlich zu --fp8-uniform-marlin (der Launcher gibt beiden Gruppen --fp4-gemm-backend
#       native-mixed und FLLIPER_FP4_NATIVE_MIXED_BOOT=1)
#     P-Schnitt --pp-stage-ratio 49,8,7 / --pp-attn-stage-ratio 12,2,2 (RC9, N4D projection.py; RC8 war 50,7,7)
#     KEIN FLLIPER_FP4_SM12X_W4A16_MAX_M (die 5090 rechnet immer W4A4) und KEIN FLLIPER_FP4_NATIVE_MIXED_BAND_MIB/_CHUNK_MIB
#       (die In-place-Umformung Marlin<->nativ entfaellt mit W4A8 auf der 3080).
#     Braucht das FlashInfer-QUELLBAU-Wheel 2f3bc5ac (sha256 708abc83..., #5242); der Dockerfile-Schritt 2b prueft es.
#   Der NVFP4-Draft bleibt Standard.
# Profil 27b-nvfp4 -- RadixArk Qwen3.8-27B-NVFP4 (modelopt MIXED_PRECISION, HF 319f741cce) + DFlash2-NVFP4-Draft
# (Standard seit 25.09., Nutzerentscheid; der W8-Draft bleibt per HTSGLANG_DRAFT waehlbar), pdflip-Flip.
#
# STAND: ABGENOMMEN (Operator 25.09.): RC4-Boot weg2rc4n4 (arm_rc4.sh FORMAT=nvfp4) bestanden, Urteil L: JA. Die Abnahme
# gilt fuer RC5 (desk/27b-release-rc5-0925 @ 5f13f1aad9): die LoadConfig von INT8, FP8 und NVFP4 ist per sha256 identisch
# zu RC4, arm_rc5.sh traegt dieselbe Form (Argv und Env byte-gleich zu arm_rc4.sh), gegatet gegen den RC5-Launcher.
#
# QUELLE (25.09.): Ss /spinning/gpu-arb/weg2/arm_rc4.sh, FORMAT=nvfp4 (Baum desk/27b-release-rc4-0925 @ 9738626129;
# Form = arm_rc3.sh nvfp4 = arm_xsnNV4a.sh, am Metall weg2xsnNV4a). Gleiche 34 Env-Variablen wie INT8/FP8; Argumente =
# INT8-Form von 27b.env plus:
#   --model <RadixArk-Checkpoint> --fp8-uniform-marlin   (FMT_ARGS; modelopt: der Launcher setzt FLLIPER_FORCE_FP8_MARLIN
#                                                          und --fp4-gemm-backend marlin selbst)
#   --pdflip-xchg-census-foreign                          (INT8-Census, kein eigener NVFP4-Census)
#   --pp-stage-ratio 42,11,11 --pp-attn-stage-ratio 10,3,3   (P-Schnitt GEPINNT fuer den Formatvergleich, P_CUT_PIN/P_ATTN_PIN)
# Graph 512, Graph-Split 7, P-Trim und Idle-Politik wie INT8. Nur fuer die Sonden des Arms: RETRACT_TOKENIZER,
# PROBE_TEMPO=2, PARK_N=4.
#
# Modellformat: nvfp4-modelopt (Erkennung: quant_method modelopt + hf_quant_config.json). NICHT das unsloth-CT-NVFP4 unter
# models-cache/Qwen3.8-27B-NVFP4 (compressed-tensors -> nvfp4-ct, anderer Lader).
# Kernel/JIT: Marlin auf allen Raengen (FP4-Experten/-Linears und FP8-Anteile per Marlin, tvm-ffi jit_kernel); die
# tvm-ffi-Saat enthaelt die am Rig gebauten Kerne (Stand des Kontexts).
#
# DRAFT (25.09., Nutzer ~10:40Z: "das nvfp4 modell mit dem nvfp4 dflash2 zu testen ... unser standardmodell soll weiter
# das int8 bleiben"; Order 08:47Z "nvfp4 draft in docker doch schon rein"): NUR dieses Profil nimmt den NVFP4-DFlash2-Draft
#   HF maurienne-ai/Qwen3.8-27B-DFlash2-NVFP4-RTNcal @ bd7a934213c4 (Apache-2.0 laut README.md des Ordners; Basis
#   incoai/Qwen3.8-27B-DFlash2), model.safetensors 1,55 GB. Das Image liefert keine Gewichte, nur den Pfad.
# 27b, 27b-fp8 und 27b-gguf behalten den W8-Draft (Launcher-Default): das FP4-Backend waehlte dort auf der 5090
# CUTLASS, und die Layouts passen im Tausch nicht zusammen.
# Am Metall nativ (RC7b bb086e1120, Boot weg2rc7n4, Arm arm_rc7b.sh FORMAT=nvfp4 DRAFT_OVERRIDE=<dieser Pfad>): der
# Launcher erkennt den Draft selbst als modelopt_fp4 (S1 quant=modelopt_fp4 auf TP0-2 und PP2, 0 compressed-tensors),
# kein Zusatzflag. Einziger argv-Unterschied der Gruppen zu weg2rc4n4 (W8-Draft): --speculative-draft-model-path
# (argv_gate.py, P 56 / D 58 Flags). Zahlen: KNOWN_ISSUES_RC2.md, Abschnitt RC7b NVFP4-Draft.
# W8-Draft waehlen: docker run -e HTSGLANG_DRAFT=/spinning/llm_stuff/club-3090/models-cache/Qwen3.8-27B-DFlash2-W8-lued
# (Muster wie HTSGLANG_P_TRIM in 27b.env: HTSGLANG_<NAME> ueberschreibt den Profil-Default).

# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/27b-base.env"   # E4: die alte 27b-Form (profiles_release/27b-base.env)

PROFILE_NAME=27b-nvfp4
PROFILE_FORMAT=nvfp4-modelopt
PROFILE_MODEL=/spinning/llm_stuff/club-3090/models-cache/Qwen3.8-27B-NVFP4-RadixArk
PROFILE_FORM=rc8-nvfp4-native-mixed   # arm_rc8_n4b.sh FORMAT=nvfp4 + DRAFT_OVERRIDE (N4C); vorher rc7b-nvfp4draft
PROFILE_STATUS=experimentell   # nativ: RC4-Boot weg2rc4n4, Urteil L JA (Operator 25.09.); Container cu129 NICHT abgenommen. Status-Wechsel entscheidet der Operator.
# Container cu130 (Stand 26.09., /spinning/docker-acceptance/27b/abnahme_cu130.log), alle bar1, Nadel MATCH:
#   rc9f (delta-rc9f-27b3babf514fc): dkr27bnvfp4bar109252110 (Flips 7,91/3,24 s, Code/Prosa/Thinking 193/90/171 tok/s) und
#          dkr27bnvfp4bar1warm09252140 (warm, Flips 7,4/3,26 s).
#   rc9j (delta-rc9j-27b5425830c95): dkr27bnvfp4bar1agent09252328 (35 min Agentenlast, Flips 7,11/3,04 s); chunkab
#          dkr27bnvfp4bar1chunka09260045 (fixed) und dkr27bnvfp4chunkBbar109260057 (dynamic), Nadel 3/3 je Stufe, oom_kill 0.
PROFILE_PLACEHOLDER=0
PROFILE_OWNER="27B-Sitz (NVFP4 Agent K, Arm S/L; abgenommen mit weg2rc4n4 (W8-Draft), NVFP4-Draft nativ weg2rc7n4; Container-Nachweis in der RC7b-Nachabnahme)"
# Draft: NVFP4 als Standard, W8 per HTSGLANG_DRAFT. 27b.env setzt PROFILE_DRAFT auf den W8-Pfad -- hier ueberschrieben.
PROFILE_DRAFT=${HTSGLANG_DRAFT:-/spinning/llm_stuff/club-3090/models-cache/Qwen3.8-27B-DFlash2-NVFP4-RTNcal}
# P-Chunk-Stufenmodell (siehe unten): liegt NEBEN dieser Datei -- im Image /opt/htsglang/profiles/27b-nvfp4.pchunk.json
# (tools/profiles/ des Kontexts, make_delta_ctx.sh / prepare_context.sh), am Rig docker/profiles/. Absolut, weil der Launcher
# nach cd "$TREE" startet.
PROFILE_P_CHUNK_MODEL_NVFP4="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/27b-nvfp4.pchunk.json"
PROFILE_REQUIRED_PATHS=("$PROFILE_DRAFT/config.json")   # Entrypoint: Draft-Ordner allein reicht nicht, der Inhalt muss da sein
if [ "$PROFILE_P_CHUNK" = dynamic ]; then PROFILE_REQUIRED_PATHS+=("$PROFILE_P_CHUNK_MODEL_NVFP4"); fi   # fehlt es im Image: refuse MODEL statt Launcher-Abbruch

_fmt_args=(--model "$PROFILE_MODEL" --fp8-uniform-marlin --fp4-native-mixed)
for ((_i = 0; _i < ${#PROFILE_ARGS[@]}; _i++)); do
  _fmt_args+=("${PROFILE_ARGS[_i]}")
  if [ "${PROFILE_ARGS[_i]}" = "--pdflip-xchg-census" ]; then
    _fmt_args+=("${PROFILE_ARGS[_i + 1]}" --pdflip-xchg-census-foreign); _i=$((_i + 1))
  fi
done
PROFILE_ARGS=("${_fmt_args[@]}" --pp-stage-ratio 49,8,7 --pp-attn-stage-ratio 12,2,2)   # RC9 N4D projection.py, 3080 W4A8 62,7 TOPS (Hochrechnung; RC8 50,7,7)
# Anders als 27b.env (dort Launcher-Default = W8-Draft, kein Flag) MUSS der Draft hier ausdruecklich stehen:
PROFILE_ARGS+=(--dflash-draft-path "$PROFILE_DRAFT")
unset _fmt_args _i

# P-CHUNK-POLITIK dynamic (Operator-Entscheid 26.09. 01:10Z; Knopf HTSGLANG_P_CHUNK_POLICY=fixed wie in 27b.env). Der INT8-Satz
# aus 27b.env (builtin-int8) bepreist NVFP4 falsch -> ersetzt durch das NVFP4-Stufenmodell als Datei:
#   --p-chunk-policy dynamic --p-chunk-max 2048 --p-chunk-model 27b-nvfp4.pchunk.json --p-chunk-mscale nvfp4
# Das JSON ist launcher.p_chunk_stage_model('fit:<P.log>', 'nvfp4', 3) des NVFP4-A-Boots dkr27bnvfp4bar1chunka09260045
# (P-Log boot_weg2_dkr27bnvfp4bar1chunka09260045_5425830c95_0926_004542.P.log, #PGAP-Fit Praefixe [0,32k), mscale nvfp4
# EINGERECHNET -- auf ein JSON-Modell wirkt --p-chunk-mscale nicht mehr, das Flag steht nur als Beleg der Form). Plan aus dem
# JSON == Plan aus fit:<log> (StageModels gleich; Plan-Zeilen 2k/8k/32k/128k byte-gleich, Agent DK 26.09.).
# MESSBELEG (Abnahme rc9j chunkab, bar1, P-Leg = reine P-Rechenzeit, Median n=3, Nadel 3/3 je Stufe):
#   A fixed    dkr27bnvfp4bar1chunka09260045   : 2k 0,40 s | 8k 1,29 s | 32k 5,83 s | 128k 44,49 s
#   B dynamic  dkr27bnvfp4chunkBbar109260057   : 2k 0,41 s | 8k 1,29 s | 32k 5,65 s | 128k 35,23 s  (2k/8k gleicher Plan)
_profile_drop_p_chunk
if [ "$PROFILE_P_CHUNK" = dynamic ]; then   # if statt &&: unter fixed darf das Sourcing nicht mit Status 1 enden (set -e)
  PROFILE_ARGS+=(--p-chunk-policy dynamic --p-chunk-max 2048 --p-chunk-model "$PROFILE_P_CHUNK_MODEL_NVFP4" --p-chunk-mscale nvfp4)
fi

# RC8 native-mixed: Band/Schritt der In-place-Umformung (Env geht per os.environ an beide Gruppen und die Front).
# profile_form_env aus 27b.env erweitern, nicht ersetzen.
eval "$(declare -f profile_form_env | sed '1s/profile_form_env/_profile_form_env_27b/')"
profile_form_env() {
  _profile_form_env_27b
  # RC9: BAND/CHUNK_MIB (Marlin in place) unter W4A8 wirkungslos -> entfernt; SM8X-Default ist w4a8
# Nutzer-Order 25.09. ~17:33Z: NVFP4 auf der 5090 IMMER W4A4 nativ (auch Decode) -> kein FLLIPER_FP4_SM12X_W4A16_MAX_M
}
